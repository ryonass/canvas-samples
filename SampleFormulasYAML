                       colIGCESubLine As s,
                       LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
                   )
        },
        Switch(
            periodIndex,
            0, Sum(_subs As s, s.BaseYearFCCOM),
            1, Sum(_subs As s, s.OP1FCCOM),
            2, Sum(_subs As s, s.OP2FCCOM),
            3, Sum(_subs As s, s.OP3FCCOM),
            4, Sum(_subs As s, s.OP4FCCOM),
