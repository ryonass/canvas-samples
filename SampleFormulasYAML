nfIgceGfpAnswerOf(headerID: Number, qIndex: Number): Text =
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        Switch(
            qIndex,
            1, _h.gfpJustifiQues1,
            2, _h.gfpJustifiQues2,
            3, _h.gfpJustifiQues3,
            4, _h.gfpJustifiQues4,
            5, _h.gfpJustifiQues5,
            6, _h.gfpJustifiQues6,
            ""
        )
    );

nfIgceSetBoeAnswer(headerID: Number, boeKey: Text, answer: Text): Void = {
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        Patch(
            colIGCEHeader,
            _h,
            {
              Assumptions: If(boeKey = "assume", answer, _h.Assumptions),
              InformationToolsUsed: If(boeKey = "tools", answer, _h.InformationToolsUsed),
              InformationObtainedFrom: If(boeKey = "source", answer, _h.InformationObtainedFrom),
              PreviousContracts: If(boeKey = "prior", answer, _h.PreviousContracts),
              LaborBasis: If(boeKey = "labor", answer, _h.LaborBasis),
              LaborCategoriesBasis: If(boeKey = "lcats", answer, _h.LaborCategoriesBasis),
              LaborRatesBasis: If(boeKey = "lrates", answer, _h.LaborRatesBasis),
