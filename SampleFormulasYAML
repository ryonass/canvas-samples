};


// =============================================================================
//  START REVISION
//  Copies a header with its lines and sublines as the next revision, in Draft.
//  Refused while the PR has an open Draft. SharePoint issues every new ID.
// =============================================================================

nfIGCERevisionCopy(headerID: Number, newRevision: Number): Void = {
    ClearCollect(colTmpRevLines, Sort(Filter(colIGCELine, IGCEHeaderID = headerID), ID));
    ClearCollect(
        colTmpRevSubs,
        Filter(
            colIGCESubLine As s,
            LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
        )
    );
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        With(
            {
                _newHdrID: Patch(
                    IGCEHeader,
                    Defaults(IGCEHeader),
                    { Title: _h.Title, Status: { Value: "Draft" } }
                ).ID
            },
            Collect(
                colIGCEHeader,
                Patch(
                    _h,
                    {
                        ID: _newHdrID,
                        Revision: newRevision,
                        Status: { Value: "Draft" },
                        SubmittedBy: "",
                        SubmittedOn: Blank(),
                        Modified: Now()
                    }
                )
            );
            ForAll(
                colTmpRevLines As l,
                With(
                    {
                        _nl: Patch(
                            IGCELine,
                            Defaults(IGCELine),
                            { Title: l.Title, IGCEHeaderID: _newHdrID }
                        ).ID
                    },
                    Collect(colIGCELine, Patch(l, { ID: _nl, IGCEHeaderID: _newHdrID }));
                    ForAll(
                        Filter(colTmpRevSubs, IGCELineID = l.ID) As s,
                        Collect(
                            colIGCESubLine,
                            Patch(
                                s,
                                {
                                    ID: Patch(
                                        IGCESubLine,
                                        Defaults(IGCESubLine),
                                        { Title: s.Title, IGCELineID: _nl }
                                    ).ID,
                                    IGCELineID: _nl
                                }
                            )
                        )
                    )
                )
            );
            nfIGCERecalcHeader(_newHdrID);
            nfIgceSpSync(_newHdrID);
            nfIgceSpSyncAnswers(_newHdrID)
        )
    );
    Clear(colTmpRevLines);
    Clear(colTmpRevSubs);
};

nfIGCEStartRevision(headerID: Number): Void = {
    Clear(colIGCEBlockers);
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        With(
            {
                _hasDraft: CountRows(
                               Filter(colIGCEHeader, PRID = _h.PRID, Status.Value = "Draft")
                           ) > 0,
                _nextRev:  Coalesce(Max(Filter(colIGCEHeader, PRID = _h.PRID) As r, r.Revision), 0) + 1
            },
            If(
                _hasDraft,
                Collect(
                    colIGCEBlockers,
                    {
                        Scope: "header", RefID: headerID, Field: "Revision",
                        Message: "This PR already has a Draft revision. Finish or delete it before starting another.",
                        Fail: true
                    }
                ),
                nfIGCERevisionCopy(headerID, _nextRev)
            )
        )
    );
};


