              SubmittedOn: _h.SubmittedOn
            }
        );
        ForAll(
            Filter(colIGCELine, IGCEHeaderID = headerID) As l,
            Patch(
                IGCELine,
                LookUp(IGCELine, ID = l.ID),
                {
                  Title: l.Title,
                  IGCEHeader: { Id: headerID, Value: _h.Title },
                  IGCEHeaderID: l.IGCEHeaderID,
                  LineNumber: l.LineNumber,
                  Labor: l.Labor,
                  Category: If(IsBlank(l.Category.Value), Blank(), { Value: l.Category.Value }),
                  BaseYearCost: l.BaseYearCost,
                  OP1Cost: l.OP1Cost,
                  OP2Cost: l.OP2Cost,
                  OP3Cost: l.OP3Cost,
                  OP4Cost: l.OP4Cost,
                  BaseYearQuantity: Sum(Filter(colIGCESubLine, IGCELineID = l.ID), BaseYearQuantity),
                  OP1Quantity: Sum(Filter(colIGCESubLine, IGCELineID = l.ID), OP1Quantity),
                  OP2Quantity: Sum(Filter(colIGCESubLine, IGCELineID = l.ID), OP2Quantity),
                  OP3Quantity: Sum(Filter(colIGCESubLine, IGCELineID = l.ID), OP3Quantity),
                  OP4Quantity: Sum(Filter(colIGCESubLine, IGCELineID = l.ID), OP4Quantity),
                  TotalCost: l.BaseYearCost + l.OP1Cost + l.OP2Cost + l.OP3Cost + l.OP4Cost,
