      - cmpDtlConfirm:
          Control: CanvasComponent
          ComponentName: cmpConfirmDialog
          Properties:
            CancelLabel: ="Go back"
            ConfirmLabel: =locConfirm.Label
            Height: =Parent.Height
            IsDanger: =locConfirm.Danger
            IsPhone: =nfIsPhone
            Message: =locConfirm.Message
            OnCancel: |-
              =UpdateContext({ locConfirm: Blank() })
            OnConfirm: |-
              =Switch(
                  locConfirm.Action,
                  "assign", nfAssignToMe(locId),
                  "start", nfSetStatus(locId, "InProgress", "Status changed to " & nfStatusLabel("InProgress")),
                  "hold", nfSetStatus(locId, "OnHold", "Status changed to " & nfStatusLabel("OnHold")),
                  "resume", nfSetStatus(locId, "InProgress", "Status changed to " & nfStatusLabel("InProgress")),
                  "complete", nfSetStatus(locId, "Completed", "Status changed to " & nfStatusLabel("Completed")),
                  "cancel", nfSetStatus(locId, "Cancelled", nfStatusLabel("Cancelled"))
              );
              UpdateContext({ locConfirm: Blank(), locItem: LookUp(colRequests, ID = locId) });
              Notify(nfItemCap & " updated.", NotificationType.Success)
            Theme: =nfColor
            Title: =locConfirm.Title
            Visible: =!IsBlank(locConfirm)
            Width: =Parent.Width
