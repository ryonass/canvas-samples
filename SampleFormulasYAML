                  OP2Fringe: s.OP2Fringe,
                  OP2Overhead: s.OP2Overhead,
                  OP2GAndA: s.OP2GAndA,
                  OP2FCCOM: s.OP2FCCOM,
                  OP2Cost: s.OP2Cost,
                  OP2Burden: s.OP2Burden,
                  OP2TotalCost: s.OP2TotalCost,
                  OP3Quantity: s.OP3Quantity,
                  OP3Rate: s.OP3Rate,
                  OP3Fringe: s.OP3Fringe,
                  OP3Overhead: s.OP3Overhead,
                  OP3GAndA: s.OP3GAndA,
                  OP3FCCOM: s.OP3FCCOM,
                  OP3Cost: s.OP3Cost,
                  OP3Burden: s.OP3Burden,
                  OP3TotalCost: s.OP3TotalCost,
                  OP4Quantity: s.OP4Quantity,
                  OP4Rate: s.OP4Rate,
                  OP4Fringe: s.OP4Fringe,
