// Per period totals, so the ledger and the review table read one formula each.
nfIgcePeriodCost(headerID: Number, periodIndex: Number): Number =
    With(
        {
            _subs: Filter(
                       colIGCESubLine As s,
                       LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
                   )
        },
        Switch(
            periodIndex,
            0, Sum(_subs As s, s.BaseYearTotalCost),
            1, Sum(_subs As s, s.OP1TotalCost),
            2, Sum(_subs As s, s.OP2TotalCost),
            3, Sum(_subs As s, s.OP3TotalCost),
            4, Sum(_subs As s, s.OP4TotalCost),
            0
        )
    );

// Option period dates follow the base period, each one year long, which is the
// mockup's rule. The note beside it there says to adjust a period on save if the
// contract differs, so these are a default and not a constraint.
nfIgcePeriodStart(headerID: Number, periodIndex: Number): DateTime =
    DateAdd(LookUp(colIGCEHeader, ID = headerID).BasePeriodStart, periodIndex, TimeUnit.Years);

nfIgcePeriodEnd(headerID: Number, periodIndex: Number): DateTime =
    DateAdd(LookUp(colIGCEHeader, ID = headerID).BasePeriodEnd, periodIndex, TimeUnit.Years);

// Cost build up rows, by element, for one period. The review table and the
// ledger both read these so the two cannot disagree.
nfIgceLaborCost(headerID: Number, periodIndex: Number): Number =
    With(
        {
            _subs: Filter(
                       colIGCESubLine As s,
                       LookUp(colIGCELine, ID = s.IGCELineID).Labor
                           && LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
                   )
        },
        Switch(
            periodIndex,
            0, Sum(_subs As s, s.BaseYearCost),
            1, Sum(_subs As s, s.OP1Cost),
            2, Sum(_subs As s, s.OP2Cost),
            3, Sum(_subs As s, s.OP3Cost),
            4, Sum(_subs As s, s.OP4Cost),
            0
        )
    );

nfIgceDirectCost(headerID: Number, periodIndex: Number): Number =
    With(
        {
            _subs: Filter(
                       colIGCESubLine As s,
                       !LookUp(colIGCELine, ID = s.IGCELineID).Labor
                           && LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
                   )
        },
        Switch(
            periodIndex,
            0, Sum(_subs As s, s.BaseYearCost),
            1, Sum(_subs As s, s.OP1Cost),
            2, Sum(_subs As s, s.OP2Cost),
            3, Sum(_subs As s, s.OP3Cost),
            4, Sum(_subs As s, s.OP4Cost),
            0
        )
    );

nfIgceBurdenCost(headerID: Number, periodIndex: Number): Number =
    nfIgcePeriodCost(headerID, periodIndex)
    - nfIgceLaborCost(headerID, periodIndex)
    - nfIgceDirectCost(headerID, periodIndex);


// =============================================================================
//  COST BUILD UP BY ELEMENT
//  One function, read by the Review table, the Compare table and the ledger, so
//  the three cannot disagree about what an element means. Keyed by text rather
//  than split into seven functions because the callers iterate a row table.
//
//  Scalar in, scalar out, so no User Defined Type is involved.
// =============================================================================

nfIgceElementOf(headerID: Number, key: Text): Number =
    Switch(
        key,
        "labor",
            nfIgceLaborCost(headerID, 0) + nfIgceLaborCost(headerID, 1)
            + nfIgceLaborCost(headerID, 2) + nfIgceLaborCost(headerID, 3)
            + nfIgceLaborCost(headerID, 4),
        "direct",
            nfIgceDirectCost(headerID, 0) + nfIgceDirectCost(headerID, 1)
            + nfIgceDirectCost(headerID, 2) + nfIgceDirectCost(headerID, 3)
            + nfIgceDirectCost(headerID, 4),
        "burden",
            nfIgceBurdenCost(headerID, 0) + nfIgceBurdenCost(headerID, 1)
            + nfIgceBurdenCost(headerID, 2) + nfIgceBurdenCost(headerID, 3)
            + nfIgceBurdenCost(headerID, 4),
        "total",   nfIgceSubsOfTotal(headerID),
        "fccom",   nfIgceSubsOfFccom(headerID),
        "fee",     nfIgceFeeOf(headerID),
        "caf",     nfIgceCafOf(headerID),
        "ceiling", nfIgceCeilingOf(headerID),
        0
    );

// The same seven elements for ONE period. The review table is per period, so it
// needs this rather than the all periods total above.
// Per period FCCOM, needed because the fee base EXCLUDES facilities cost of
// money. Passing 0 here would overstate the fee in every period.
nfIgcePeriodFccom(headerID: Number, periodIndex: Number): Number =
    With(
        {
            _subs: Filter(
                       colIGCESubLine As s,
                       LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
                   )
        },
        Switch(
            periodIndex,
            0, Sum(_subs As s, s.BaseYearFCCOM),
            1, Sum(_subs As s, s.OP1FCCOM),
            2, Sum(_subs As s, s.OP2FCCOM),
            3, Sum(_subs As s, s.OP3FCCOM),
            4, Sum(_subs As s, s.OP4FCCOM),
            0
        )
    );

nfIgcePeriodFee(headerID: Number, periodIndex: Number): Number =
    nfIGCEFixedFee(
        nfIgcePeriodCost(headerID, periodIndex),
        nfIgcePeriodFccom(headerID, periodIndex),
        LookUp(colIGCEHeader, ID = headerID).ProfitFeeRate
    );

nfIgcePeriodCaf(headerID: Number, periodIndex: Number): Number =
    nfIGCEAccessFee(
        nfIgcePeriodCost(headerID, periodIndex),
        nfIgcePeriodFee(headerID, periodIndex),
        LookUp(colIGCEHeader, ID = headerID).ContractAccessFeeRate
    );

nfIgceElementPeriodOf(headerID: Number, key: Text, periodIndex: Number): Number =
    Switch(
        key,
        "labor",   nfIgceLaborCost(headerID, periodIndex),
        "direct",  nfIgceDirectCost(headerID, periodIndex),
        "burden",  nfIgceBurdenCost(headerID, periodIndex),
        "total",   nfIgcePeriodCost(headerID, periodIndex),
        "fccom",   nfIgcePeriodFccom(headerID, periodIndex),
        "fee",     nfIgcePeriodFee(headerID, periodIndex),
        "caf",     nfIgcePeriodCaf(headerID, periodIndex),
        "ceiling",
            nfIGCECeiling(
                nfIgcePeriodCost(headerID, periodIndex),
                nfIgcePeriodFee(headerID, periodIndex),
                nfIgcePeriodCaf(headerID, periodIndex)
            ),
        0
    );


// =============================================================================
//  LINE LEVEL COMPARE
//  Revisions are matched by line Title, which is what the mockup does. A renamed
//  line therefore reads as one removed plus one added rather than as a change.
//  That is the mockup's behaviour and it is left alone: matching on ID would be
//  wrong, because a revision copy mints new line IDs.
// =============================================================================

nfIgceLineTotalOf(lineID: Number): Number =
    With(
        { _l: LookUp(colIGCELine, ID = lineID) },
        _l.BaseYearCost + _l.OP1Cost + _l.OP2Cost + _l.OP3Cost + _l.OP4Cost
    );

nfIgceLineTotalIn(headerID: Number, title: Text): Number =
    Sum(
        Filter(colIGCELine, IGCEHeaderID = headerID, Title = title) As l,
        l.BaseYearCost + l.OP1Cost + l.OP2Cost + l.OP3Cost + l.OP4Cost
    );

nfIgceLineCountIn(headerID: Number, title: Text): Number =
    CountRows(Filter(colIGCELine, IGCEHeaderID = headerID, Title = title));


// =============================================================================
//  EDITOR NAVIGATION
//  One routing function, called by every stepper and every pager, so a step order
//  change is one edit. The GFP step exists only when the estimate contains
//  government furnished property, which is why nothing hardcodes an index.
// =============================================================================

nfIgceStepNav(stepIndex: Number, containsGfp: Boolean): Void = {
    Switch(
        stepIndex,
        1, Navigate(scrIgceHeader, ScreenTransition.None),
        2, Navigate(scrIgceLines, ScreenTransition.None),
        3, If(
               containsGfp,
               Navigate(scrIgceGfp, ScreenTransition.None),
               Navigate(scrIgceBoe, ScreenTransition.None)
           ),
        4, If(
               containsGfp,
               Navigate(scrIgceBoe, ScreenTransition.None),
               Navigate(scrIgceReview, ScreenTransition.None)
           ),
        5, Navigate(scrIgceReview, ScreenTransition.None)
    );
};

nfIgceStepLabels(containsGfp: Boolean): Text =
    If(
        containsGfp,
        "IGCE header|Lines|GFP justification|Basis of estimate|Review",
        "IGCE header|Lines|Basis of estimate|Review"
    );


// =============================================================================
//  BASIS OF ESTIMATE
//  The 19 sections, their groups, labels, hints and required conditions are the
//  mockup's, transcribed. What is NOT known is the SharePoint internal column
//  name for each, which is README open question 1, so answers are staged in
//  colIGCEBoeAnswer and NOT written to IGCEHeader. scrIgceBoe says so on screen
//  rather than letting a user believe the text was saved to the estimate.
// =============================================================================

nfIgceHasLabor(headerID: Number): Boolean =
    CountRows(Filter(colIGCELine, IGCEHeaderID = headerID, Labor)) > 0;

nfIgceHasCat(headerID: Number, cat: Text): Boolean =
    CountRows(
        Filter(
            colIGCELine,
            IGCEHeaderID = headerID,
            !Labor,
            Category.Value = cat
        )
    ) > 0;

nfIgceHasBurdenedCat(headerID: Number): Boolean =
    nfIgceHasCat(headerID, "Direct Material")
    || nfIgceHasCat(headerID, "Other Direct Costs")
    || nfIgceHasCat(headerID, "Products/Supplies")
    || nfIgceHasCat(headerID, "Travel");

// Which sections this estimate actually has to answer. The mockup's boeNeeded.
nfIgceBoeNeeded(headerID: Number, boeKey: Text): Boolean =
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        Switch(
            boeKey,
            "assume",   true,
            "tools",    true,
            "source",   true,
            "prior",    true,
            "labor",    nfIgceHasLabor(headerID),
            "lcats",    nfIgceHasLabor(headerID),
            "lrates",   nfIgceHasLabor(headerID),
            "hours",    nfIgceHasLabor(headerID),
            "udl",      nfIgceHasLabor(headerID),
            "odc",      nfIgceHasCat(headerID, "Other Direct Costs"),
            "material", nfIgceHasCat(headerID, "Direct Material"),
            "products", nfIgceHasCat(headerID, "Products/Supplies"),
            "subk",     nfIgceHasCat(headerID, "Subcontract"),
            "travel",   nfIgceHasCat(headerID, "Travel"),
            "indirect", nfIgceHasLabor(headerID)
                            && (_h.FringeRate > 0 || _h.OverheadRate > 0),
            "burden",   _h.IndirectBurdenRate > 0 && nfIgceHasBurdenedCat(headerID),
            "ga",       _h.GARate > 0,
            "fccom",    _h.FCCOMRate > 0,
            "fixedfee", _h.ProfitFeeRate > 0,
            false
        )
    );

nfIgceBoeAnswerOf(headerID: Number, boeKey: Text): Text =
    LookUp(
        colIGCEBoeAnswer,
        IGCEHeaderID = headerID && BoeKey = boeKey
    ).Answer;

nfIgceBoeOpenCount(headerID: Number): Number =
    CountRows(
        Filter(
            colIGCEBoeDef As d,
            nfIgceBoeNeeded(headerID, d.BoeKey)
                && IsBlank(Trim(nfIgceBoeAnswerOf(headerID, d.BoeKey)))
        )
    );

nfIgceGfpAnswerOf(headerID: Number, qIndex: Number): Text =
    LookUp(
        colIGCEGfpAnswer,
        IGCEHeaderID = headerID && QIndex = qIndex
    ).Answer;

nfIgceGfpOpenCount(headerID: Number): Number =
    CountRows(
        Filter(
            Table({ Q: 1 }, { Q: 2 }, { Q: 3 }, { Q: 4 }, { Q: 5 }, { Q: 6 }) As q,
            IsBlank(Trim(nfIgceGfpAnswerOf(headerID, q.Q)))
        )
    );

// Upsert one answer. Staged only: see the note above.
nfIgceSetBoeAnswer(headerID: Number, boeKey: Text, answer: Text): Void = {
    If(
        CountRows(
            Filter(colIGCEBoeAnswer, IGCEHeaderID = headerID && BoeKey = boeKey)
        ) = 0,
        Collect(
            colIGCEBoeAnswer,
            { IGCEHeaderID: headerID, BoeKey: boeKey, Answer: answer }
        ),
        Patch(
            colIGCEBoeAnswer,
            LookUp(colIGCEBoeAnswer, IGCEHeaderID = headerID && BoeKey = boeKey),
            { Answer: answer }
        )
    );
};

nfIgceSetGfpAnswer(headerID: Number, qIndex: Number, answer: Text): Void = {
    If(
        CountRows(
            Filter(colIGCEGfpAnswer, IGCEHeaderID = headerID && QIndex = qIndex)
        ) = 0,
        Collect(
            colIGCEGfpAnswer,
            { IGCEHeaderID: headerID, QIndex: qIndex, Answer: answer }
        ),
        Patch(
            colIGCEGfpAnswer,
            LookUp(colIGCEGfpAnswer, IGCEHeaderID = headerID && QIndex = qIndex),
            { Answer: answer }
        )
    );
};


// =============================================================================
//  STAGE HELPERS
//  An inline edit in a gallery changes ONE field. These load the rest of the row
//  into the staging collection first, so a control does three short calls rather
//  than restating 24 fields, and the save routine still sees a complete row.
// =============================================================================

nfIgceStageLine(lineID: Number): Void = {
    With(
        { _l: LookUp(colIGCELine, ID = lineID) },
        Patch(
            colIGCELineEdit,
            First(colIGCELineEdit),
            {
                IGCEHeaderID: _l.IGCEHeaderID,
                Title: _l.Title,
                LineNumber: _l.LineNumber,
                Labor: _l.Labor,
                Category: _l.Category
            }
        )
    );
};

nfIgceStageSubLine(subLineID: Number): Void = {
    With(
        { _s: LookUp(colIGCESubLine, ID = subLineID) },
        Patch(
            colIGCESubLineEdit,
            First(colIGCESubLineEdit),
            {
                IGCELineID: _s.IGCELineID,
                Title: _s.Title,
                Ref: _s.Ref,
                SerialNumber: _s.SerialNumber,
                SublineType: _s.SublineType,
                IncludesProperty: _s.IncludesProperty,
                PropertyType: _s.PropertyType,
                LaborCategories: _s.LaborCategories,
                ODCCategory: _s.ODCCategory,
                Units: _s.Units,
                Software: _s.Software,
                CalculateOptionPeriods: _s.CalculateOptionPeriods,
                BaseYearQuantity: _s.BaseYearQuantity,
                OP1Quantity: _s.OP1Quantity,
                OP2Quantity: _s.OP2Quantity,
                OP3Quantity: _s.OP3Quantity,
                OP4Quantity: _s.OP4Quantity,
                BaseYearRate: _s.BaseYearRate,
                OP1Rate: _s.OP1Rate,
                OP2Rate: _s.OP2Rate,
                OP3Rate: _s.OP3Rate,
                OP4Rate: _s.OP4Rate
            }
        )
    );
};

// The next line number and subline ref, so adding one does not collide.
nfIgceNextLineNumber(headerID: Number): Number =
    Coalesce(Max(Filter(colIGCELine, IGCEHeaderID = headerID), LineNumber), 1000) + 1;

nfIgceNextRef(lineID: Number): Text =
    With(
        { _l: LookUp(colIGCELine, ID = lineID) },
        Text(_l.LineNumber - 1000)
            & "."
            & (CountRows(Filter(colIGCESubLine, IGCELineID = lineID)) + 1)
    );

// The per period rate a subline actually uses, so a screen shows the inflated
// rate without recomputing the rule.
nfIgceSubRate(subLineID: Number, periodIndex: Number): Number =
    With(
        { _s: LookUp(colIGCESubLine, ID = subLineID) },
        nfIGCERateFor(
            _s.BaseYearRate,
            Switch(
                periodIndex,
                0, _s.BaseYearRate,
                1, _s.OP1Rate,
                2, _s.OP2Rate,
                3, _s.OP3Rate,
                4, _s.OP4Rate,
                0
            ),
            _s.CalculateOptionPeriods,
            periodIndex,
            LookUp(
                colIGCEHeader,
                ID = LookUp(colIGCELine, ID = _s.IGCELineID).IGCEHeaderID
            ).InflationRate
        )
    );

nfIgceSubQty(subLineID: Number, periodIndex: Number): Number =
    With(
        { _s: LookUp(colIGCESubLine, ID = subLineID) },
        Switch(
            periodIndex,
            0, _s.BaseYearQuantity,
            1, _s.OP1Quantity,
            2, _s.OP2Quantity,
            3, _s.OP3Quantity,
            4, _s.OP4Quantity,
            0
        )
    );

nfIgceSubCost(subLineID: Number, periodIndex: Number): Number =
    With(
        { _s: LookUp(colIGCESubLine, ID = subLineID) },
        Switch(
            periodIndex,
            0, _s.BaseYearTotalCost,
            1, _s.OP1TotalCost,
            2, _s.OP2TotalCost,
            3, _s.OP3TotalCost,
            4, _s.OP4TotalCost,
            0
        )
    );
