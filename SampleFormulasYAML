            "lrates", _h.LaborRatesBasis,
            "hours", _h.HoursBasis,
            "udl", _h.UnburdenedDirectLaborBasis,
            "odc", _h.ODCBasis,
            "material", _h.DirectMaterialBasis,
            "products", _h.ProductsSuppliesBasis,
            "subk", _h.SubcontractsBasis,
            "travel", _h.TravelBasis,
            "indirect", _h.IndirectRatesBasis,
            "burden", _h.IndirectBurdenBasis,
            "ga", _h.GAndABasis,
            "fccom", _h.FCCOMBasis,
            "fixedfee", _h.FixedFeeBasis,
