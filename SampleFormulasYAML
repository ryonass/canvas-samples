r]ID = gl_IGCE.ID, Category.Value = \"Servicing Agency Fee/Access Charge\"))),\r\n                Remove([@IGCELine],LookUp([@IGCELine], And([@IGCEHeader]ID = gl_IGCE.ID, Category.Value = \"Servicing Agency Fee/Access Charge\")))\r\n            )\r\n        );\r\n        If(cmp_ProfitFeeRate.Value <> 0,\r\n            Patch(\r\n                [@IGCELine],\r\n                If(\r\n                    //Check if record exists\r\n                    !IsBlank(LookUp([@IGCELine], And([@IGCEHeader]ID = gl_IGCE.ID, Category.Value = \"Fixed Fee Profit\"))),\r\n                    LookUp([@IGCELine], And([@IGCEHeader]ID = gl_IGCE.ID, Category.Value = \"Fixed Fee Profit\")),\r\n                    Defaults([@IGCELine])\r\n                ),\r\n                {\r\n                    'Line Number': 1004,\r\n                    Category: {Value: \"Fixed Fee Profit\"},\r\n                    Description: \"Fixed Fee Profit\",\r\n                    [@IGCEHeader]: {\r\n                        '@odata.type': \"#Microsoft.Azure.Connectors.SharePoint.SPListExpandedReference\",\r\n                        Id: gl_IGCE.ID,\r\n                        Value: gl_IGCE.ID\r\n                    },\r\n                    [@IGCEHeader]ID: gl_IGCE.ID,\r\n                    'Base Year Cost': Sum(_baseLines, 'Base Year Cost' ) * cmp_ProfitFeeRate.Value,\r\n                    'Base Year Hours/Quantity': 1,\r\n                    'Option Period 1 Cost': Sum(_baseLines, 'Option Period 1 Cost' ) * cmp_ProfitFeeRate.Value,\r\n                    'Option Period 1 Hours/Quantity': 1,\r\n                    'Option Period 2 Cost': Sum(_baseLines, 'Option Period 2 Cost' ) * cmp_ProfitFeeRate.Value,\r\n                    'Option Period 2 Hours/Quantity': 1,\r\n                    'Option Period 3 Cost': Sum(_baseLines, 'Option Period 3 Cost' ) * cmp_ProfitFeeRate.Value,\r\n                    'Option Period 3 Hours/Quantity': 1,\r\n                    'Option Period 4 Cost': Sum(_baseLines, 'Option Period 4 Cost' ) * cmp_ProfitFeeRate.Value,\r\n                    'Option Period 4 Hours/Quantity': 1\r\n                }\r\n            ),\r\n            // Rate is 0, make sure line doesn't exist\r\n            If(\r\n                !IsBlank(LookUp([@IGCELine], And([@IGCEHeader]ID = gl_IGCE.ID, Category.Value = \"Fixed Fee Profit\"))),\r\n                Remove([@IGCELine],LookUp([@IGCELine], And([@IGCEHeader]ID = gl_IGCE.ID, Category.Value = \"Fixed Fee Profit\")))\r\n            )\r\n        );\r\n\r\n        \r\n\r\n        Set(gl_IGCE, Patch([@IGCEHeader], If(_newRecord, Defaults([@IGCEHeader]), gl_IGCE), {\r\n            Title: gl_PRTracker.Name,\r\n            'PR Tracker ID':{\r\n                '@odata.type': \"#Microsoft.Azure.Connectors.SharePoint.SPListExpandedReference\",\r\n                Id: gl_PRTracker.ID,\r\n                Value: gl_PRTracker.ID\r\n            },\r\n            IGCEType:cmp_IGCEType_Overview.Value,\r\n            Assumptions:cmp_Assumptions_Overview.Value,\r\n            'Information/Tools Used':cmp_InfoToolsUsed_Overview.Value,\r\n            'Previous Contracts':cmp_PreviousContracts_Overview.Value,\r\n            'Information Obtained From':cmp_InfoObtainedFrom_Overview.Value,\r\n            'Option Periods':Value(cmp_OPs.Value.Value),\r\n            'Point of Contact':cmb_POC_Overview.Selected,\r\n            COR:cmb_COR_Overview.Selected, /*Updated GFP*/\r\n            /*'Contains GFP':cmp_GFP_Overview.Value, /*Updated GFP*/\r\n            /*gfpJustifiQues1:cmp_gfpJustifiQues1_Overview.Value, /*Updated GFP*/\r\n            /*gfpJustifiQues2:cmp_gfpJustifiQues2_Overview.Value, /*Updated GFP*/\r\n            /*gfpJustifiQues3:cmp_gfpJustifiQues3_Overview.Value, /*Updated GFP*/\r\n            /*gfpJustifiQues4:cmp_gfpJustifiQues4_Overview.Value, /*Updated GFP*/\r\n            /*gfpJustifiQues5:cmp_gfpJustifiQues5_Overview.Value, /*Updated GFP*/\r\n            /*gfpJustifiQues6:cmp_gfpJustifiQues6_Overview.Value, /*Updated GFP*/\r\n            /*gfpCORSignatureDate:DateValue(txt_ApprovalDate.Text), /*Updated GFP*/\r\n            /*gfpStatus:txt_GFPStatus_Overview.Text, /*Updated GFP*/\r\n            /*gfpCORSignature:img_SignaturePreview.Image, /*Updated GFP*/\r\n            /*gfpWorkflowState:gl_GFPWorkflowState, /*Updated GFP*/\r\n            /*'COR Remarks':cmp_gfpCORRemarks_Overview.Value, /*Updated GFP*/\r\n            /*'Basis for Hours':cmp_HoursBasis_Overview.Value,\r\n            'Basis for Indirect Burden':txt_IndirectBurdenBasis.Value,\r\n            'Basis for Labor Categories':cmp_LaborCatBasis_Overview.Value,\r\n            'Basis for Labor Rates': cmp_LaborRatesBasis_Overview.Value,\r\n            'Basis for Labor':cmp_LaborBasis_Overview.Value,\r\n            'Basis for Unburdened Direct Labor':cmp_UnburdenedDirectLaborBasis_Overview.Value,\r\n            'Inflation Rate':cmp_InflationRate_Overview.Value,\r\n            'Base Period Start': cmp_BaseStart_Overview.Value,\r\n            'Base Period End': cmp_BaseEnd_Overview.Value,\r\n            'OP 1 Start':cmp_OP1Start_Overview.Value,\r\n            'OP 1 End': cmp_OP1End_Overview.Value,\r\n            'OP 2 Start':cmp_OP2Start_Overview.Value,\r\n            'OP 2 End': cmp_OP2End_Overview.Value,\r\n            'OP 3 Start':cmp_OP3Start_Overview.Value,\r\n            'OP 3 End': cmp_OP3End_Overview.Value,\r\n            'OP 4 Start':cmp_OP4Start_Overview.Value,\r\n            'OP 4 End': cmp_OP4End_Overview.Value,\r\n            'Contract Access Fee Rate':cmp_ContractAccessFeeRate.Value,\r\n            'Profit Fee Rate': cmp_ProfitFeeRate.Value, \r\n            'Fringe Rate': cmp_FringeRate.Value, \r\n            'Overhead Rate': cmp_OverheadRate.Value, \r\n            'G & A Rate': cmp_GAndARate.Value, \r\n            'FCCOM Rate': cmp_FCCOMRate.Value,             \r\n            Status: {Value: \"Submitted\"}\r\n        }));\r\n        If(_newRecord, \r\n            ForAll(col_[@IGCELine]Template, Patch([@IGCELine], 