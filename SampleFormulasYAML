// =============================================================================
//  ESTIMATE LEVEL READS
//  Screens show a ceiling in list rows and tiles. These roll it up from the
//  sublines the save routines wrote, so no screen repeats the arithmetic and no
//  screen reads a rate directly.
//
//  Scalar parameter, scalar return. Deliberately not a table return: a UDF cannot
//  return a table without a User Defined Type, which house-rules records as
//  experimental, so a table projection stays inline on the screen that needs it.
// =============================================================================

nfIgceSubsOfTotal(headerID: Number): Number =
    Sum(
        Filter(
            colIGCESubLine As s,
            LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
        ) As s,
        s.TotalCost
    );

nfIgceSubsOfFccom(headerID: Number): Number =
    Sum(
        Filter(
            colIGCESubLine As s,
            LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
        ) As s,
        s.BaseYearFCCOM + s.OP1FCCOM + s.OP2FCCOM + s.OP3FCCOM + s.OP4FCCOM
    );

nfIgceFeeOf(headerID: Number): Number =
    nfIGCEFixedFee(
        nfIgceSubsOfTotal(headerID),
        nfIgceSubsOfFccom(headerID),
        LookUp(colIGCEHeader, ID = headerID).ProfitFeeRate
    );

nfIgceCafOf(headerID: Number): Number =
    nfIGCEAccessFee(
        nfIgceSubsOfTotal(headerID),
        nfIgceFeeOf(headerID),
        LookUp(colIGCEHeader, ID = headerID).ContractAccessFeeRate
    );

nfIgceCeilingOf(headerID: Number): Number =
    nfIGCECeiling(
        nfIgceSubsOfTotal(headerID),
        nfIgceFeeOf(headerID),
        nfIgceCafOf(headerID)
    );

// The latest revision of a PR, by revision number rather than by created order.
nfIgceLatestIDOf(prid: Text): Number =
    LookUp(
        colIGCEHeader As h,
        h.PRID = prid
            && h.Revision = Max(Filter(colIGCEHeader, PRID = prid) As r, r.Revision)
    ).ID;

nfIgceRevCountOf(prid: Text): Number =
    CountRows(Filter(colIGCEHeader, PRID = prid));

// A revision can be started only from the latest revision of a PR, only when that
// revision is no longer a Draft, and only when the PR has no open Draft. All three
// are the mockup's canRevise. nfIGCEStartRevision enforces the third itself and
// reports a blocker; this is the version a button reads to decide whether to show.
nfIgceCanRevise(headerID: Number): Boolean =
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        nfIgceLatestIDOf(_h.PRID) = headerID
            && _h.Status.Value <> "Draft"
            && CountRows(Filter(colIGCEHeader, PRID = _h.PRID, Status.Value = "Draft")) = 0
    );

nfIgceIsReadOnly(headerID: Number): Boolean =
    LookUp(colIGCEHeader, ID = headerID).Status.Value <> "Draft";


// =============================================================================
//  LIST PROJECTIONS
//  Written once here rather than five times on one screen. These are named
//  formulas, not UDFs, because a UDF cannot return a table without a User
//  Defined Type and house-rules records those as experimental.
//
//  They read collections seeded in App.OnStart. A named formula evaluates BEFORE
//  OnStart, so each is briefly empty and then recomputes reactively when the seed
//  lands. That is correct for a gallery and is the reason nothing here is used as
//  a fallback value: house-rules section 9 records the three way collision that
//  arises when a named formula is asked to supply one.
// =============================================================================

nfIgceMe = Lower(User().Email);

// One row per PR, the highest revision of each. Revision number, not created
// order, because a revision can be deleted.
