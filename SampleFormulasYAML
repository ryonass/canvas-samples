nfIgcePeriodFee(headerID: Number, periodIndex: Number): Number =
    nfIGCEFixedFee(
        nfIgcePeriodCost(headerID, periodIndex),
        nfIgcePeriodFccom(headerID, periodIndex),
        LookUp(colIGCEHeader, ID = headerID).ProfitFeeRate
    );

nfIgcePeriodCaf(headerID: Number, periodIndex: Number): Number =
    nfIGCEAccessFee(
        nfIgcePeriodCost(headerID, periodIndex),
        nfIgcePeriodFee(headerID, periodIndex),
        LookUp(colIGCEHeader, ID = headerID).ContractAccessFeeRate
    );

nfIgceElementPeriodOf(headerID: Number, key: Text, periodIndex: Number): Number =
    Switch(
        key,
        "labor",   nfIgceLaborCost(headerID, periodIndex),
        "direct",  nfIgceDirectCost(headerID, periodIndex),
        "burden",  nfIgceBurdenCost(headerID, periodIndex),
        "total",   nfIgcePeriodCost(headerID, periodIndex),
        "fccom",   nfIgcePeriodFccom(headerID, periodIndex),
        "fee",     nfIgcePeriodFee(headerID, periodIndex),
        "caf",     nfIgcePeriodCaf(headerID, periodIndex),
        "ceiling",
            nfIGCECeiling(
                nfIgcePeriodCost(headerID, periodIndex),
                nfIgcePeriodFee(headerID, periodIndex),
                nfIgcePeriodCaf(headerID, periodIndex)
            ),
        0
    );


// =============================================================================
//  LINE LEVEL COMPARE
//  Revisions are matched by line Title, as the mockup does: a revision copy
//  mints new line IDs, and a renamed line reads as removed plus added.
// =============================================================================

nfIgceLineTotalOf(lineID: Number): Number =
    With(
        { _l: LookUp(colIGCELine, ID = lineID) },
        _l.BaseYearCost + _l.OP1Cost + _l.OP2Cost + _l.OP3Cost + _l.OP4Cost
    );

nfIgceLineTotalIn(headerID: Number, title: Text): Number =
    Sum(
        Filter(colIGCELine, IGCEHeaderID = headerID, Title = title) As l,
        l.BaseYearCost + l.OP1Cost + l.OP2Cost + l.OP3Cost + l.OP4Cost
    );

nfIgceLineCountIn(headerID: Number, title: Text): Number =
    CountRows(Filter(colIGCELine, IGCEHeaderID = headerID, Title = title));


// =============================================================================
//  EDITOR NAVIGATION
//  One routing function for every stepper and pager. The GFP step exists only when
//  the estimate contains government furnished property.
// =============================================================================

nfIgceStepNav(stepIndex: Number, containsGfp: Boolean): Void = {
    Switch(
        stepIndex,
        1, Navigate(scrIgceHeader, ScreenTransition.None),
        2, Navigate(scrIgceLines, ScreenTransition.None),
        3, If(
               containsGfp,
               Navigate(scrIgceGfp, ScreenTransition.None),
               Navigate(scrIgceBoe, ScreenTransition.None)
           ),
        4, If(
               containsGfp,
               Navigate(scrIgceBoe, ScreenTransition.None),
               Navigate(scrIgceReview, ScreenTransition.None)
           ),
        5, Navigate(scrIgceReview, ScreenTransition.None)
    );
};

nfIgceStepLabels(containsGfp: Boolean): Text =
    If(
        containsGfp,
        "IGCE header|Lines|GFP justification|Basis of estimate|Review",
        "IGCE header|Lines|Basis of estimate|Review"
    );


// =============================================================================
//  BASIS OF ESTIMATE
//  Which of the 19 sections an estimate must answer, and its answers, which are
//  columns on IGCEHeader.
// =============================================================================

nfIgceHasLabor(headerID: Number): Boolean =
    CountRows(Filter(colIGCELine, IGCEHeaderID = headerID, Labor)) > 0;

nfIgceHasCat(headerID: Number, cat: Text): Boolean =
    CountRows(
        Filter(
            colIGCELine,
            IGCEHeaderID = headerID,
            !Labor,
            Category.Value = cat
        )
    ) > 0;

nfIgceHasBurdenedCat(headerID: Number): Boolean =
    nfIgceHasCat(headerID, "Direct Material")
    || nfIgceHasCat(headerID, "Other Direct Costs")
    || nfIgceHasCat(headerID, "Products/Supplies")
    || nfIgceHasCat(headerID, "Travel");

// Which sections this estimate actually has to answer. The mockup's boeNeeded.
nfIgceBoeNeeded(headerID: Number, boeKey: Text): Boolean =
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        Switch(
            boeKey,
            "assume",   true,
            "tools",    true,
            "source",   true,
            "prior",    true,
            "labor",    nfIgceHasLabor(headerID),
            "lcats",    nfIgceHasLabor(headerID),
            "lrates",   nfIgceHasLabor(headerID),
            "hours",    nfIgceHasLabor(headerID),
            "udl",      nfIgceHasLabor(headerID),
            "odc",      nfIgceHasCat(headerID, "Other Direct Costs"),
            "material", nfIgceHasCat(headerID, "Direct Material"),
            "products", nfIgceHasCat(headerID, "Products/Supplies"),
            "subk",     nfIgceHasCat(headerID, "Subcontract"),
            "travel",   nfIgceHasCat(headerID, "Travel"),
            "indirect", nfIgceHasLabor(headerID)
                            && (_h.FringeRate > 0 || _h.OverheadRate > 0),
            "burden",   _h.IndirectBurdenRate > 0 && nfIgceHasBurdenedCat(headerID),
            "ga",       _h.GARate > 0,
            "fccom",    _h.FCCOMRate > 0,
            "fixedfee", _h.ProfitFeeRate > 0,
            false
        )
    );


nfIgceBoeOpenCount(headerID: Number): Number =
    CountRows(
        Filter(
            nfIgceBoeDef As d,
            nfIgceBoeNeeded(headerID, d.BoeKey)
                && IsBlank(Trim(nfIgceBoeAnswerOf(headerID, d.BoeKey)))
        )
    );


nfIgceGfpOpenCount(headerID: Number): Number =
    CountRows(
        Filter(
            Table({ Q: 1 }, { Q: 2 }, { Q: 3 }, { Q: 4 }, { Q: 5 }, { Q: 6 }) As q,
            IsBlank(Trim(nfIgceGfpAnswerOf(headerID, q.Q)))
        )
    );


