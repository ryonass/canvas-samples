\r\n        )\r\n    );\r\n    \r\n    If(_newRecord, \r\n        ForAll(col_[@IGCELine]Template, Patch([@IGCELine], Defaults([@IGCELine]), \r\n            {\r\n                'Line Number': LineNumber,\r\n            Category: Category,\r\n            Description: Title,\r\n            Labor: Labor,\r\n            [@IGCEHeader]: {\r\n                '@odata.type':\"#Microsoft.Azure.Connectors.SharePoint.SPListExpandedReference\",\r\n                Id:gl_IGCE.ID, \r\n                Value:gl_IGCE.ID\r\n            }, [@IGCEHeader]ID: gl_IGCE.ID\r\n            }));\r\n    );\r\n\r\n    // check for errors\r\n    If(\r\n        IsEmpty(Errors([@IGCEHeader])),\r\n        // on success\r\n        Notify(\r\n            \"Success: IGCE Form Saved\",\r\n            NotificationType.Success\r\n        ),\r\n        // on failure\r\n        Notify(\r\n            \"Errors: IGCE Form Was Not Saved\",\r\n            NotificationType.Error\r\n        )\r\n    );,\r\n    // Data validation failed\r\n    Notify(\r\n        \"Please correct all errors before submitting the form\",\r\n        NotificationType.Error\r\n    )\r\n)\r\n\r\n*/"
