// The signed in user, in person column shape.
nfSignedIn =
    {
        Claims:      "i:0#.f|membership|" & Lower(User().Email),
        DisplayName: User().FullName,
        Email:       Lower(User().Email),
        Department:  "",
        JobTitle:    ""
    };

// The people the POC and COR pickers offer: the person column's own choices, which
// are real accounts in the tenant, with the signed in user always among them.
nfPeople =
    With(
        {
            _p: ForAll(
                Choices(IGCEHeader.PointOfContact) As p,
                { Claims: p.Claims, DisplayName: p.DisplayName, Email: Lower(p.Email), Department: p.Department, JobTitle: p.JobTitle }
            )
        },
        If(
            IsBlank(LookUp(_p, Email = nfSignedIn.Email)),
            Ungroup(Table({ G: Table(nfSignedIn) }, { G: _p }), G),
            _p
        )
    );

// Choice values are the SharePoint columns' own choices.
nfChoiceIGCEType = ForAll(Choices(IGCEHeader.IGCEType) As c, { Value: c.Value });
nfChoiceSublineType = ForAll(Choices(IGCESubLine.SublineType) As c, { Value: c.Value });
nfChoiceODCCategory = ForAll(Choices(IGCESubLine.ODCCategory) As c, { Value: c.Value });
nfChoicePropertyType = ForAll(Choices(IGCESubLine.PropertyType) As c, { Value: c.Value });
nfChoiceUnits = ForAll(Choices(IGCESubLine.Units) As c, { Value: c.Value });

// Line categories, less the rows the app computes. The column also offers G&A Rate,
// Fixed Fee Profit, FCCOM, the access charge and the indirect rows, and a line in
// one of those would count that cost twice. Standard Line is the old app's labor
// marker; here a labor line is Labor true with no category.
nfChoiceCategory =
    ForAll(
        Filter(
            Choices(IGCELine.Category) As c,
            !(c.Value in [
                "Standard Line", "G&A Rate", "Fixed Fee Profit", "FCCOM",
                "Servicing Agency Fee/Access Charge",
                "Indirect Burden to ODC/Travel", "Indirect Labor Rates"
