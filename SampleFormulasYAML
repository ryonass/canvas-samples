// =====================================================================================
// OCOSO template theme and app formulas.
// Paste into App.Formulas. Everything here is reactive; nothing here reads OnStart state
// except through the collections it names, which are seeded there.
// =====================================================================================

// =====================================================================================
// 1. EDIT FOR EVERY NEW APP
// nfApp, nfLogo, nfHeaderLinks, nfStatus, nfTiles and the labels in nfNav. A new app changes nothing below this section.
// =====================================================================================

// ---- Per app settings ------------------------------------------------------------------
nfApp = {
    Name: "Service Requests",
    // What one record is called, and who works them. Every button, title and message is built from these.
    Item: { Singular: "request", Plural: "requests" },
    Team: "service desk",
    Tagline: "Request a service and follow it to completion.",
    Version: "1.0.0",
    ContactEmail: "servicedesk@example.gov",
    StaffGroupId: "",
    PreviewAsStaff: false,
    Notice: "This is the OCOSO template. Replace this notice, or set it to blank to hide it.",
    FormInstructions: "Tell us what you need. Fields marked with * are required.",
    // The header logo is drawn 32 high and this wide, fitted without stretching. Widen it for a wordmark.
    LogoWidth: 32
};

// ---- Logo -------------------------------------------------------------------------------
// The header logo: an image added to the app under Media, SVG or PNG. Add the image, then put its name
// here without quotes, for example nfLogo = AppLogo; (assets/AppLogo.svg in the repo is a placeholder).
// A name that starts with a digit or has spaces goes in single quotes. Blank() shows no logo. Naming an image the app does not have is an error, so add the image first.
nfLogo = '748336837_super';

// ---- Header links, in order. Each opens its Url in a new tab ----------------------------------
// Add, remove or reorder rows. A row with a blank Url is hidden, so both are hidden until you fill them in.
// Up to four show. A phone has room for one, the first with a Url, so put the one people need most first.
nfHeaderLinks = Table(
    { Label: "Help", Url: "https://www.crunchyroll.com/series/GT00385867/magic-repo-man-dumped-by-my-party-ill-cash-in-with-a-cute-support-fairy-to-become-the-strongest" },
    { Label: "Services Hub", Url: "" }
);

// ---- Status. Keys are stored; labels are only ever displayed ----------------------------
// An app changes its statuses here. The buttons that move a record from one status to the next are on
// scrDetail, one per action.
// Tone picks the pill colours from nfTone: Neutral, Info, Warning, Success, Danger.
// IsStart: the status a new record gets (exactly one, and it must be Open). Open: still needs work;
// nfSetStatus copies it into the record's IsOpen column, which is what every "open" filter reads.
// Editable: the requester may still edit it.
nfStatus = Table(
    { Key: "Submitted", Label: "Submitted", Tone: "Info", IsStart: true, Open: true, Editable: true },
    { Key: "InProgress", Label: "In progress", Tone: "Warning", IsStart: false, Open: true, Editable: false },
    { Key: "OnHold", Label: "On hold", Tone: "Neutral", IsStart: false, Open: true, Editable: false },
    { Key: "Completed", Label: "Completed", Tone: "Success", IsStart: false, Open: false, Editable: false },
    { Key: "Cancelled", Label: "Cancelled", Tone: "Danger", IsStart: false, Open: false, Editable: false }
);

// ---- Overview tiles, in order. The first is highlighted. Filter is a status key or "open" --------
nfTiles = Table(
    { Label: "Open", Filter: "open", Context: "Not yet completed" },
    { Label: "Waiting", Filter: "Submitted", Context: "Not picked up yet" },
    { Label: "In progress", Filter: "InProgress", Context: "Being worked on" },
    { Label: "Completed", Filter: "Completed", Context: "Closed out" }
);

// ---- Navigation. Every tab, and every view within a tab, defined once ----------------------
// ParentKey "" is a main tab (header and bottom nav). A row whose ParentKey names a main tab is a view
// of that tab's list, offered in the filter dropdown on its screen, as the queue's are on scrQueue.
// Change the labels freely. A new main tab also needs a line in nfGo, in section 2. The counts name the
// data: see Switch to SharePoint in docs/start-a-new-app.md.
nfNav = Table(
    { Key: "overview", Label: "Overview", Count: 0, StaffOnly: false, ParentKey: "" },
    { Key: "list", Label: "My " & nfItems, Count: CountRows(Filter(nfMyRequests, IsOpen = true)), StaffOnly: false, ParentKey: "" },
    { Key: "form", Label: "New " & nfItem, Count: 0, StaffOnly: false, ParentKey: "" },
    { Key: "queue", Label: "Queue", Count: CountRows(Filter(colRequests, IsBlank(AssignedTo), Status = nfStartStatus)), StaffOnly: true, ParentKey: "" },
    { Key: "queue-unassigned", Label: "Unassigned", Count: CountRows(Filter(colRequests, IsBlank(AssignedTo), IsOpen = true)), StaffOnly: true, ParentKey: "queue" },
    { Key: "queue-mine", Label: "Assigned to me", Count: CountRows(Filter(colRequests, AssignedTo = nfUserEmail, IsOpen = true)), StaffOnly: true, ParentKey: "queue" },
    { Key: "queue-open", Label: "All open", Count: 0, StaffOnly: true, ParentKey: "queue" }
);

// =====================================================================================
// 2. LEAVE AS IS
// Colour, sizes, layout and the helpers the screens call. The only lines here an app ever changes are
// nfGo, when it adds a tab, and the ones named in Switch to SharePoint in docs/start-a-new-app.md.
// =====================================================================================

// ---- Colour: the DHS palette, the same in every app. Components take it as Theme: =nfColor --
nfColor = {
    Primary: RGBA(0, 82, 136, 1),
    PrimaryDark: RGBA(0, 62, 103, 1),
    PrimarySoft: RGBA(214, 227, 236, 1),
    OnPrimary: RGBA(255, 255, 255, 1),
    HeaderFill: RGBA(0, 43, 71, 1),
    HeaderInk: RGBA(255, 255, 255, 1),
    HeaderInk2: RGBA(214, 227, 236, 1),
    Page: RGBA(237, 238, 238, 1),
    Surface: RGBA(255, 255, 255, 1),
    Sunk: RGBA(248, 248, 249, 1),
    Line: RGBA(222, 223, 224, 1),
    Ink: RGBA(25, 25, 26, 1),
    Ink2: RGBA(68, 69, 71, 1),
    Ink3: RGBA(90, 91, 93, 1),
    Focus: RGBA(0, 120, 174, 1),
    Danger: RGBA(196, 18, 48, 1),
    DangerSoft: RGBA(246, 217, 222, 1),
    NeutralInk: RGBA(68, 69, 71, 1),
    NeutralSoft: RGBA(229, 229, 229, 1),
    InfoInk: RGBA(0, 62, 103, 1),
    InfoSoft: RGBA(214, 233, 242, 1),
    WarningInk: RGBA(92, 72, 9, 1),
    WarningSoft: RGBA(250, 243, 209, 1),
    SuccessInk: RGBA(49, 79, 26, 1),
    SuccessSoft: RGBA(229, 238, 222, 1),
    DangerInk: RGBA(102, 9, 25, 1),
    Hover: RGBA(0, 82, 136, 0.08),
    Pressed: RGBA(0, 82, 136, 0.16),
    Scrim: RGBA(25, 25, 26, 0.5),
    Transparent: RGBA(0, 0, 0, 0)
};

// ---- Type, space, sizes ---------------------------------------------------------------
// Input is the text size of every input. 16 on phones: iOS, which the Power Apps mobile app runs on, zooms
// into any input with smaller text when it is tapped, and does not zoom back out.
nfType = { Display: 28, H1: 22, H2: 18, Body: 14, Small: 12, Input: If(App.Width < 600, 16, 14) };
nfSpace = { Xs: 4, Sm: 8, Md: 12, Lg: 16, Xl: 24, Xxl: 32 };
nfRadius = { Sm: 4, Md: 8, Lg: 12 };
nfSize = { Header: 56, BottomNav: 64, Control: 36, Row: 52, CardRow: 76, ListRow: 64, Tile: 112, Pill: 120, FieldLabel: 56, Field: 96, DetailField: 44 };
nfPageMaxW = 1200;

// ---- Layout. Scale to fit is OFF; everything responds to App.Width ----------------------
nfLayout = If(App.Width < 600, "Phone", App.Width < 1024, "Tablet", "Desktop");
nfIsPhone = nfLayout = "Phone";
nfIsDesktop = nfLayout = "Desktop";
nfGutter = If(nfIsPhone, nfSpace.Lg, nfSpace.Xxl);

// ---- What a record is called. Lower case for the middle of a sentence, Cap at the start of one.
nfItem = nfApp.Item.Singular;
nfItems = nfApp.Item.Plural;
nfItemCap = Upper(Left(nfItem, 1)) & Mid(nfItem, 2);
nfItemsCap = Upper(Left(nfItems, 1)) & Mid(nfItems, 2);

// ---- The signed in user -----------------------------------------------------------------
nfUserEmail = Lower(User().Email);
nfUserName = User().FullName;
nfFirstName = First(Split(User().FullName, " ")).Value;
nfGreeting = If(Hour(Now()) < 12, "Good morning", Hour(Now()) < 17, "Good afternoon", "Good evening");

// ---- Worked out from nfStatus -------------------------------------------------------------
nfStartStatus = LookUp(nfStatus, IsStart).Key;
// Pill colours, one row per tone. Every status pill, on the detail screen and in every list row, reads its
// fill and text colour from here through nfStatusTone. A Tone in nfStatus must be one of these.
nfTone = Table(
    { Tone: "Neutral", Fill: nfColor.NeutralSoft, Ink: nfColor.NeutralInk },
    { Tone: "Info", Fill: nfColor.InfoSoft, Ink: nfColor.InfoInk },
    { Tone: "Warning", Fill: nfColor.WarningSoft, Ink: nfColor.WarningInk },
    { Tone: "Success", Fill: nfColor.SuccessSoft, Ink: nfColor.SuccessInk },
    { Tone: "Danger", Fill: nfColor.DangerSoft, Ink: nfColor.DangerInk }
);
// The choices in a status filter: All and Open, then every status in nfStatus. Needs no edits.
nfStatusFilters = Ungroup(
    Table(
        { Rows: Table({ Key: "all", Label: "All statuses" }, { Key: "open", Label: "Open" }) },
        { Rows: ShowColumns(nfStatus, Key, Label) }
    ),
    Rows
);

// ---- Helpers the screens call ----------------------------------------------------------------
nfTileCount(f: Text): Number = If(
    f = "open",
    CountRows(Filter(nfMyRequests, IsOpen = true)),
    CountRows(Filter(nfMyRequests, Status = f))
);
nfNavLabel(key: Text): Text = LookUp(nfNav, Key = key).Label;
nfStatusLabel(key: Text): Text = Coalesce(LookUp(nfStatus, Key = key).Label, key);
nfStatusTone(key: Text): Text = Coalesce(LookUp(nfStatus, Key = key).Tone, "Neutral");
nfServiceTitle(key: Text): Text = Coalesce(LookUp(colServices, Key = key).Title, key);

// ---- Worked out from nfNav ----------------------------------------------------------------
// The header and bottom nav take Key, Label, Count and StaffOnly only.
nfNavMain = ShowColumns(Filter(nfNav, ParentKey = ""), Key, Label, Count, StaffOnly);
nfNavQueue = ShowColumns(Filter(nfNav, ParentKey = "queue"), Key, Label, Count, StaffOnly);
nfGo(key: Text): Void = {
    Switch(
        key,
        "overview", Navigate(scrOverview, ScreenTransition.None),
        "list", Navigate(scrList, ScreenTransition.None, { locStatusFilter: "all" }),
        "form", Navigate(scrForm, ScreenTransition.None, { locId: 0 }),
        "queue", Navigate(scrQueue, ScreenTransition.None, { locView: "queue-unassigned" })
    )
};

// ---- Data the overview reads ------------------------------------------------------------
nfMyRequests = Filter(colRequests, RequesterEmail = nfUserEmail);
nfMyRecent = FirstN(SortByColumns(nfMyRequests, "Modified", SortOrder.Descending), 5);

// ---- Writes. Every status change also writes a history row -------------------------------
// IsOpen is kept in step with the status here, from nfStatus.Open, so lists can filter on IsOpen = true.
// Modified is set here because a collection does not stamp it. Remove it from both Patch
// calls when the app is bound to the SharePoint list, which stamps it itself.
nfSetStatus(id: Number, status: Text, action: Text): Void = {
    Patch(colRequests, LookUp(colRequests, ID = id), { Status: status, IsOpen: LookUp(nfStatus, Key = status).Open, Modified: Now() });
    Collect(colHistory, { RequestId: id, Action: action, ActorEmail: nfUserEmail, ActorName: nfUserName, Created: Now() })
};
nfAssignToMe(id: Number): Void = {
    Patch(colRequests, LookUp(colRequests, ID = id), { AssignedTo: nfUserEmail, Modified: Now() });
    Collect(colHistory, { RequestId: id, Action: "Assigned to " & nfUserName, ActorEmail: nfUserEmail, ActorName: nfUserName, Created: Now() })
};
