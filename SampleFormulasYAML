// =============================================================================
//  CISA COCO IGCE
//  The calculation chain first: pure functions of their arguments, checked against
//  docs/expected-rollups.md. Then the save routines, the SharePoint write back,
//  screen tokens, reads, and reference data.
// =============================================================================


// =============================================================================
//  RATES
//  Rates are held as whole numbers (32 means 32 per cent), converted here only.
//  SharePoint stores fractions; OnStart and nfIgceSpSync convert (decisions.md D9).
// =============================================================================

nfIGCEPct(whole: Number): Number = Coalesce(whole, 0) / 100;

// D9: a rate above 100 is almost certainly a fraction entered as a whole
// number, or the reverse. Validation surfaces it rather than producing an
// estimate two orders of magnitude out.
nfIGCERateSuspect(whole: Number): Boolean = Coalesce(whole, 0) > 100;

// D2: the indirect burden column does not exist on IGCEHeader yet. Absent, it
// reads 0, and the chain then matches the handoff exactly. It does not
// silently vanish - the README records it and validation reports it.
nfIGCEBurdenRate(whole: Number): Number = nfIGCEPct(Coalesce(whole, 0));


// =============================================================================
//  PERIODS
//  OptionPeriods counts option periods (0 to 4); active periods are that plus the base (D1).
// =============================================================================

nfIGCEPeriodCount(optionPeriods: Number): Number =
    1 + Max(0, Min(4, Coalesce(optionPeriods, 0)));

nfIGCEPeriodActive(periodIndex: Number, optionPeriods: Number): Boolean =
    periodIndex < nfIGCEPeriodCount(optionPeriods);

nfIGCEPeriodLabel(periodIndex: Number): Text =
    If(periodIndex = 0, "Base", "OP" & periodIndex);


// =============================================================================
//  SUBLINE COST
//  Rate and cost per period. The inflated rate is rounded to cents before it is
//  multiplied, as the mockup does.
// =============================================================================

nfIGCERateFor(baseRate: Number, enteredRate: Number, calcOptionPeriods: Boolean, periodIndex: Number, inflationWhole: Number): Number =
    If(
        periodIndex = 0 || !calcOptionPeriods,
        Coalesce(enteredRate, 0),
        RoundDown(Coalesce(baseRate, 0) * Power(1 + nfIGCEPct(inflationWhole), periodIndex) * 100 + 0.5, 0) / 100
    );

nfIGCECostFor(quantity: Number, rate: Number): Number =
    Coalesce(quantity, 0) * Coalesce(rate, 0);


// =============================================================================
//  SUBLINE INDIRECTS
//  Fringe and overhead apply to labor sublines only; cost sublines take G&A and
//  FCCOM on cost directly (D4).
// =============================================================================

nfIGCEFringeFor(cost: Number, isLabor: Boolean, fringeWhole: Number): Number =
    If(isLabor, cost * nfIGCEPct(fringeWhole), 0);

nfIGCEOverheadFor(cost: Number, fringe: Number, isLabor: Boolean, overheadWhole: Number): Number =
    If(isLabor, (cost + fringe) * nfIGCEPct(overheadWhole), 0);

// The base G&A and FCCOM sit on: loaded labor, or bare cost.
nfIGCEIndirectBase(cost: Number, fringe: Number, overhead: Number): Number =
    cost + fringe + overhead;

nfIGCEGAFor(cost: Number, fringe: Number, overhead: Number, gaWhole: Number): Number =
    nfIGCEIndirectBase(cost, fringe, overhead) * nfIGCEPct(gaWhole);

nfIGCEFCCOMFor(cost: Number, fringe: Number, overhead: Number, fccomWhole: Number): Number =
    nfIGCEIndirectBase(cost, fringe, overhead) * nfIGCEPct(fccomWhole);

// Step 5. Mirrors the IGCESubLine calculated columns Burden and TotalCost.
nfIGCEBurdenFor(fringe: Number, overhead: Number, ga: Number, fccom: Number): Number =
    fringe + overhead + ga + fccom;

nfIGCETotalCostFor(cost: Number, burden: Number): Number = cost + burden;


// =============================================================================
//  ESTIMATE LEVEL, PER PERIOD
//  Fee, access fee and ceiling from period sums already rolled up.
// =============================================================================


// Fee excludes facilities cost of money from its base. Both the handoff and
// the mockup agree on this.
nfIGCEFixedFee(totalCost: Number, fccom: Number, feeWhole: Number): Number =
    (totalCost - fccom) * nfIGCEPct(feeWhole);

nfIGCEAccessFee(totalCost: Number, fixedFee: Number, cafWhole: Number): Number =
    (totalCost + fixedFee) * nfIGCEPct(cafWhole);

nfIGCECeiling(totalCost: Number, fixedFee: Number, accessFee: Number): Number =
    totalCost + fixedFee + accessFee;


// =============================================================================
//  SETTINGS
//  A missing settings key shows a marker, never a silent blank.
// =============================================================================

nfIGCESettingMissing(key: Text): Text = "[missing setting: " & key & "]";


// =============================================================================
//  DISPLAY
// =============================================================================

nfIGCEMoney(v: Number): Text = "$" & Text(Coalesce(v, 0), "[$-en-US]#,##0");
nfIGCEMoney2(v: Number): Text = "$" & Text(Coalesce(v, 0), "[$-en-US]#,##0.00");
nfIGCEDay(d: DateTime): Text = Text(d, "[$-en-US]mmm d, yyyy");


// =============================================================================
//  RECALC, BOTTOM UP
//  One routine per level. Every save ends in nfIGCERecalcHeader, which rebuilds
//  the whole estimate, because a header rate reaches every subline.
// =============================================================================

nfIGCERecalcSubLine(subLineID: Number): Void = {
    With(
      { _s: LookUp(colIGCESubLine, ID = subLineID) },
      With(
        { _l: LookUp(colIGCELine, ID = _s.IGCELineID) },
        With(
          { _h: LookUp(colIGCEHeader, ID = _l.IGCEHeaderID) },
          With(
            {
              _c0: If(nfIGCEPeriodActive(0, _h.OptionPeriods), nfIGCECostFor(_s.BaseYearQuantity, nfIGCERateFor(_s.BaseYearRate, _s.BaseYearRate, _s.CalculateOptionPeriods, 0, _h.InflationRate)), 0),
              _c1: If(nfIGCEPeriodActive(1, _h.OptionPeriods), nfIGCECostFor(_s.OP1Quantity, nfIGCERateFor(_s.BaseYearRate, _s.OP1Rate, _s.CalculateOptionPeriods, 1, _h.InflationRate)), 0),
              _c2: If(nfIGCEPeriodActive(2, _h.OptionPeriods), nfIGCECostFor(_s.OP2Quantity, nfIGCERateFor(_s.BaseYearRate, _s.OP2Rate, _s.CalculateOptionPeriods, 2, _h.InflationRate)), 0),
              _c3: If(nfIGCEPeriodActive(3, _h.OptionPeriods), nfIGCECostFor(_s.OP3Quantity, nfIGCERateFor(_s.BaseYearRate, _s.OP3Rate, _s.CalculateOptionPeriods, 3, _h.InflationRate)), 0),
              _c4: If(nfIGCEPeriodActive(4, _h.OptionPeriods), nfIGCECostFor(_s.OP4Quantity, nfIGCERateFor(_s.BaseYearRate, _s.OP4Rate, _s.CalculateOptionPeriods, 4, _h.InflationRate)), 0)
            },
            With(
              {
                _f0: nfIGCEFringeFor(_c0, _l.Labor, _h.FringeRate),
                _f1: nfIGCEFringeFor(_c1, _l.Labor, _h.FringeRate),
                _f2: nfIGCEFringeFor(_c2, _l.Labor, _h.FringeRate),
                _f3: nfIGCEFringeFor(_c3, _l.Labor, _h.FringeRate),
                _f4: nfIGCEFringeFor(_c4, _l.Labor, _h.FringeRate)
              },
              With(
                {
                  _o0: nfIGCEOverheadFor(_c0, _f0, _l.Labor, _h.OverheadRate),
                  _o1: nfIGCEOverheadFor(_c1, _f1, _l.Labor, _h.OverheadRate),
                  _o2: nfIGCEOverheadFor(_c2, _f2, _l.Labor, _h.OverheadRate),
                  _o3: nfIGCEOverheadFor(_c3, _f3, _l.Labor, _h.OverheadRate),
                  _o4: nfIGCEOverheadFor(_c4, _f4, _l.Labor, _h.OverheadRate)
                },
                With(
                  {
                    _g0: nfIGCEGAFor(_c0, _f0, _o0, _h.GARate),
                    _g1: nfIGCEGAFor(_c1, _f1, _o1, _h.GARate),
                    _g2: nfIGCEGAFor(_c2, _f2, _o2, _h.GARate),
                    _g3: nfIGCEGAFor(_c3, _f3, _o3, _h.GARate),
                    _g4: nfIGCEGAFor(_c4, _f4, _o4, _h.GARate)
                  },
                  With(
                    {
                      _k0: nfIGCEFCCOMFor(_c0, _f0, _o0, _h.FCCOMRate),
                      _k1: nfIGCEFCCOMFor(_c1, _f1, _o1, _h.FCCOMRate),
                      _k2: nfIGCEFCCOMFor(_c2, _f2, _o2, _h.FCCOMRate),
                      _k3: nfIGCEFCCOMFor(_c3, _f3, _o3, _h.FCCOMRate),
                      _k4: nfIGCEFCCOMFor(_c4, _f4, _o4, _h.FCCOMRate)
                    },
                    Patch(
                      colIGCESubLine,
                      _s,
                      {
                        BaseYearFringe:    _f0,
                        BaseYearOverhead:  _o0,
                        BaseYearGAndA:     _g0,
                        BaseYearFCCOM:     _k0,
                        BaseYearCost:      _c0,
                        BaseYearBurden:    nfIGCEBurdenFor(_f0, _o0, _g0, _k0),
                        BaseYearTotalCost: nfIGCETotalCostFor(_c0, nfIGCEBurdenFor(_f0, _o0, _g0, _k0)),
                        OP1Fringe:    _f1,
                        OP1Overhead:  _o1,
                        OP1GAndA:     _g1,
                        OP1FCCOM:     _k1,
                        OP1Cost:      _c1,
                        OP1Burden:    nfIGCEBurdenFor(_f1, _o1, _g1, _k1),
                        OP1TotalCost: nfIGCETotalCostFor(_c1, nfIGCEBurdenFor(_f1, _o1, _g1, _k1)),
                        OP2Fringe:    _f2,
                        OP2Overhead:  _o2,
                        OP2GAndA:     _g2,
                        OP2FCCOM:     _k2,
                        OP2Cost:      _c2,
                        OP2Burden:    nfIGCEBurdenFor(_f2, _o2, _g2, _k2),
                        OP2TotalCost: nfIGCETotalCostFor(_c2, nfIGCEBurdenFor(_f2, _o2, _g2, _k2)),
                        OP3Fringe:    _f3,
                        OP3Overhead:  _o3,
                        OP3GAndA:     _g3,
                        OP3FCCOM:     _k3,
                        OP3Cost:      _c3,
                        OP3Burden:    nfIGCEBurdenFor(_f3, _o3, _g3, _k3),
                        OP3TotalCost: nfIGCETotalCostFor(_c3, nfIGCEBurdenFor(_f3, _o3, _g3, _k3)),
                        OP4Fringe:    _f4,
                        OP4Overhead:  _o4,
                        OP4GAndA:     _g4,
                        OP4FCCOM:     _k4,
                        OP4Cost:      _c4,
                        OP4Burden:    nfIGCEBurdenFor(_f4, _o4, _g4, _k4),
                        OP4TotalCost: nfIGCETotalCostFor(_c4, nfIGCEBurdenFor(_f4, _o4, _g4, _k4)),
                        TotalCost:
                                nfIGCETotalCostFor(_c0, nfIGCEBurdenFor(_f0, _o0, _g0, _k0))
                              + nfIGCETotalCostFor(_c1, nfIGCEBurdenFor(_f1, _o1, _g1, _k1))
                              + nfIGCETotalCostFor(_c2, nfIGCEBurdenFor(_f2, _o2, _g2, _k2))
                              + nfIGCETotalCostFor(_c3, nfIGCEBurdenFor(_f3, _o3, _g3, _k3))
                              + nfIGCETotalCostFor(_c4, nfIGCEBurdenFor(_f4, _o4, _g4, _k4))
                      }
                    )
                  )
                )
              )
            )
          )
        )
      )
    );
};

// A line's period cost is its sublines' burdened TotalCost (D10). Accountable
// property sums unburdened Cost of Accountable property sublines (D11).
nfIGCERecalcLine(lineID: Number): Void = {
    ForAll(
        Filter(colIGCESubLine, IGCELineID = lineID) As s,
        nfIGCERecalcSubLine(s.ID)
    );
    Patch(
        colIGCELine,
        LookUp(colIGCELine, ID = lineID),
        {
            BaseYearCost: Coalesce(Sum(Filter(colIGCESubLine, IGCELineID = lineID) As s, s.BaseYearTotalCost), 0),
            OP1Cost: Coalesce(Sum(Filter(colIGCESubLine, IGCELineID = lineID) As s, s.OP1TotalCost), 0),
            OP2Cost: Coalesce(Sum(Filter(colIGCESubLine, IGCELineID = lineID) As s, s.OP2TotalCost), 0),
            OP3Cost: Coalesce(Sum(Filter(colIGCESubLine, IGCELineID = lineID) As s, s.OP3TotalCost), 0),
            OP4Cost: Coalesce(Sum(Filter(colIGCESubLine, IGCELineID = lineID) As s, s.OP4TotalCost), 0),
            AccountablePropertyTotal:
                Coalesce(Sum(
                    Filter(
                        colIGCESubLine,
                        IGCELineID = lineID,
                        IncludesProperty,
                        PropertyType.Value = "Accountable"
                    ) As s,
                    s.BaseYearCost + s.OP1Cost + s.OP2Cost + s.OP3Cost + s.OP4Cost
                ),
                0
            )
        }
    );
};

nfIGCERecalcHeader(headerID: Number): Void = {
    ForAll(
        Filter(colIGCELine, IGCEHeaderID = headerID) As l,
        nfIGCERecalcLine(l.ID)
    );
    Patch(
        colIGCEHeader,
        LookUp(colIGCEHeader, ID = headerID),
        {
            AccountablePropertyTotal:
                Coalesce(Sum(Filter(colIGCELine, IGCEHeaderID = headerID) As l, l.AccountablePropertyTotal), 0),
            Modified: Now()
        }
    );
};


// =============================================================================
//  VALIDATION
//  colIGCEBlockers stops a submit; each row names its Field so a control can show
//  the message beside it. colIGCEUnchecked holds warnings that do not.
// =============================================================================

nfIGCEValidate(headerID: Number): Void = {
    Clear(colIGCEBlockers);
    Clear(colIGCEUnchecked);
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        Collect(
            colIGCEBlockers,
            Filter(
                Table(
                    { Scope: "header", RefID: headerID, Field: "PRTrackerNumber",
                      Message: "Pick the PR this estimate belongs to.",
                      Fail: IsBlank(_h.PRTrackerNumber) },
                    { Scope: "header", RefID: headerID, Field: "IGCEType",
                      Message: "Choose an IGCE type.",
                      Fail: IsBlank(_h.IGCEType.Value) },
                    { Scope: "header", RefID: headerID, Field: "PointOfContact",
                      Message: "Name a point of contact.",
                      Fail: IsBlank(_h.PointOfContact.Email) },
                    { Scope: "header", RefID: headerID, Field: "COR",
                      Message: "Name the COR who will review this estimate.",
                      Fail: IsBlank(_h.COR.Email) },
                    { Scope: "header", RefID: headerID, Field: "BasePeriodStart",
                      Message: "Set the base period start date.",
                      Fail: IsBlank(_h.BasePeriodStart) },
                    { Scope: "header", RefID: headerID, Field: "BasePeriodEnd",
                      Message: "Set the base period end date.",
                      Fail: IsBlank(_h.BasePeriodEnd) },
                    { Scope: "header", RefID: headerID, Field: "BasePeriodEnd",
                      Message: "The base period ends before it starts.",
                      Fail: !IsBlank(_h.BasePeriodStart) && !IsBlank(_h.BasePeriodEnd)
                            && _h.BasePeriodEnd <= _h.BasePeriodStart },
                    { Scope: "header", RefID: headerID, Field: "OptionPeriods",
                      Message: "Option periods must be 0 to 4.",
                      Fail: Coalesce(_h.OptionPeriods, -1) < 0 || _h.OptionPeriods > 4 },
                    { Scope: "header", RefID: headerID, Field: "InflationRate",
                      Message: "Inflation rate reads as over 100 per cent. Enter it as a whole number: 2 means 2 per cent.",
                      Fail: nfIGCERateSuspect(_h.InflationRate) },
                    { Scope: "header", RefID: headerID, Field: "FringeRate",
                      Message: "Fringe rate reads as over 100 per cent. Enter it as a whole number.",
                      Fail: nfIGCERateSuspect(_h.FringeRate) },
                    { Scope: "header", RefID: headerID, Field: "OverheadRate",
                      Message: "Overhead rate reads as over 100 per cent. Enter it as a whole number.",
                      Fail: nfIGCERateSuspect(_h.OverheadRate) },
                    { Scope: "header", RefID: headerID, Field: "GARate",
                      Message: "G&A rate reads as over 100 per cent. Enter it as a whole number.",
                      Fail: nfIGCERateSuspect(_h.GARate) },
                    { Scope: "header", RefID: headerID, Field: "FCCOMRate",
                      Message: "FCCOM rate reads as over 100 per cent. Enter it as a whole number.",
                      Fail: nfIGCERateSuspect(_h.FCCOMRate) },
                    { Scope: "header", RefID: headerID, Field: "ProfitFeeRate",
                      Message: "Profit or fee rate reads as over 100 per cent. Enter it as a whole number.",
                      Fail: nfIGCERateSuspect(_h.ProfitFeeRate) },
                    { Scope: "header", RefID: headerID, Field: "ContractAccessFeeRate",
                      Message: "Contract access fee rate reads as over 100 per cent. Enter it as a whole number.",
                      Fail: nfIGCERateSuspect(_h.ContractAccessFeeRate) },
                    { Scope: "header", RefID: headerID, Field: "Status",
                      Message: "Only a Draft can be submitted.",
                      Fail: _h.Status.Value <> "Draft" },
                    { Scope: "header", RefID: headerID, Field: "Lines",
                      Message: "An estimate needs at least one line.",
                      Fail: CountRows(Filter(colIGCELine, IGCEHeaderID = headerID)) = 0 }
                ),
                Fail
            )
        )
    );

    // A line with no sublines has nothing to cost, so it would submit as zero.
    Collect(
        colIGCEBlockers,
        Filter(
            ForAll(
                Filter(colIGCELine, IGCEHeaderID = headerID) As l,
                { Scope: "line", RefID: l.ID, Field: "SubLines",
                  Message: "Line " & l.LineNumber & " " & l.Title & " has no sublines.",
                  Fail: CountRows(Filter(colIGCESubLine, IGCELineID = l.ID)) = 0 }
            ),
            Fail
        )
    );

    // Base period quantity and rate are required on every subline. The option
    // periods are checked below, per period, and only while that period is active.
    Collect(
        colIGCEBlockers,
        Filter(
            ForAll(
                Filter(
                    colIGCESubLine As s,
                    LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
                ) As s,
                { Scope: "subline", RefID: s.ID, Field: "BaseYearQuantity",
                  Message: "Subline " & s.Ref & " " & s.Title & " has no base period quantity.",
                  Fail: Coalesce(s.BaseYearQuantity, 0) <= 0 }
            ),
            Fail
        )
    );

    Collect(
        colIGCEBlockers,
        Filter(
            ForAll(
                Filter(
                    colIGCESubLine As s,
                    LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
                ) As s,
                { Scope: "subline", RefID: s.ID, Field: "BaseYearRate",
                  Message: "Subline " & s.Ref & " " & s.Title & " has no base period rate.",
                  Fail: Coalesce(s.BaseYearRate, 0) <= 0 }
            ),
            Fail
        )
    );

    Collect(
        colIGCEBlockers,
        Filter(
            ForAll(
                Filter(colIGCESubLine, IncludesProperty) As s,
                { Scope: "subline", RefID: s.ID, Field: "PropertyType",
                  Message: "Subline " & s.Ref & " " & s.Title & " is flagged as property but has no property type.",
                  Fail: LookUp(colIGCELine, ID = s.IGCELineID).IGCEHeaderID = headerID
                        && IsBlank(s.PropertyType.Value) }
            ),
            Fail
        )
    );

    // SharePoint version: the GFP answers and the basis of estimate have columns
    // on IGCEHeader, so both are checked and both block submit.
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        Collect(
            colIGCEBlockers,
            Filter(
                Table(
                    { Scope: "header", RefID: headerID, Field: "ContainsGFP",
                      Message: nfIgceGfpOpenCount(headerID) & " of the six GFP justification answers are empty.",
                      Fail: _h.ContainsGFP && nfIgceGfpOpenCount(headerID) > 0 },
                    { Scope: "header", RefID: headerID, Field: "BasisOfEstimate",
                      Message: nfIgceBoeOpenCount(headerID) & " required basis of estimate sections are empty.",
                      Fail: nfIgceBoeOpenCount(headerID) > 0 }
                ),
                Fail
            )
        );
        Collect(
            colIGCEUnchecked,
            Filter(
                Table(
                    { Scope: "header", RefID: headerID, Field: "IndirectBurdenRate",
                      Message: "Indirect burden is 0, so ODC and travel carry no separate burden. If the client expects one, set Indirect Burden Rate on the header.",
                      Fail: Coalesce(_h.IndirectBurdenRate, 0) = 0 }
                ),
                Fail
            )
        )
    );
};


// =============================================================================
//  SAVE
//  Each save reads its staging row. An insert creates the SharePoint row first and
//  takes its ID; then the estimate is recalculated and written back.
// =============================================================================

nfIGCESaveHeader(headerID: Number): Void = {
    With(
        {
            _e:  First(colIGCEHeaderEdit),
            _id: If(
                     Coalesce(headerID, 0) = 0,
                     Patch(IGCEHeader, Defaults(IGCEHeader), { Title: First(colIGCEHeaderEdit).Title, Status: { Value: "Draft" } }).ID,
                     headerID
                 )
        },
        If(
            Coalesce(headerID, 0) = 0,
            Collect(
                colIGCEHeader,
                Patch(
                    _e,
                    {
                        ID: _id,
                        Status: { Value: "Draft" },
                        AccountablePropertyTotal: 0,
                        SubmittedBy: "",
                        SubmittedOn: Blank(),
                        Modified: Now()
                    }
                )
            ),
            Patch(colIGCEHeader, LookUp(colIGCEHeader, ID = _id), _e)
        );
        nfIGCERecalcHeader(_id);
        nfIgceSpSync(_id)
    );
};

nfIGCESaveLine(lineID: Number): Void = {
    With(
        {
            _e:  First(colIGCELineEdit),
            _id: If(
                     Coalesce(lineID, 0) = 0,
                     Patch(IGCELine, Defaults(IGCELine), { Title: First(colIGCELineEdit).Title, IGCEHeaderID: First(colIGCELineEdit).IGCEHeaderID }).ID,
                     lineID
                 )
        },
        If(
            Coalesce(lineID, 0) = 0,
            Collect(
                colIGCELine,
                Patch(
                    _e,
                    {
                        ID: _id,
                        BaseYearCost: 0, OP1Cost: 0, OP2Cost: 0, OP3Cost: 0, OP4Cost: 0,
                        AccountablePropertyTotal: 0
                    }
                )
            ),
            Patch(colIGCELine, LookUp(colIGCELine, ID = _id), _e)
        );
        nfIGCERecalcHeader(_e.IGCEHeaderID);
        nfIgceSpSync(_e.IGCEHeaderID)
    );
};

nfIGCESaveSubLine(subLineID: Number): Void = {
    With(
        {
            _e:  First(colIGCESubLineEdit),
            _id: If(
                     Coalesce(subLineID, 0) = 0,
                     Patch(IGCESubLine, Defaults(IGCESubLine), { Title: First(colIGCESubLineEdit).Title, IGCELineID: First(colIGCESubLineEdit).IGCELineID }).ID,
                     subLineID
                 )
        },
        If(
            Coalesce(subLineID, 0) = 0,
            Collect(colIGCESubLine, Patch(_e, { ID: _id })),
            Patch(colIGCESubLine, LookUp(colIGCESubLine, ID = _id), _e)
        );
        nfIGCERecalcHeader(LookUp(colIGCELine, ID = _e.IGCELineID).IGCEHeaderID);
        nfIgceSpSync(LookUp(colIGCELine, ID = _e.IGCELineID).IGCEHeaderID)
    );
};


// =============================================================================
//  DELETE
//  Children before parents, the list before the working copy. The parent ID is read
//  before the row goes.
// =============================================================================

nfIGCEDeleteSubLine(subLineID: Number): Void = {
    With(
        { _headerID: LookUp(colIGCELine, ID = LookUp(colIGCESubLine, ID = subLineID).IGCELineID).IGCEHeaderID },
        RemoveIf(IGCESubLine, ID = subLineID);
        Remove(colIGCESubLine, LookUp(colIGCESubLine, ID = subLineID));
        nfIGCERecalcHeader(_headerID);
        nfIgceSpSync(_headerID)
    );
};

nfIGCEDeleteLine(lineID: Number): Void = {
    With(
        { _headerID: LookUp(colIGCELine, ID = lineID).IGCEHeaderID },
        RemoveIf(IGCESubLine, IGCELineID = lineID);
        RemoveIf(IGCELine, ID = lineID);
        RemoveIf(colIGCESubLine, IGCELineID = lineID);
        Remove(colIGCELine, LookUp(colIGCELine, ID = lineID));
        nfIGCERecalcHeader(_headerID);
        nfIgceSpSync(_headerID)
    );
};


// =============================================================================
//  WORKFLOW
//  Status is written here and nowhere else. Each refuses from the wrong state and says
//  so in colIGCEBlockers.
// =============================================================================

nfIGCESubmit(headerID: Number): Void = {
    nfIGCEValidate(headerID);
    If(
        IsEmpty(colIGCEBlockers),
        Patch(
            colIGCEHeader,
            LookUp(colIGCEHeader, ID = headerID),
            {
                Status: { Value: "Submitted" },
                SubmittedBy: nfSignedIn.DisplayName,
                SubmittedOn: Now(),
                Modified: Now()
            }
        )
    );
    If(IsEmpty(colIGCEBlockers), nfIgceSpSync(headerID));
};

nfIGCEApprove(headerID: Number): Void = {
    Clear(colIGCEBlockers);
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        If(
            _h.Status.Value = "Submitted" || _h.Status.Value = "COR review",
            Patch(
                colIGCEHeader,
                _h,
                { Status: { Value: "Approved" }, Modified: Now() }
            ),
            Collect(
                colIGCEBlockers,
                {
                    Scope: "header", RefID: headerID, Field: "Status",
                    Message: "Only a submitted estimate can be approved. This one is " & _h.Status.Value & ".",
                    Fail: true
                }
            )
        )
    );
    If(IsEmpty(colIGCEBlockers), nfIgceSpSync(headerID));
};


// =============================================================================
//  SHAREPOINT WRITE BACK
//  Writes one estimate's header, lines and sublines after the recalculation.
//  One Patch per row, found by ID.
// =============================================================================

nfIgceSpSync(headerID: Number): Void = {
    With(
        { _h: LookUp(colIGCEHeader, ID = headerID) },
        Patch(
            IGCEHeader,
            LookUp(IGCEHeader, ID = headerID),
            {
              Title: _h.Title,
              PRID: _h.PRID,
              Revision: _h.Revision,
              PRTrackerID: { Id: _h.PRTrackerID.Id, Value: _h.PRTrackerID.Value },
              IGCEType: If(IsBlank(_h.IGCEType.Value), Blank(), { Value: _h.IGCEType.Value }),
              PointOfContact: If(IsBlank(_h.PointOfContact.Email), Blank(), { Claims: "i:0#.f|membership|" & Lower(_h.PointOfContact.Email), DisplayName: _h.PointOfContact.DisplayName, Email: _h.PointOfContact.Email, Department: Coalesce(_h.PointOfContact.Department, ""), JobTitle: Coalesce(_h.PointOfContact.JobTitle, ""), Picture: "" }),
              COR: If(IsBlank(_h.COR.Email), Blank(), { Claims: "i:0#.f|membership|" & Lower(_h.COR.Email), DisplayName: _h.COR.DisplayName, Email: _h.COR.Email, Department: Coalesce(_h.COR.Department, ""), JobTitle: Coalesce(_h.COR.JobTitle, ""), Picture: "" }),
              BasePeriodStart: _h.BasePeriodStart,
              BasePeriodEnd: _h.BasePeriodEnd,
              OptionPeriods: _h.OptionPeriods,
              OptionPeriod1Start: If(_h.OptionPeriods >= 1, DateAdd(_h.BasePeriodStart, 1, TimeUnit.Years), Blank()),
              OptionPeriod1End: If(_h.OptionPeriods >= 1, DateAdd(_h.BasePeriodEnd, 1, TimeUnit.Years), Blank()),
              OptionPeriod2Start: If(_h.OptionPeriods >= 2, DateAdd(_h.BasePeriodStart, 2, TimeUnit.Years), Blank()),
              OptionPeriod2End: If(_h.OptionPeriods >= 2, DateAdd(_h.BasePeriodEnd, 2, TimeUnit.Years), Blank()),
              OptionPeriod3Start: If(_h.OptionPeriods >= 3, DateAdd(_h.BasePeriodStart, 3, TimeUnit.Years), Blank()),
              OptionPeriod3End: If(_h.OptionPeriods >= 3, DateAdd(_h.BasePeriodEnd, 3, TimeUnit.Years), Blank()),
              OptionPeriod4Start: If(_h.OptionPeriods >= 4, DateAdd(_h.BasePeriodStart, 4, TimeUnit.Years), Blank()),
              OptionPeriod4End: If(_h.OptionPeriods >= 4, DateAdd(_h.BasePeriodEnd, 4, TimeUnit.Years), Blank()),
              Status: { Value: _h.Status.Value },
              InflationRate: Round(Coalesce(_h.InflationRate, 0) / 100, 8),
              FringeRate: Round(Coalesce(_h.FringeRate, 0) / 100, 8),
              OverheadRate: Round(Coalesce(_h.OverheadRate, 0) / 100, 8),
