Screens:
  scrQueue:
    Properties:
      Fill: =nfColor.Page
      OnVisible: |-
        =UpdateContext({ locLoading: true });
        Reset(txtQueSearch);
        Reset(drpQueView);
        UpdateContext({ locSortBy: "Created", locSortDesc: false });
        UpdateContext({ locLoading: false })
    Children:
      - conQueRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmpQueHeader:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: ="queue"
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  IsStaff: =gblIsStaff
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Links: =nfHeaderLinks
                  Logo: =nfLogo
                  LogoWidth: =nfApp.LogoWidth
                  OnLinkSelect: =Launch(Self.SelectedUrl)
                  OnNavSelect: =nfGo(Self.SelectedKey)
                  Theme: =nfColor
                  Title: =nfApp.Name
                  UserImage: =User().Image
                  WelcomeName: =nfUserName
            - conQueHeaderRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - conQueBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingTop: =nfSpace.Xl
                Children:
                  - conQueHead:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =54
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conQueTitleText:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              Height: =54
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - lblQueTitle:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.H1
                                    Text: =nfNavLabel("queue")
                                    Wrap: =false
                              - lblQueSub:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Body
                                    Text: ="Open " & nfItems & " for the " & nfApp.Team & ", oldest first."
                                    Wrap: =false
                  - conQueTools:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =If(nfIsPhone, 2 * nfSize.Control + nfSpace.Sm, nfSize.Control)
                        LayoutDirection: =If(nfIsPhone, LayoutDirection.Vertical, LayoutDirection.Horizontal)
                        LayoutGap: =nfSpace.Sm
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =gblIsStaff
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - txtQueSearch:
                            Control: ModernTextInput@1.1.2
                            Properties:
                              AccessibleLabel: ="Search the queue"
                              AlignInContainer: =AlignInContainer.Stretch
                              Appearance: =Appearance.Outline
                              FillPortions: =If(nfIsPhone, 0, 1)
                              Height: =nfSize.Control
                              LayoutMinWidth: =0
                              Placeholder: ="Search by title or asset tag"
                              Size: =nfType.Input
                        - drpQueView:
                            Control: ModernDropdown@1.0.3
                            Properties:
                              AccessibleLabel: ="Show which part of the queue"
                              AlignInContainer: =AlignInContainer.Stretch
                              Appearance: =Appearance.Outline
                              Default: =LookUp(nfNavQueue, Key = Coalesce(locView, "queue-unassigned"))
                              Height: =nfSize.Control
                              ItemDisplayText: =ThisItem.Label & If(ThisItem.Count > 0, " (" & ThisItem.Count & ")", "")
                              Items: =nfNavQueue
                              LayoutMinWidth: =0
                              Size: =nfType.Input
                              Width: =220
                  - conQueTable:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Visible: =gblIsStaff
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conQueTableHead:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Sunk
                              FillPortions: =0
                              Height: =40
                              LayoutAlignItems: =LayoutAlignItems.Center
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Md
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              PaddingLeft: =nfSpace.Lg
                              PaddingRight: =nfSpace.Lg
                              RadiusTopLeft: =nfRadius.Md
                              RadiusTopRight: =nfRadius.Md
                              Visible: =!nfIsPhone
                            Children:
                              - conQueHItem:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    Height: =32
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblQueHItem:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =If(locSortBy = "Title", nfColor.Primary, nfColor.Ink2)
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper(nfItemCap) & If(locSortBy = "Title", If(locSortDesc, "  ↓", "  ↑"), "  ↕")
                                          Width: =Parent.Width
                                          Wrap: =false
                                          Y: =8
                                    - btnQueHItem:
                                        Control: Classic/Button@2.2.0
                                        Properties:
                                          BorderStyle: =BorderStyle.None
                                          BorderThickness: =0
                                          Fill: =nfColor.Transparent
                                          FocusedBorderThickness: =2
                                          Height: =Parent.Height
                                          HoverBorderColor: =nfColor.Transparent
                                          HoverFill: =nfColor.Hover
                                          OnSelect: |-
                                            =UpdateContext(
                                                If(
                                                    !(locSortBy = "Title"), { locSortBy: "Title", locSortDesc: false },
                                                    !locSortDesc, { locSortBy: "Title", locSortDesc: true },
                                                    { locSortBy: "Created", locSortDesc: false }
                                                )
                                            )
                                          PressedBorderColor: =nfColor.Transparent
                                          PressedFill: =nfColor.Pressed
                                          RadiusBottomLeft: =0
                                          RadiusBottomRight: =0
                                          RadiusTopLeft: =0
                                          RadiusTopRight: =0
                                          Text: =""
                                          Tooltip: ="Sort by " & Lower(nfItemCap) & If(locSortBy = "Title", If(locSortDesc, ", now descending", ", now ascending"), ", not sorted")
                                          Width: =Parent.Width
                              - lblQueHRequester:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: =Upper("Requester")
                                    Width: =180
                                    Wrap: =false
                              - lblQueHDivision:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: =Upper("Division")
                                    Visible: =nfIsDesktop
                                    Width: =160
                                    Wrap: =false
                              - conQueHWaitingsince:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    FillPortions: =0
                                    Height: =32
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    Visible: =nfIsDesktop
                                    Width: =120
                                  Children:
                                    - lblQueHWaitingsince:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =If(locSortBy = "Created", nfColor.Primary, nfColor.Ink2)
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper("Waiting since") & If(locSortBy = "Created", If(locSortDesc, "  ↓", "  ↑"), "  ↕")
                                          Width: =Parent.Width
                                          Wrap: =false
                                          Y: =8
                                    - btnQueHWaitingsince:
                                        Control: Classic/Button@2.2.0
                                        Properties:
                                          BorderStyle: =BorderStyle.None
                                          BorderThickness: =0
                                          Fill: =nfColor.Transparent
                                          FocusedBorderThickness: =2
                                          Height: =Parent.Height
                                          HoverBorderColor: =nfColor.Transparent
                                          HoverFill: =nfColor.Hover
                                          OnSelect: |-
                                            =UpdateContext({ locSortBy: "Created", locSortDesc: !locSortDesc })
                                          PressedBorderColor: =nfColor.Transparent
                                          PressedFill: =nfColor.Pressed
                                          RadiusBottomLeft: =0
                                          RadiusBottomRight: =0
                                          RadiusTopLeft: =0
                                          RadiusTopRight: =0
                                          Text: =""
                                          Tooltip: ="Sort by " & Lower("Waiting since") & If(locSortBy = "Created", If(locSortDesc, ", now descending", ", now ascending"), ", not sorted")
                                          Width: =Parent.Width
                              - lblQueHStatus:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: =Upper("Status")
                                    Width: =nfSize.Pill
                                    Wrap: =false
                              - lblQueHGo:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: =Upper("")
                                    Width: =16
                                    Wrap: =false
                        - galQueRows:
                            Control: Gallery@2.15.0
                            Variant: Vertical
                            Properties:
                              AccessibleLabel: =nfNavLabel("queue")
                              Items: |-
                                =// Filter and sort both run on the data source. Keep them delegable: see docs/delegation.md.
                                SortByColumns(
                                    Filter(
                                        colRequests,
                                        IsOpen = true,
                                        drpQueView.Selected.Key <> "queue-unassigned" || AssignedTo = Blank(),
                                        drpQueView.Selected.Key <> "queue-mine" || AssignedTo = nfUserEmail,
                                        IsBlank(txtQueSearch.Text) || StartsWith(Title, txtQueSearch.Text) || StartsWith(AssetTag, txtQueSearch.Text)
                                    ),
                                    Coalesce(locSortBy, "Created"),
                                    If(locSortDesc, SortOrder.Descending, SortOrder.Ascending)
                                )
                              TemplatePadding: =0
                              TemplateSize: =nfSize.Row
                              Visible: |-
                                =!nfIsPhone && !IsEmpty(Filter(
                                        colRequests,
                                        IsOpen = true,
                                        drpQueView.Selected.Key <> "queue-unassigned" || AssignedTo = Blank(),
                                        drpQueView.Selected.Key <> "queue-mine" || AssignedTo = nfUserEmail,
                                        IsBlank(txtQueSearch.Text) || StartsWith(Title, txtQueSearch.Text) || StartsWith(AssetTag, txtQueSearch.Text)
                                    ))
                            Children:
                              - conQueRow:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    Height: =Parent.TemplateHeight - 1
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutGap: =nfSpace.Md
                                    PaddingLeft: =nfSpace.Lg
                                    PaddingRight: =nfSpace.Lg
                                    Width: =Parent.TemplateWidth
                                  Children:
                                    - lblQueCTitle:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          FillPortions: =1
                                          FontWeight: =FontWeight.Semibold
                                          LayoutMinWidth: =0
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =ThisItem.Title
                                          Wrap: =false
                                    - lblQueCRequester:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Ink2
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =ThisItem.RequesterName
                                          Width: =180
                                          Wrap: =false
                                    - lblQueCDivision:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Ink2
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =ThisItem.DivisionMEO.Value
                                          Visible: =nfIsDesktop
                                          Width: =160
                                          Wrap: =false
                                    - lblQueCSince:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Ink2
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Text(ThisItem.Created, "mmm d, yyyy")
                                          Visible: =nfIsDesktop
                                          Width: =120
                                          Wrap: =false
                                    - conQuePill:
                                        Control: GroupContainer@1.5.0
                                        Variant: ManualLayout
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          DropShadow: =DropShadow.None
                                          Fill: =nfColor.Transparent
                                          FillPortions: =0
                                          Height: =24
                                          LayoutMinHeight: =0
                                          LayoutMinWidth: =0
                                          Width: =nfSize.Pill
                                        Children:
                                          - conQuePillShape:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                Fill: =LookUp(nfTone, Tone = nfStatusTone(ThisItem.Status)).Fill
                                                Height: =24
                                                RadiusBottomLeft: =12
                                                RadiusBottomRight: =12
                                                RadiusTopLeft: =12
                                                RadiusTopRight: =12
                                                Width: =Min(Parent.Width, Len(nfStatusLabel(ThisItem.Status)) * 7 + 24)
                                              Children:
                                                - lblQuePill:
                                                    Control: ModernText@1.0.0
                                                    Properties:
                                                      Align: =Align.Center
                                                      AutoHeight: =true
                                                      Color: =LookUp(nfTone, Tone = nfStatusTone(ThisItem.Status)).Ink
                                                      FontWeight: =FontWeight.Semibold
                                                      PaddingBottom: =0
                                                      PaddingLeft: =8
                                                      PaddingRight: =8
                                                      PaddingTop: =0
                                                      Size: =nfType.Small
                                                      Text: =nfStatusLabel(ThisItem.Status)
                                                      Width: =Parent.Width
                                                      Wrap: =false
                                                      Y: =(Parent.Height - Self.Height) / 2
                                    - imgQueGo:
                                        Control: Image@2.2.3
                                        Properties:
                                          Height: =16
                                          Image: ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5A5B5D' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6'/></svg>")
                                          Width: =16
                              - conQueRowRule:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Line
                                    Height: =1
                                    Width: =Parent.TemplateWidth
                                    Y: =Parent.TemplateHeight - 1
                              - btnQueRowOpen:
                                  Control: Classic/Button@2.2.0
                                  Properties:
                                    BorderStyle: =BorderStyle.None
                                    BorderThickness: =0
                                    Fill: =nfColor.Transparent
                                    FocusedBorderThickness: =2
                                    Height: =Parent.TemplateHeight - 1
                                    HoverBorderColor: =nfColor.Transparent
                                    HoverFill: =nfColor.Hover
                                    OnSelect: |-
                                      =Navigate(scrDetail, ScreenTransition.None, { locId: ThisItem.ID, locFrom: "queue" })
                                    PressedBorderColor: =nfColor.Transparent
                                    PressedFill: =nfColor.Pressed
                                    RadiusBottomLeft: =0
                                    RadiusBottomRight: =0
                                    RadiusTopLeft: =0
                                    RadiusTopRight: =0
                                    Text: =""
                                    Tooltip: ="Open " & ThisItem.Title
                                    Width: =Parent.TemplateWidth
                        - galQueCards:
                            Control: Gallery@2.15.0
                            Variant: Vertical
                            Properties:
                              AccessibleLabel: =nfNavLabel("queue")
                              Items: |-
                                =// Filter and sort both run on the data source. Keep them delegable: see docs/delegation.md.
                                SortByColumns(
                                    Filter(
                                        colRequests,
                                        IsOpen = true,
                                        drpQueView.Selected.Key <> "queue-unassigned" || AssignedTo = Blank(),
                                        drpQueView.Selected.Key <> "queue-mine" || AssignedTo = nfUserEmail,
                                        IsBlank(txtQueSearch.Text) || StartsWith(Title, txtQueSearch.Text) || StartsWith(AssetTag, txtQueSearch.Text)
                                    ),
                                    Coalesce(locSortBy, "Created"),
                                    If(locSortDesc, SortOrder.Descending, SortOrder.Ascending)
                                )
                              TemplatePadding: =0
                              TemplateSize: =nfSize.CardRow
                              Visible: |-
                                =nfIsPhone && !IsEmpty(Filter(
                                        colRequests,
                                        IsOpen = true,
                                        drpQueView.Selected.Key <> "queue-unassigned" || AssignedTo = Blank(),
                                        drpQueView.Selected.Key <> "queue-mine" || AssignedTo = nfUserEmail,
                                        IsBlank(txtQueSearch.Text) || StartsWith(Title, txtQueSearch.Text) || StartsWith(AssetTag, txtQueSearch.Text)
                                    ))
                            Children:
                              - conQueCard:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    Height: =Parent.TemplateHeight - 1
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutGap: =nfSpace.Md
                                    PaddingLeft: =nfSpace.Lg
                                    PaddingRight: =nfSpace.Lg
                                    Width: =Parent.TemplateWidth
                                  Children:
                                    - conQueCardText:
                                        Control: GroupContainer@1.5.0
                                        Variant: AutoLayout
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          DropShadow: =DropShadow.None
                                          Fill: =nfColor.Transparent
                                          Height: =60
                                          LayoutDirection: =LayoutDirection.Vertical
                                          LayoutGap: =2
                                          LayoutJustifyContent: =LayoutJustifyContent.Center
                                          LayoutMinHeight: =0
                                          LayoutMinWidth: =0
                                        Children:
                                          - lblQueCardTitle:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Stretch
                                                AutoHeight: =true
                                                Color: =nfColor.Ink
                                                FontWeight: =FontWeight.Semibold
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =ThisItem.Title
                                                Wrap: =false
                                          - lblQueCardMeta:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Stretch
                                                AutoHeight: =true
                                                Color: =nfColor.Ink2
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Small
                                                Text: =ThisItem.RequesterName & " · " & Text(ThisItem.Created, "mmm d")
                                                Wrap: =false
                                          - conQueCardPill:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Start
                                                DropShadow: =DropShadow.None
                                                Fill: =nfColor.Transparent
                                                FillPortions: =0
                                                Height: =24
                                                LayoutMinHeight: =0
                                                LayoutMinWidth: =0
                                                Width: =nfSize.Pill
                                              Children:
                                                - conQueCardPillShape:
                                                    Control: GroupContainer@1.5.0
                                                    Variant: ManualLayout
                                                    Properties:
                                                      DropShadow: =DropShadow.None
                                                      Fill: =LookUp(nfTone, Tone = nfStatusTone(ThisItem.Status)).Fill
                                                      Height: =24
                                                      RadiusBottomLeft: =12
                                                      RadiusBottomRight: =12
                                                      RadiusTopLeft: =12
                                                      RadiusTopRight: =12
                                                      Width: =Min(Parent.Width, Len(nfStatusLabel(ThisItem.Status)) * 7 + 24)
                                                    Children:
                                                      - lblQueCardPill:
                                                          Control: ModernText@1.0.0
                                                          Properties:
                                                            Align: =Align.Center
                                                            AutoHeight: =true
                                                            Color: =LookUp(nfTone, Tone = nfStatusTone(ThisItem.Status)).Ink
                                                            FontWeight: =FontWeight.Semibold
                                                            PaddingBottom: =0
                                                            PaddingLeft: =8
                                                            PaddingRight: =8
                                                            PaddingTop: =0
                                                            Size: =nfType.Small
                                                            Text: =nfStatusLabel(ThisItem.Status)
                                                            Width: =Parent.Width
                                                            Wrap: =false
                                                            Y: =(Parent.Height - Self.Height) / 2
                                    - imgQueCardGo:
                                        Control: Image@2.2.3
                                        Properties:
                                          Height: =16
                                          Image: ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5A5B5D' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6'/></svg>")
                                          Width: =16
                              - conQueCardRule:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Line
                                    Height: =1
                                    Width: =Parent.TemplateWidth
                                    Y: =Parent.TemplateHeight - 1
                              - btnQueCardOpen:
                                  Control: Classic/Button@2.2.0
                                  Properties:
                                    BorderStyle: =BorderStyle.None
                                    BorderThickness: =0
                                    Fill: =nfColor.Transparent
                                    FocusedBorderThickness: =2
                                    Height: =Parent.TemplateHeight - 1
                                    HoverBorderColor: =nfColor.Transparent
                                    HoverFill: =nfColor.Hover
                                    OnSelect: |-
                                      =Navigate(scrDetail, ScreenTransition.None, { locId: ThisItem.ID, locFrom: "queue" })
                                    PressedBorderColor: =nfColor.Transparent
                                    PressedFill: =nfColor.Pressed
                                    RadiusBottomLeft: =0
                                    RadiusBottomRight: =0
                                    RadiusTopLeft: =0
                                    RadiusTopRight: =0
                                    Text: =""
                                    Tooltip: ="Open " & ThisItem.Title
                                    Width: =Parent.TemplateWidth
                        - cmpQueEmpty:
                            Control: CanvasComponent
                            ComponentName: cmpStatePanel
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              FillPortions: =1
                              IsPhone: =nfIsPhone
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Message: =If(IsBlank(txtQueSearch.Text), "Choose another view to see more.", "Clear the search, or choose another view.")
                              OnPrimary: =Reset(txtQueSearch)
                              OnSecondary: =false
                              PrimaryText: =If(IsBlank(txtQueSearch.Text), "", "Clear search")
                              SecondaryText: =
                              Theme: =nfColor
                              Title: ="Nothing waiting here"
                              Variant: ="Empty"
                              Visible: |-
                                =IsEmpty(Filter(
                                        colRequests,
                                        IsOpen = true,
                                        drpQueView.Selected.Key <> "queue-unassigned" || AssignedTo = Blank(),
                                        drpQueView.Selected.Key <> "queue-mine" || AssignedTo = nfUserEmail,
                                        IsBlank(txtQueSearch.Text) || StartsWith(Title, txtQueSearch.Text) || StartsWith(AssetTag, txtQueSearch.Text)
                                    ))
                  - conQueDenied:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        FillPortions: =0
                        Height: =If(nfIsPhone, 280, 220)
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Visible: =!gblIsStaff
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - cmpQueNoAccess:
                            Control: CanvasComponent
                            ComponentName: cmpStatePanel
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              FillPortions: =1
                              IsPhone: =nfIsPhone
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Message: ="The queue is for " & nfApp.Team & " staff. If you need access, email " & nfApp.ContactEmail & "."
                              OnPrimary: =Launch("mailto:" & nfApp.ContactEmail)
                              OnSecondary: =nfGo("overview")
                              PrimaryText: ="Email us"
                              SecondaryText: ="Go to " & nfNavLabel("overview")
                              Theme: =nfColor
                              Title: ="You do not have access to the queue"
                              Variant: ="NoAccess"
            - conQueBottomRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Visible: =nfIsPhone
            - conQueBottomBar:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
                  FillPortions: =0
                  Height: =nfSize.BottomNav
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingLeft: =nfSpace.Sm
                  PaddingRight: =nfSpace.Sm
                  Visible: =nfIsPhone
                Children:
                  - cmpQueBottomNav:
                      Control: CanvasComponent
                      ComponentName: cmpBottomNav
                      Properties:
                        ActiveKey: ="queue"
                        AlignInContainer: =AlignInContainer.Stretch
                        FillPortions: =1
                        IsStaff: =gblIsStaff
                        Items: =nfNavMain
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        OnSelect: =nfGo(Self.SelectedKey)
                        Theme: =nfColor
      - conQueLoading:
          Control: GroupContainer@1.5.0
          Variant: ManualLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Scrim
            Height: =Parent.Height
            Visible: =locLoading
            Width: =Parent.Width
          Children:
            - conQueLoadingCard:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
                  Height: =56
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutJustifyContent: =LayoutJustifyContent.Center
                  RadiusBottomLeft: =nfRadius.Md
                  RadiusBottomRight: =nfRadius.Md
                  RadiusTopLeft: =nfRadius.Md
                  RadiusTopRight: =nfRadius.Md
                  Width: =200
                  X: =(Parent.Width - Self.Width) / 2
                  Y: =(Parent.Height - Self.Height) / 2
                Children:
                  - lblQueLoading:
                      Control: ModernText@1.0.0
                      Properties:
                        Align: =Align.Center
                        AutoHeight: =true
                        Color: =nfColor.Ink
                        FontWeight: =FontWeight.Semibold
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.Body
                        Text: ="Loading..."
                        Width: =120
