Screens:
  scr_IGCEOverview:
    Properties:
      Fill: =nfColor.Page
      OnVisible: |-
        =If(
            gl_IGCE.Status.Value = "Complete",
            UpdateContext({ct_Reminder: true}),
            UpdateContext({ct_Reminder: false})
        )
    Children:
      - con_Shell_Overview:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmp_Header_Overview:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: =""
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  IsStaff: =false
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Links: =nfHeaderLinks
                  Logo: =nfLogo
                  LogoWidth: =nfApp.LogoWidth
                  OnLinkSelect: =If(Self.SelectedUrl = "app:help", Navigate(scr_Help, ScreenTransition.Fade), Launch(Self.SelectedUrl))
                  OnNavSelect: =false
                  Theme: =nfColor
                  Title: |-
                    =If(
                        IsBlank(gl_IGCE.ID),
                        "PR: " & gl_PRTracker & " | New IGCE",
                        "PR: " & gl_PRTracker & " | IGCE: " & gl_IGCE.ID
                    ) & If(IsBlank(gl_IGCE.ID), "", " · " & gl_IGCE.Status.Value)
                  UserImage: =User().Image
                  WelcomeName: =nf_User.DisplayName
            - con_ActionBar_Overview:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
                  FillPortions: =0
                  Height: =nfSize.Control + 2 * nfSpace.Sm
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =nfSpace.Sm
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                Children:
                  - btn_TopBack_Overview:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Back"
                        Appearance: =ButtonAppearance.Subtle
                        Height: =nfSize.Control
                        Icon: ="ArrowLeft"
                        Layout: =If(nfIsPhone, ButtonLayout.IconOnly, ButtonLayout.IconBefore)
                        OnSelect: |-
                          =Set(
                              gl_FormMode,
                              FormMode.View
                          );
                          Navigate(scr_PRList)// Change Nav to PR app later
                        Size: =nfType.Body
                        Text: ="Back"
                        Tooltip: ="Back"
                        Width: =If(nfIsPhone, nfSize.Control, 90)
                  - con_ActionGap_Overview:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        Height: =1
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                  - btn_TopReport_Overview:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Report"
                        Appearance: =ButtonAppearance.Secondary
                        Height: =nfSize.Control
                        Icon: ="Open"
                        Layout: =If(nfIsPhone, ButtonLayout.IconOnly, ButtonLayout.IconBefore)
                        OnSelect: =Launch(Concatenate(nf_PowerBIURL,gl_PRID))
                        Size: =nfType.Body
                        Text: ="Report"
                        Tooltip: ="Report"
                        Visible: =!IsBlank(gl_IGCE.ID)
                        Width: =If(nfIsPhone, nfSize.Control, 100)
                  - btn_View:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Stop editing"
                        Appearance: =ButtonAppearance.Secondary
                        Height: =nfSize.Control
                        Icon: ="Dismiss"
                        Layout: =If(nfIsPhone, ButtonLayout.IconOnly, ButtonLayout.IconBefore)
                        OnSelect: =Set(gl_FormMode,FormMode.View)
                        Size: =nfType.Body
                        Text: ="Stop editing"
                        Tooltip: ="Stop editing"
                        Visible: =gl_FormMode = FormMode.Edit
                        Width: =If(nfIsPhone, nfSize.Control, 130)
                  - btn_TopEdit_Overview:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Edit"
                        Height: =nfSize.Control
                        Icon: ="Edit"
                        OnSelect: =Set(gl_FormMode,FormMode.Edit)
                        Size: =nfType.Body
                        Text: ="Edit"
                        Tooltip: ="Edit"
                        Visible: =gl_FormMode = FormMode.View && gl_IGCE.Status.Value <> "Complete"
                        Width: =90
                  - btn_TopSave_Overview:
                      Control: ModernButton@1.0.0
