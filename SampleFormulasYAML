Screens:
  scrDetail:
    Properties:
      Fill: =nfColor.Page
      OnVisible: |-
        =UpdateContext({ locLoading: true });
        UpdateContext({ locItem: LookUp(colRequests, ID = locId), locConfirm: Blank() });
        UpdateContext({ locLoading: false })
    Children:
      - conDtlRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmpDtlHeader:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: =If(locFrom = "queue", "queue", "list")
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  IsStaff: =gblIsStaff
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Links: =nfHeaderLinks
                  Logo: =nfLogo
                  LogoWidth: =nfApp.LogoWidth
                  OnLinkSelect: =Launch(Self.SelectedUrl)
                  OnNavSelect: =nfGo(Self.SelectedKey)
                  Theme: =nfColor
                  Title: =nfApp.Name
                  UserImage: =User().Image
                  WelcomeName: =nfUserName
            - conDtlHeaderRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - conDtlBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  LayoutOverflowY: =LayoutOverflow.Scroll
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingTop: =nfSpace.Xl
                Children:
                  - conDtlCrumb:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =nfSize.Control
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - btnDtlBack:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Back to " & nfNavLabel(If(locFrom = "queue", "queue", "list"))
                              Appearance: =ButtonAppearance.Transparent
                              Color: =nfColor.Primary
                              Height: =nfSize.Control
                              Icon: ="ArrowLeft"
                              OnSelect: |-
                                =If(locFrom = "queue", Navigate(scrQueue, ScreenTransition.None), Navigate(scrList, ScreenTransition.None, { locStatusFilter: "all" }))
                              Size: =nfType.Body
                              Text: =nfNavLabel(If(locFrom = "queue", "queue", "list"))
                              Width: =150
                  - conDtlMissing:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        FillPortions: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Visible: =IsBlank(locItem)
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - cmpDtlNotFound:
                            Control: CanvasComponent
                            ComponentName: cmpStatePanel
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              FillPortions: =1
                              IsPhone: =nfIsPhone
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Message: =
                              OnPrimary: |-
                                =If(locFrom = "queue", Navigate(scrQueue, ScreenTransition.None), Navigate(scrList, ScreenTransition.None, { locStatusFilter: "all" }))
                              OnSecondary: =false
                              PrimaryText: ="Back to " & nfNavLabel(If(locFrom = "queue", "queue", "list"))
                              SecondaryText: =
                              Theme: =nfColor
                              Title: =nfItemCap & " not found"
                              Variant: ="NotFound"
                  - conDtlHead:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =54
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =!IsBlank(locItem)
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conDtlTitleText:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              Height: =54
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - lblDtlTitle:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.H1
                                    Text: =locItem.Title
                                    Wrap: =false
                              - lblDtlSub:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Body
                                    Text: =nfItemCap & " " & locItem.ID & " · Submitted by " & locItem.RequesterName
                                    Wrap: =false
                        - conDtlPill:
                            Control: GroupContainer@1.5.0
                            Variant: ManualLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              FillPortions: =0
                              Height: =24
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Width: =nfSize.Pill
                            Children:
                              - conDtlPillShape:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =LookUp(nfTone, Tone = nfStatusTone(locItem.Status)).Fill
                                    Height: =24
                                    RadiusBottomLeft: =12
                                    RadiusBottomRight: =12
                                    RadiusTopLeft: =12
                                    RadiusTopRight: =12
                                    Width: =Min(Parent.Width, Len(nfStatusLabel(locItem.Status)) * 7 + 24)
                                  Children:
                                    - lblDtlPill:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Align: =Align.Center
                                          AutoHeight: =true
                                          Color: =LookUp(nfTone, Tone = nfStatusTone(locItem.Status)).Ink
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =8
                                          PaddingRight: =8
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =nfStatusLabel(locItem.Status)
                                          Width: =Parent.Width
                                          Wrap: =false
                                          Y: =(Parent.Height - Self.Height) / 2
                  - conDtlActions:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =nfSize.Control + nfSpace.Sm
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Sm
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        LayoutOverflowX: =LayoutOverflow.Scroll
                        Visible: =!IsBlank(locItem)
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - btnDtlEdit:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Edit"
                              Appearance: =ButtonAppearance.Secondary
                              Height: =nfSize.Control
                              Icon: ="Edit"
                              OnSelect: |-
                                =If(
                                    nfApp.StepForm,
                                    Navigate(scrFormSteps, ScreenTransition.None, { locId: locId }),
                                    Navigate(scrForm, ScreenTransition.None, { locId: locId })
                                )
                              Size: =nfType.Body
                              Text: ="Edit"
                              Visible: =locItem.RequesterEmail = nfUserEmail && LookUp(nfStatus, Key = locItem.Status).Editable
                        - btnDtlAssign:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Assign to me"
                              Appearance: =ButtonAppearance.Secondary
                              BasePaletteColor: =nfColor.Primary
                              Height: =nfSize.Control
                              OnSelect: |-
                                =UpdateContext({ locConfirm: { Action: "assign", Title: "Assign this " & nfItem & " to you?", Message: "You will be shown as the person working on it.", Label: "Assign to me", Danger: false } })
                              Size: =nfType.Body
                              Text: ="Assign to me"
                              Visible: =gblIsStaff && locItem.IsOpen && IsBlank(locItem.AssignedTo)
                              Width: =Len("Assign to me") * 8 + 40
                        - btnDtlStart:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Start work"
                              BasePaletteColor: =nfColor.Primary
                              Height: =nfSize.Control
                              OnSelect: |-
                                =UpdateContext({ locConfirm: { Action: "start", Title: "Start work on this " & nfItem & "?", Message: "It will show as In progress.", Label: "Start work", Danger: false } })
                              Size: =nfType.Body
                              Text: ="Start work"
                              Visible: =gblIsStaff && locItem.Status = "Submitted"
                              Width: =Len("Start work") * 8 + 40
                        - btnDtlHold:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Put on hold"
                              Appearance: =ButtonAppearance.Secondary
                              BasePaletteColor: =nfColor.Primary
                              Height: =nfSize.Control
                              OnSelect: |-
                                =UpdateContext({ locConfirm: { Action: "hold", Title: "Put this " & nfItem & " on hold?", Message: "Use this while you wait on someone else.", Label: "Put on hold", Danger: false } })
                              Size: =nfType.Body
                              Text: ="Put on hold"
                              Visible: =gblIsStaff && locItem.Status = "InProgress"
                              Width: =Len("Put on hold") * 8 + 40
                        - btnDtlResume:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Resume"
                              BasePaletteColor: =nfColor.Primary
                              Height: =nfSize.Control
                              OnSelect: |-
                                =UpdateContext({ locConfirm: { Action: "resume", Title: "Resume work on this " & nfItem & "?", Message: "It goes back to In progress.", Label: "Resume", Danger: false } })
                              Size: =nfType.Body
                              Text: ="Resume"
                              Visible: =gblIsStaff && locItem.Status = "OnHold"
                              Width: =Len("Resume") * 8 + 40
                        - btnDtlComplete:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Complete"
                              BasePaletteColor: =nfColor.Primary
                              Height: =nfSize.Control
                              OnSelect: |-
                                =UpdateContext({ locConfirm: { Action: "complete", Title: "Mark this " & nfItem & " as completed?", Message: "It closes, and the requester sees that it is done.", Label: "Complete", Danger: false } })
                              Size: =nfType.Body
                              Text: ="Complete"
                              Visible: =gblIsStaff && locItem.Status = "InProgress"
                              Width: =Len("Complete") * 8 + 40
                        - btnDtlCancelItem:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Cancel " & nfItem
                              Appearance: =ButtonAppearance.Secondary
                              BasePaletteColor: =nfColor.Danger
                              Height: =nfSize.Control
                              OnSelect: |-
                                =UpdateContext({ locConfirm: { Action: "cancel", Title: "Cancel this " & nfItem & "?", Message: "This cannot be undone.", Label: "Cancel " & nfItem, Danger: true } })
                              Size: =nfType.Body
                              Text: ="Cancel " & nfItem
                              Visible: =(locItem.RequesterEmail = nfUserEmail && locItem.Status = "Submitted") || (gblIsStaff && locItem.IsOpen)
                              Width: =Len("Cancel " & nfItem) * 8 + 40
                  - conDtlDetails:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        FillPortions: =0
                        Height: =3 * If(nfIsDesktop, nfSize.DetailField, 3 * nfSize.DetailField + 2 * nfSpace.Lg) + 2 * nfSpace.Lg + 2 * nfSpace.Xl
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Lg
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        PaddingBottom: =nfSpace.Xl
                        PaddingLeft: =nfSpace.Xl
                        PaddingRight: =nfSpace.Xl
                        PaddingTop: =nfSpace.Xl
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Visible: =!IsBlank(locItem)
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conDtlGridRow1:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              FillPortions: =0
                              Height: =If(nfIsDesktop, nfSize.DetailField, 3 * nfSize.DetailField + 2 * nfSpace.Lg)
                              LayoutDirection: =If(nfIsDesktop, LayoutDirection.Horizontal, LayoutDirection.Vertical)
                              LayoutGap: =nfSpace.Lg
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - conDtlFRequester:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblDtlFRequesterL:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink3
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="REQUESTER"
                                          Wrap: =false
                                    - lblDtlFRequesterV:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =locItem.RequesterName
                                          Wrap: =false
                              - conDtlFDivisionorMEO:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblDtlFDivisionorMEOL:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink3
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="DIVISION OR MEO"
                                          Wrap: =false
                                    - lblDtlFDivisionorMEOV:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =locItem.DivisionMEO.Value
                                          Wrap: =false
                              - conDtlFLocation:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblDtlFLocationL:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink3
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="LOCATION"
                                          Wrap: =false
                                    - lblDtlFLocationV:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Coalesce(locItem.Location.Value, "Not set")
                                          Wrap: =false
                        - conDtlGridRow2:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              FillPortions: =0
                              Height: =If(nfIsDesktop, nfSize.DetailField, 3 * nfSize.DetailField + 2 * nfSpace.Lg)
                              LayoutDirection: =If(nfIsDesktop, LayoutDirection.Horizontal, LayoutDirection.Vertical)
                              LayoutGap: =nfSpace.Lg
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - conDtlFService:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblDtlFServiceL:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink3
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="SERVICE"
                                          Wrap: =false
                                    - lblDtlFServiceV:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =nfServiceTitle(locItem.ServiceKey)
                                          Wrap: =false
                              - conDtlFAssettag:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblDtlFAssettagL:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink3
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="ASSET TAG"
                                          Wrap: =false
                                    - lblDtlFAssettagV:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Coalesce(locItem.AssetTag, "Not set")
                                          Wrap: =false
                              - conDtlFAssignedto:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblDtlFAssignedtoL:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink3
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="ASSIGNED TO"
                                          Wrap: =false
                                    - lblDtlFAssignedtoV:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Coalesce(locItem.AssignedTo, "Unassigned")
                                          Wrap: =false
                        - conDtlGridRow3:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              FillPortions: =0
                              Height: =If(nfIsDesktop, nfSize.DetailField, 3 * nfSize.DetailField + 2 * nfSpace.Lg)
                              LayoutDirection: =If(nfIsDesktop, LayoutDirection.Horizontal, LayoutDirection.Vertical)
                              LayoutGap: =nfSpace.Lg
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - conDtlFExternalreference:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblDtlFExternalreferenceL:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink3
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="EXTERNAL REFERENCE"
                                          Wrap: =false
                                    - lblDtlFExternalreferenceV:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Coalesce(locItem.ExternalRef, "Not set")
                                          Wrap: =false
                              - conDtlFSubmitted:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                  Children:
                                    - lblDtlFSubmittedL:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AutoHeight: =true
                                          Color: =nfColor.Ink3
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
