// =============================================================================
//  START UP
//  Loads the estimates from SharePoint into working copies. Screens and the
//  calculation chain read these; every save writes back through nfIgceSpSync.
//  Reference data (choices, settings, tracker, people) is in named formulas.
//
//  Column names differ in three places, mapped here and in nfIgceSpSync only:
//      IGCEHeader.GAndARate      colIGCEHeader.GARate
//      IGCESubLine.CLIN          colIGCESubLine.Ref
//      RequirementTracker.Title  nfIgceTracker.RequirementName
//  Rates are fractions in SharePoint (0.32) and whole numbers here (32).
//
//  Delegation: each list is read in full, up to the data row limit (2000).
// =============================================================================

ClearCollect(
    colIGCEHeader,
    ForAll(
        IGCEHeader As h,
        {
          ID: h.ID,
          Title: h.Title,
          Revision: Coalesce(h.Revision, 1),
          PRTrackerID: { Id: h.PRTrackerID.Id, Value: h.PRTrackerID.Value },
          PRTrackerNumber: h.Title,
          PRID: h.PRID,
          IGCEType: { Value: h.IGCEType.Value },
          PointOfContact: { Claims: h.PointOfContact.Claims, DisplayName: h.PointOfContact.DisplayName, Email: Lower(h.PointOfContact.Email), Department: h.PointOfContact.Department, JobTitle: h.PointOfContact.JobTitle },
          COR: { Claims: h.COR.Claims, DisplayName: h.COR.DisplayName, Email: Lower(h.COR.Email), Department: h.COR.Department, JobTitle: h.COR.JobTitle },
          BasePeriodStart: h.BasePeriodStart,
          BasePeriodEnd: h.BasePeriodEnd,
          OptionPeriods: Coalesce(h.OptionPeriods, 0),
          InflationRate: Round(Coalesce(h.InflationRate, 0) * 100, 6),
          FringeRate: Round(Coalesce(h.FringeRate, 0) * 100, 6),
          OverheadRate: Round(Coalesce(h.OverheadRate, 0) * 100, 6),
          GARate: Round(Coalesce(h.GAndARate, 0) * 100, 6),
          FCCOMRate: Round(Coalesce(h.FCCOMRate, 0) * 100, 6),
          ProfitFeeRate: Round(Coalesce(h.ProfitFeeRate, 0) * 100, 6),
          ContractAccessFeeRate: Round(Coalesce(h.ContractAccessFeeRate, 0) * 100, 6),
          IndirectBurdenRate: Round(Coalesce(h.IndirectBurdenRate, 0) * 100, 6),
          AccountablePropertyTotal: Coalesce(h.AccountablePropertyTotal, 0),
          Status: { Value: Coalesce(h.Status.Value, "Draft") },
          ContainsGFP: Coalesce(h.ContainsGFP, false),
          SubmittedBy: Coalesce(h.SubmittedBy, ""),
          SubmittedOn: h.SubmittedOn,
          Modified: h.Modified,
          Assumptions: Coalesce(h.Assumptions, ""),
          InformationToolsUsed: Coalesce(h.InformationToolsUsed, ""),
          InformationObtainedFrom: Coalesce(h.InformationObtainedFrom, ""),
          PreviousContracts: Coalesce(h.PreviousContracts, ""),
          LaborBasis: Coalesce(h.LaborBasis, ""),
          LaborCategoriesBasis: Coalesce(h.LaborCategoriesBasis, ""),
          LaborRatesBasis: Coalesce(h.LaborRatesBasis, ""),
          HoursBasis: Coalesce(h.HoursBasis, ""),
          UnburdenedDirectLaborBasis: Coalesce(h.UnburdenedDirectLaborBasis, ""),
          ODCBasis: Coalesce(h.ODCBasis, ""),
          DirectMaterialBasis: Coalesce(h.DirectMaterialBasis, ""),
          ProductsSuppliesBasis: Coalesce(h.ProductsSuppliesBasis, ""),
          SubcontractsBasis: Coalesce(h.SubcontractsBasis, ""),
          TravelBasis: Coalesce(h.TravelBasis, ""),
          IndirectRatesBasis: Coalesce(h.IndirectRatesBasis, ""),
          IndirectBurdenBasis: Coalesce(h.IndirectBurdenBasis, ""),
          GAndABasis: Coalesce(h.GAndABasis, ""),
          FCCOMBasis: Coalesce(h.FCCOMBasis, ""),
          FixedFeeBasis: Coalesce(h.FixedFeeBasis, ""),
          gfpJustifiQues1: Coalesce(h.gfpJustifiQues1, ""),
          gfpJustifiQues2: Coalesce(h.gfpJustifiQues2, ""),
          gfpJustifiQues3: Coalesce(h.gfpJustifiQues3, ""),
          gfpJustifiQues4: Coalesce(h.gfpJustifiQues4, ""),
          gfpJustifiQues5: Coalesce(h.gfpJustifiQues5, ""),
          gfpJustifiQues6: Coalesce(h.gfpJustifiQues6, "")
        }
    )
);

ClearCollect(
    colIGCELine,
    ForAll(
        IGCELine As l,
        {
          ID: l.ID,
          IGCEHeaderID: l.IGCEHeaderID,
          Title: l.Title,
          LineNumber: l.LineNumber,
          Labor: Coalesce(l.Labor, false),
          Category: { Value: l.Category.Value },
          BaseYearCost: Coalesce(l.BaseYearCost, 0),
          OP1Cost: Coalesce(l.OP1Cost, 0),
          OP2Cost: Coalesce(l.OP2Cost, 0),
          OP3Cost: Coalesce(l.OP3Cost, 0),
          OP4Cost: Coalesce(l.OP4Cost, 0),
          AccountablePropertyTotal: Coalesce(l.AccountablePropertyTotal, 0)
        }
    )
);

ClearCollect(
    colIGCESubLine,
    ForAll(
        IGCESubLine As s,
        {
          ID: s.ID,
          IGCELineID: s.IGCELineID,
          Title: s.Title,
          Ref: s.CLIN,
          SerialNumber: Coalesce(s.SerialNumber, ""),
          SublineType: { Value: s.SublineType.Value },
          IncludesProperty: Coalesce(s.IncludesProperty, false),
          PropertyType: { Value: s.PropertyType.Value },
          LaborCategories: Coalesce(s.LaborCategories, ""),
          ODCCategory: { Value: s.ODCCategory.Value },
          Units: { Value: s.Units.Value },
          Software: Coalesce(s.Software, false),
          CalculateOptionPeriods: Coalesce(s.CalculateOptionPeriods, false),
          BaseYearQuantity: Coalesce(s.BaseYearQuantity, 0),
          BaseYearRate: Coalesce(s.BaseYearRate, 0),
          BaseYearFringe: Coalesce(s.BaseYearFringe, 0),
          BaseYearOverhead: Coalesce(s.BaseYearOverhead, 0),
          BaseYearGAndA: Coalesce(s.BaseYearGAndA, 0),
          BaseYearFCCOM: Coalesce(s.BaseYearFCCOM, 0),
          BaseYearCost: Coalesce(s.BaseYearCost, 0),
          BaseYearBurden: Coalesce(s.BaseYearBurden, 0),
          BaseYearTotalCost: Coalesce(s.BaseYearTotalCost, 0),
          OP1Quantity: Coalesce(s.OP1Quantity, 0),
          OP1Rate: Coalesce(s.OP1Rate, 0),
          OP1Fringe: Coalesce(s.OP1Fringe, 0),
          OP1Overhead: Coalesce(s.OP1Overhead, 0),
          OP1GAndA: Coalesce(s.OP1GAndA, 0),
          OP1FCCOM: Coalesce(s.OP1FCCOM, 0),
          OP1Cost: Coalesce(s.OP1Cost, 0),
          OP1Burden: Coalesce(s.OP1Burden, 0),
          OP1TotalCost: Coalesce(s.OP1TotalCost, 0),
          OP2Quantity: Coalesce(s.OP2Quantity, 0),
          OP2Rate: Coalesce(s.OP2Rate, 0),
          OP2Fringe: Coalesce(s.OP2Fringe, 0),
          OP2Overhead: Coalesce(s.OP2Overhead, 0),
          OP2GAndA: Coalesce(s.OP2GAndA, 0),
          OP2FCCOM: Coalesce(s.OP2FCCOM, 0),
          OP2Cost: Coalesce(s.OP2Cost, 0),
          OP2Burden: Coalesce(s.OP2Burden, 0),
          OP2TotalCost: Coalesce(s.OP2TotalCost, 0),
          OP3Quantity: Coalesce(s.OP3Quantity, 0),
          OP3Rate: Coalesce(s.OP3Rate, 0),
          OP3Fringe: Coalesce(s.OP3Fringe, 0),
          OP3Overhead: Coalesce(s.OP3Overhead, 0),
          OP3GAndA: Coalesce(s.OP3GAndA, 0),
          OP3FCCOM: Coalesce(s.OP3FCCOM, 0),
          OP3Cost: Coalesce(s.OP3Cost, 0),
          OP3Burden: Coalesce(s.OP3Burden, 0),
          OP3TotalCost: Coalesce(s.OP3TotalCost, 0),
          OP4Quantity: Coalesce(s.OP4Quantity, 0),
          OP4Rate: Coalesce(s.OP4Rate, 0),
          OP4Fringe: Coalesce(s.OP4Fringe, 0),
          OP4Overhead: Coalesce(s.OP4Overhead, 0),
          OP4GAndA: Coalesce(s.OP4GAndA, 0),
          OP4FCCOM: Coalesce(s.OP4FCCOM, 0),
          OP4Cost: Coalesce(s.OP4Cost, 0),
          OP4Burden: Coalesce(s.OP4Burden, 0),
          OP4TotalCost: Coalesce(s.OP4TotalCost, 0),
          TotalCost: Coalesce(s.TotalCost, 0)
        }
    )
);

// Rebuild line and subline totals from what was loaded. Not nfIGCERecalcHeader,
// which would stamp every estimate as just modified.
ClearCollect(colTmpIds, ShowColumns(colIGCELine, ID));
ForAll(colTmpIds As t, nfIGCERecalcLine(t.ID));
Clear(colTmpIds);

// =============================================================================
//  EDIT STAGING ROWS
//  One row each: the columns a screen may edit. A screen patches the row, then
//  calls the save routine, which owns rollups, calculated columns and Status.
// =============================================================================

ClearCollect(colIGCEHeaderEdit,
    {
        Title: "",
        Revision: 1,
        PRTrackerID: { Id: 0, Value: "" },
        PRTrackerNumber: "",
        PRID: "",
        IGCEType: { Value: "" },
        PointOfContact: nfSignedIn,
        COR: nfSignedIn,
        // A date typed blank: Blank() alone would type the column as Blank.
        BasePeriodStart: If(false, Today()),
        BasePeriodEnd: If(false, Today()),
        OptionPeriods: 0,
        InflationRate: 0,
        FringeRate: 0,
        OverheadRate: 0,
        GARate: 0,
        FCCOMRate: 0,
        ProfitFeeRate: 0,
        ContractAccessFeeRate: 0,
        IndirectBurdenRate: 0,
        ContainsGFP: false
    }
);

ClearCollect(colIGCELineEdit,
    {
        IGCEHeaderID: 0,
        Title: "",
        LineNumber: 0,
        Labor: false,
        Category: { Value: "" }
    }
);

ClearCollect(colIGCESubLineEdit,
    {
        IGCELineID: 0,
        Title: "",
        Ref: "",
        SerialNumber: "",
        SublineType: { Value: "FFP" },
        IncludesProperty: false,
        PropertyType: { Value: "" },
        LaborCategories: "",
        ODCCategory: { Value: "" },
        Units: { Value: "EA" },
        Software: false,
        CalculateOptionPeriods: true,
        BaseYearQuantity: 0, OP1Quantity: 0, OP2Quantity: 0,
        OP3Quantity: 0, OP4Quantity: 0,
        BaseYearRate: 0, OP1Rate: 0, OP2Rate: 0, OP3Rate: 0, OP4Rate: 0
    }
);

// The estimate being viewed, the PR for the requirement and compare screens, the
// two revisions being compared, and the stepper component's app scope output.
Set(gblIgceHeaderID, 0);
Set(gblIgcePRID, "");
Set(gblIgceCmpA, 0);
Set(gblIgceCmpB, 0);
Set(_stepSel, 0);
