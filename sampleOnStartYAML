                                    If(
                                        IsEmpty(Errors([@IGCESubLine])),
                                        UpdateContext({ locSublineDialog: false });
                                        Notify("Subline saved.", NotificationType.Success),
                                        Notify("The subline was not saved. " & First(Errors([@IGCESubLine])).Message, NotificationType.Error)
