                                                IGCELineID: gl_IGCELine.ID
                                            }
                                        ),
                                        Patch([@IGCESubLine], locSubline, {
                                            'Ref #': txt_DlgRef_Details.Text,
                                            Title: txt_DlgDescription_Details.Text,
                                            SublineType: drp_DlgType_Details.Selected,
