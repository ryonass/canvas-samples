              =UpdateContext({ locDeleteSubline: Blank() })
            OnConfirm: |-
              =Remove([@IGCESubLine], locDeleteSubline);
              UpdateContext({ locDeleteSubline: Blank() });
              Notify("Subline deleted.", NotificationType.Success)
            Theme: =nfColor
            Title: ="Delete this subline?"
            Visible: =!IsBlank(locDeleteSubline)
            Width: =Parent.Width
      - cmp_ConfirmDeleteLine_Details:
          Control: CanvasComponent
          ComponentName: cmpConfirmDialog
          Properties:
            CancelLabel: ="Keep it"
            ConfirmLabel: ="Delete line"
            Height: =Parent.Height
            IsDanger: =true
            IsPhone: =nfIsPhone
            Message: ="The line and all of its sublines will be removed from this IGCE. This cannot be undone."
