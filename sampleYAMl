Screens:
  scr_IGCEDetails:
    Children:
      - con_Main_Details:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            Fill: =RGBA(245, 245, 245, 1)
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            LayoutGap: =16
            LayoutOverflowY: =LayoutOverflow.Scroll
            PaddingBottom: =16
            PaddingLeft: =16
            PaddingRight: =16
            PaddingTop: =16
            Width: =Parent.Width
          Children:
            - con_Top_Details:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  AlignInContainer: =AlignInContainer.SetByContainer
                  Fill: =RGBA(255, 255, 255, 1)
                  FillPortions: =0
                  Height: =75
                  LayoutDirection: =LayoutDirection.Horizontal
                  RadiusBottomLeft: =8
                  RadiusBottomRight: =8
                  RadiusTopLeft: =8
                  RadiusTopRight: =8
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                Children:
                  - hdr_Top_Details:
                      Control: Header@0.0.44
                      Properties:
                        Logo: =CISA_Logo
                        LogoTooltip: ="CISA logo image"
                        Title: |-
                          ="PR: " & gl_IGCE.'PR Tracker Number'.Value & " | IGCE: " & gl_IGCE.ID
                        UserEmail: =nf_User.Email
                        UserImageAltText: =nf_User.DisplayName &" profile picture"
                        UserName: =nf_User.DisplayName
            - con_TopButtons_Details:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  AlignInContainer: =AlignInContainer.SetByContainer
                  DropShadow: =DropShadow.None
                  FillPortions: =0
                  Height: =32
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =8
                  LayoutJustifyContent: =LayoutJustifyContent.End
                  PaddingLeft: =16
                  PaddingRight: =16
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                Children:
                  - Text1_1:
                      Control: ModernText@1.0.0
                      Properties:
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        Text: =gl_PRID & " | " & gl_PRTracker & " | " & gl_PRTrackerCOR.DisplayName & gl_FormMode
                        Width: =400
                  - btn_TopBack_Details:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =Self.Text
                        Align: =Align.Center
                        Appearance: =ButtonAppearance.Secondary
                        Color: =nf_DHSBlue
                        FontWeight: =FontWeight.Semibold
                        Height: =Parent.Height
                        Icon: ="ArrowLeft"
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        OnSelect: =Navigate(scr_IGCEDetails)
                        Text: ="Back"
                        VerticalAlign: =VerticalAlign.Middle
                        Visible: =true//gl_FormMode <> FormMode.Edit
                        Width: =100
                  - btn_TopEdit_Details:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =Self.Text
                        Align: =Align.Center
                        FontWeight: =FontWeight.Semibold
                        Height: =Parent.Height
                        Icon: ="Edit"
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        OnSelect: =Set(gl_FormMode,FormMode.Edit)
                        Text: ="Edit"
                        VerticalAlign: =VerticalAlign.Middle
                        Visible: =true//gl_FormMode <> FormMode.Edit && gl_IGCE.Status.Value <> "Complete"
                        Width: =100
                  - btn_New_1:
                      Control: ModernButton@1.0.0
                      Properties:
                        Appearance: =ButtonAppearance.Secondary
                        FontWeight: =FontWeight.Bold
                        Height: =Parent.Height
                        Icon: ="Edit"
                        Layout: =ButtonLayout.TextOnly
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        OnSelect: =Set(gl_FormMode,FormMode.New)
                        Text: ="New"
                        VerticalAlign: =VerticalAlign.Middle
                        Width: =100
                  - btn_View_1:
                      Control: ModernButton@1.0.0
                      Properties:
                        Appearance: =ButtonAppearance.Secondary
                        FontWeight: =FontWeight.Bold
                        Height: =Parent.Height
                        Icon: ="Edit"
                        Layout: =ButtonLayout.TextOnly
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        OnSelect: =Set(gl_FormMode,FormMode.View)
                        Text: ="View"
                        VerticalAlign: =VerticalAlign.Middle
                        Width: =100
                  - btn_Complete_3:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Submit approval request button"
                        Align: =Align.Center
                        DisplayMode: |-
                          =If(
                              gl_DisplayMode = DisplayMode.Edit,
                              //Then
                              If(
                                  And(
                                      cmp_Combobox_IGCEType.IsValid,
                                      cmp_OptionPeriods_Overview.IsValid,
                                      cmp_BaseStart_Overview.IsValid,
                                      cmp_BaseEnd_Overview.IsValid,
                                      cmp_OP1Start_Overview.IsValid,
                                      cmp_OP1End_Overview.IsValid,
                                      cmp_OP2Start_Overview.IsValid,
                                      cmp_OP2End_Overview.IsValid,
                                      cmp_OP3Start_Overview.IsValid,
                                      cmp_OP3End_Overview.IsValid,
                                      cmp_OP4Start_Overview.IsValid,
                                      cmp_OP4End_Overview.IsValid,
                                      cmp_InflationRate_Overview.IsValid,
                                      cmp_ContractAccessFee_Overview.IsValid,
                                      cmp_ProfitFee_Overview.IsValid,
                                      cmp_Fringe_Overview.IsValid,
                                      cmp_Overhead_Overview.IsValid,
                                      cmp_GA_Overview.IsValid,
                                      cmp_FCCOM_Overview.IsValid,
                                      Not(IsBlank(cmb_POC.SelectedItems)),
                                      txt_LaborBasis.IsValidationState = ValidationState.None,
                                      txt_HoursBasis.IsValidationState = ValidationState.None,
                                      txt_LaborCategoriesBasis.IsValidationState = ValidationState.None,
                                      txt_LaborRatesBasis.IsValidationState = ValidationState.None,
                                      txt_UnburdenedDirectLaborBasis.IsValidationState = ValidationState.None,
                                      cmp_Assumptions.IsValid,
                                      cmp_InformationToolsUsed.IsValid,
                                      cmp_InformationObtainedFrom.IsValid,
                                      cmp_PreviousContracts.IsValid,
                                      cmp_gfpJustifiQues1.IsValid, /*Updated GFP*/
                                      cmp_gfpJustifiQues2.IsValid, /*Updated GFP*/
                                      cmp_gfpJustifiQues3.IsValid, /*Updated GFP*/
                                      cmp_gfpJustifiQues4.IsValid, /*Updated GFP*/
                                      cmp_gfpJustifiQues5.IsValid, /*Updated GFP*/
                                      cmp_gfpJustifiQues6.IsValid  /*Updated GFP*/
                                  ),
                                  //Then
                                  DisplayMode.Edit,
                                  //Else
                                  DisplayMode.Disabled
                              ),
                              //Else
                              If(gl_FormMode=FormMode.View,DisplayMode.View,DisplayMode.Edit)
                          )
                        FontWeight: =""
                        Height: =Parent.Height
                        Icon: ="Checkmark"
                        OnSelect: |-
                          =UpdateContext({_newRecord: IsBlank(gl_IGCE.ID)})
                        PaddingBottom: =0
                        PaddingLeft: =8
                        PaddingRight: =8
                        PaddingTop: =0
                        Text: ="Submit"
                        VerticalAlign: =VerticalAlign.Middle
                        Visible: =false//true
                        Width: =140
                  - btn_TopSave_Details:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =Self.Text
                        Align: =Align.Center
                        DisplayMode: |-
                          =If(
                              IsBlank(cmb_IGCEType_Overview.Selected.Value) || IsBlank(cmb_POC_Overview.Selected.DisplayName) || IsBlank(cmb_COR_Overview.Selected.DisplayName) || IsBlank(cmp_BaseStart_Overview.Value) || IsBlank(cmp_BaseEnd_Overview.Value) || IsBlank(cmb_OptionPeriods_Overview.Selected.Value),
                              DisplayMode.Disabled,
                              !IsBlank(gl_IGCE) && (cmp_LaborBasis_Overview.Required || cmp_HoursBasis_Overview.Required || cmp_LaborCatBasis_Overview.Required || cmp_LaborRatesBasis_Overview.Required || cmp_UnburdenedDirectLaborBasis_Overview.Required),
                              DisplayMode.Disabled,
                              DisplayMode.Edit
                          )
                        FontWeight: =FontWeight.Semibold
                        Height: =Parent.Height
                        Icon: ="Save"
                        LayoutMinWidth: =16
                        OnSelect: |-
                          =If(
                              !con_Subline_Details.Visible,
                              Set(
                                  gl_IGCELine,
                                  Patch(
                                      [@IGCELine_IGCE_SPList],
                                      gl_IGCELine,
                                      {Category: cmp_Category_Details.Value}
                                  )
                              )
                          );
                          Refresh([@IGCELine_IGCE_SPList])
                        Text: ="Save"
                        VerticalAlign: =VerticalAlign.Middle
                        Width: =100
                  - btn_TopReport_Details:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =Self.Text
                        Align: =Align.Center
                        Appearance: =ButtonAppearance.Secondary
                        Color: =nf_DHSBlue
                        FontWeight: =FontWeight.Semibold
                        Height: =Parent.Height
                        Icon: ="Open"
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        OnSelect: =Launch(Concatenate(nf_PowerBIURL,gl_PRID))
                        Text: ="Report"
                        VerticalAlign: =VerticalAlign.Middle
                        Visible: =false//If((gl_IGCE.Status.Value="Submitted"),true,false)
                        Width: =100
                  - btn_TopDownload_Details:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =Self.Text
                        Align: =Align.Center
                        Appearance: =ButtonAppearance.Secondary
                        Color: =nf_DHSBlue
                        FontWeight: =FontWeight.Semibold
                        Height: =Parent.Height
                        Icon: ="ArrowDownload"
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        OnSelect: =false
                        Text: ="Download"
                        VerticalAlign: =VerticalAlign.Middle
                        Visible: =false//gl_FormMode <> FormMode.Edit
                        Width: =120
            - con_Line_Details:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  AlignInContainer: =AlignInContainer.SetByContainer
                  Fill: =RGBA(255, 255, 255, 1)
                  FillPortions: =0
                  Height: |-
                    =Sum(
                        Self.PaddingTop,
                        Self.PaddingBottom,
                        lbl_LineTitle_Details.Height,
                        con_LineTable_Details.Height,
                        Self.LayoutGap
                    )
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =8
                  PaddingBottom: =16
                  PaddingLeft: =16
                  PaddingRight: =16
                  PaddingTop: =16
                  RadiusBottomLeft: =8
                  RadiusBottomRight: =8
                  RadiusTopLeft: =8
                  RadiusTopRight: =8
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                Children:
                  - lbl_LineTitle_Details:
                      Control: ModernText@1.0.0
                      Properties:
                        Color: =nf_DHSBlue
                        FontWeight: =FontWeight.Bold
                        Height: =30
                        LayoutMinWidth: =96
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        RadiusBottomLeft: =0
                        RadiusBottomRight: =0
                        RadiusTopLeft: =0
                        RadiusTopRight: =0
                        Size: =20
                        Text: ="Line"
                        VerticalAlign: =VerticalAlign.Top
                        Width: =Parent.Width
                  - con_LineTable_Details:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.SetByContainer
                        BorderStyle: =BorderStyle.None
                        DropShadow: =DropShadow.None
                        FillPortions: =0
                        Height: =90
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =8
                        LayoutOverflowX: =LayoutOverflow.Scroll
                      Children:
                        - cmp_LineNumber_Details:
                            Control: CanvasComponent
                            ComponentName: cmp_Text
                            Properties:
                              CustomValidationError: =""
                              DefaultValue: =gl_IGCELine.LineNumber
                              DisplayMode: =DisplayMode.Disabled
                              Height: =76
                              Label: =DataSourceInfo([@IGCELine_IGCE_SPList],DataSourceInfo.DisplayName,'Line Number')
                              Required: =false
                              Width: =150
                        - cmp_Labor_Details:
                            Control: CanvasComponent
                            ComponentName: cmp_Boolean
                            Properties:
                              DefaultValue: =gl_IGCELine.Labor//If(IsBlank(gl_IGCELine.Labor),false,gl_IGCELine.Labor)
                              DisplayMode: |-
                                =If(
                                    gl_FormMode = FormMode.Edit,
                                    Switch(
                                        gl_IGCELine.Category.Value,
                                        "Standard Line",
                                        DisplayMode.Edit,
                                        "Products/Supplies",
                                        DisplayMode.Edit,
                                        DisplayMode.Disabled
                                    ),
                                    gl_FormMode
                                )
                              Height: =76
                              Label: =DataSourceInfo([@IGCELine_IGCE_SPList],DataSourceInfo.DisplayName,Labor)
                              Width: =50
                        - cmp_Category_Details:
                            Control: CanvasComponent
                            ComponentName: cmp_Combobox
                            Properties:
                              CustomValidationError: =""
                              DefaultValue: |-
                                ={Value:gl_IGCELine.Category.Value}
                              DisplayMode: =If(gl_FormMode=FormMode.View,DisplayMode.View,DisplayMode.Edit)
                              Height: =76
                              Items: =Choices([@IGCELine_IGCE_SPList].Category).Value
                              Label: =DataSourceInfo([@IGCELine_IGCE_SPList],DataSourceInfo.DisplayName,Category)
                              Required: =false
                              Width: =250
                        - cmp_LineDescription_Details:
                            Control: CanvasComponent
                            ComponentName: cmp_Text
                            Properties:
                              CustomValidationError: =""
                              DefaultValue: =gl_IGCELine.Title
                              DisplayMode: =//If(gl_DisplayMode = DisplayMode.Edit, Switch(gl_IGCELine.Category.Value, "Standard Line", DisplayMode.Edit, "Products/Supplies", DisplayMode.Edit, DisplayMode.Disabled), gl_DisplayMode)
                              FillPortions: =1
                              Height: =76
                              Label: =DataSourceInfo([@IGCELine_IGCE_SPList],DataSourceInfo.DisplayName,Description)
                              Required: =false
                              Width: =150
                        - btn_DeleteLine_Details:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: =Self.Text
                              Align: =Align.Center
                              BasePaletteColor: =RGBA(249, 83, 109, 1)
                              DisplayMode: =//If(gl_DisplayMode = DisplayMode.Edit, Switch(gl_IGCELine.Category.Value, "Standard Line", DisplayMode.Edit, "Products/Supplies", DisplayMode.Edit, DisplayMode.Disabled), gl_DisplayMode)
                              FontWeight: =FontWeight.Bold
                              Height: =31
                              Icon: ="Delete"
                              OnSelect: |-
                                =/*Remove([@IGCELine],gl_IGCELine);
                                Back(ScreenTransition.Fade);*/
                              PaddingBottom: =0
                              PaddingLeft: =8
                              PaddingRight: =8
                              PaddingTop: =0
                              RadiusBottomLeft: =4
                              RadiusBottomRight: =4
                              RadiusTopLeft: =4
                              RadiusTopRight: =4
                              Text: ="Delete Line"
                              VerticalAlign: =VerticalAlign.Middle
                              Width: =136
                              Y: =32
            - con_Subline_Details:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  AlignInContainer: =AlignInContainer.SetByContainer
                  Fill: =RGBA(255, 255, 255, 1)
                  FillPortions: =0
                  Height: |-
                    =Sum(
                        Self.PaddingTop,
                        Self.PaddingBottom,
                        con_SublineTitle_Details.Height,
                        con_SublineTable_Details.Height,
                        Self.LayoutGap
                    )
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =8
                  LayoutMinHeight: =200
                  PaddingBottom: =16
                  PaddingLeft: =16
                  PaddingRight: =16
                  PaddingTop: =16
                  RadiusBottomLeft: =8
                  RadiusBottomRight: =8
                  RadiusTopLeft: =8
                  RadiusTopRight: =8
                  Visible: =true//!IsBlank(gl_IGCELine.Category.Value)
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                Children:
                  - con_SublineTitle_Details:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.SetByContainer
                        DropShadow: =DropShadow.None
                        FillPortions: =0
                        Height: =32
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =8
                        LayoutMinHeight: =40
                        Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                      Children:
                        - lbl_Subline_Details:
                            Control: ModernText@1.0.0
                            Properties:
                              Color: =nf_DHSBlue
                              FontWeight: =FontWeight.Bold
                              LayoutMinWidth: =96
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              RadiusBottomLeft: =0
                              RadiusBottomRight: =0
                              RadiusTopLeft: =0
                              RadiusTopRight: =0
                              Size: =20
                              Text: ="Sublines"
                              VerticalAlign: =VerticalAlign.Top
                              Width: =Parent.Width - Parent.LayoutGap - btn_AddSubline_Details.Width
                        - btn_AddSubline_Details:
                            Control: ModernButton@1.0.0
                            Properties:
                              Align: =Align.Center
                              DisplayMode: =If(gl_FormMode=FormMode.View,DisplayMode.View,DisplayMode.Edit)
                              FontWeight: =FontWeight.Bold
                              Height: =31
                              Icon: ="Add"
                              OnSelect: |-
                                =Set(
                                    gl_IGCELine,
                                    Patch(
                                        [@IGCELine_IGCE_SPList],
                                        gl_IGCELine,
                                        {
                                            Labor: cmp_Labor_Details.Value,
                                            Category: cmp_Category_Details.Value
                                        }
                                    )
                                );
                                UpdateContext(
                                    {
                                        locSubDeleteID: 0,
                                        locSubEditID: 0,
                                        locSubEdit: Defaults([@IGCESubLine_IGCE_SPList]),
                                        locSubModalOpen: true
                                    }
                                )
                              PaddingBottom: =0
                              PaddingLeft: =8
                              PaddingRight: =8
                              PaddingTop: =0
                              RadiusBottomLeft: =4
                              RadiusBottomRight: =4
                              RadiusTopLeft: =4
                              RadiusTopRight: =4
                              Text: ="Add Subline"
                              VerticalAlign: =VerticalAlign.Middle
                              Width: =136
                  - con_SublineTable_Details:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.SetByContainer
                        DropShadow: =DropShadow.None
                        Height: =con_TableFields_Details.Height + gal_Sublines_Details.Height + con_SublineFooter_Details.Height + Self.PaddingBottom + 16
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutOverflowX: =LayoutOverflow.Scroll
                        LayoutOverflowY: =LayoutOverflow.Scroll
                        PaddingBottom: =16
                        Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                      Children:
                        - con_TableFields_Details:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.SetByContainer
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: |-
                                =60/*Sum(
                                    Self.PaddingTop,
                                    Self.PaddingBottom,
                                    40
                                )*/
                              LayoutAlignItems: =LayoutAlignItems.Center
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutMinWidth: |-
                                =lbl_HdrCLIN_Details.Width+5 +
                                lbl_HdrDescription_Details.Width+5 +
                                If(lbl_HdrSerialNumber_Details.Visible, lbl_HdrSerialNumber_Details.Width+5,0) +
                                If(lbl_HdrType_Details.Visible, lbl_HdrType_Details.Width+5,0) +
                                If(lbl_HdrIncludesProperty_Details.Visible, lbl_HdrIncludesProperty_Details.Width+5,0) +
                                If(lbl_HdrPropertyType_Details.Visible, lbl_HdrPropertyType_Details.Width+5,0) +
                                If(lbl_HdrODCCategory_Details.Visible, lbl_HdrODCCategory_Details.Width+5,0) +
                                If(lbl_HdrSoftware_Details.Visible, lbl_HdrSoftware_Details.Width+5,0) +
                                lbl_HdrBaseQuantity_Details.Width+5+
                                lbl_HdrBaseRate_Details.Width+5+
                                lbl_HdrBaseCost_Details.Width+5+
                                If(lbl_HdrOP1Quantity_Details.Visible, lbl_HdrOP1Quantity_Details.Width+5,0) +
                                If(lbl_HdrOP1Rate_Details.Visible, lbl_HdrOP1Rate_Details.Width+5,0) +
                                If(lbl_HdrOP1Cost_Details.Visible, lbl_HdrOP1Cost_Details.Width+5,0) +
                                If(lbl_HdrOP1TotalCost_Details.Visible, lbl_HdrOP1TotalCost_Details.Width+5,0) +
                                If(lbl_HdrOP2Quantity_Details.Visible, lbl_HdrOP2Quantity_Details.Width+5,0) +
                                If(lbl_HdrOP2Rate_Details.Visible, lbl_HdrOP2Rate_Details.Width+5,0) +
                                If(lbl_HdrOP2Cost_Details.Visible, lbl_HdrOP2Cost_Details.Width+5,0) +
                                If(lbl_HdrOP2TotalCost_Details.Visible, lbl_HdrOP2TotalCost_Details.Width+5,0) +
                                If(lbl_HdrOP3Quantity_Details.Visible, lbl_HdrOP3Quantity_Details.Width+5,0) +
                                If(lbl_HdrOP3Rate_Details.Visible, lbl_HdrOP3Rate_Details.Width+5,0) +
                                If(lbl_HdrOP3Cost_Details.Visible, lbl_HdrOP3Cost_Details.Width+5,0) +
                                If(lbl_HdrOP3TotalCost_Details.Visible, lbl_HdrOP3TotalCost_Details.Width+5,0) +
                                If(lbl_HdrOP4Quantity_Details.Visible, lbl_HdrOP4Quantity_Details.Width+5,0) +
                                If(lbl_HdrOP4Rate_Details.Visible, lbl_HdrOP4Rate_Details.Width+5,0) +
                                If(lbl_HdrOP4Cost_Details.Visible, lbl_HdrOP4Cost_Details.Width+5,0) +
                                If(lbl_HdrOP4TotalCost_Details.Visible, lbl_HdrOP4TotalCost_Details.Width+5,0) +
                                lbl_HdrTotalCost_Details.Width+5+
                                lbl_HdrCalcOPs_Details.Width+5+
                                btn_DeleteSubline_Details.Width+35
                              PaddingBottom: =8
                              PaddingRight: =32
                              PaddingTop: =8
                              Width: |-
                                =lbl_HdrCLIN_Details.Width+5 +
                                lbl_HdrDescription_Details.Width+5 +
                                If(lbl_HdrSerialNumber_Details.Visible, lbl_HdrSerialNumber_Details.Width+5,0) +
                                If(lbl_HdrType_Details.Visible, lbl_HdrType_Details.Width+5,0) +
                                If(lbl_HdrIncludesProperty_Details.Visible, lbl_HdrIncludesProperty_Details.Width+5,0) +
                                If(lbl_HdrPropertyType_Details.Visible, lbl_HdrPropertyType_Details.Width+5,0) +
                                If(lbl_HdrODCCategory_Details.Visible, lbl_HdrODCCategory_Details.Width+5,0) +
                                If(lbl_HdrSoftware_Details.Visible, lbl_HdrSoftware_Details.Width+5,0) +
                                lbl_HdrBaseQuantity_Details.Width+5+
                                lbl_HdrBaseRate_Details.Width+5+
                                lbl_HdrBaseCost_Details.Width+5+
                                If(lbl_HdrOP1Quantity_Details.Visible, lbl_HdrOP1Quantity_Details.Width+5,0) +
                                If(lbl_HdrOP1Rate_Details.Visible, lbl_HdrOP1Rate_Details.Width+5,0) +
                                If(lbl_HdrOP1Cost_Details.Visible, lbl_HdrOP1Cost_Details.Width+5,0) +
                                If(lbl_HdrOP1TotalCost_Details.Visible, lbl_HdrOP1TotalCost_Details.Width+5,0) +
                                If(lbl_HdrOP2Quantity_Details.Visible, lbl_HdrOP2Quantity_Details.Width+5,0) +
                                If(lbl_HdrOP2Rate_Details.Visible, lbl_HdrOP2Rate_Details.Width+5,0) +
                                If(lbl_HdrOP2Cost_Details.Visible, lbl_HdrOP2Cost_Details.Width+5,0) +
                                If(lbl_HdrOP2TotalCost_Details.Visible, lbl_HdrOP2TotalCost_Details.Width+5,0) +
                                If(lbl_HdrOP3Quantity_Details.Visible, lbl_HdrOP3Quantity_Details.Width+5,0) +
                                If(lbl_HdrOP3Rate_Details.Visible, lbl_HdrOP3Rate_Details.Width+5,0) +
                                If(lbl_HdrOP3Cost_Details.Visible, lbl_HdrOP3Cost_Details.Width+5,0) +
                                If(lbl_HdrOP3TotalCost_Details.Visible, lbl_HdrOP3TotalCost_Details.Width+5,0) +
                                If(lbl_HdrOP4Quantity_Details.Visible, lbl_HdrOP4Quantity_Details.Width+5,0) +
                                If(lbl_HdrOP4Rate_Details.Visible, lbl_HdrOP4Rate_Details.Width+5,0) +
                                If(lbl_HdrOP4Cost_Details.Visible, lbl_HdrOP4Cost_Details.Width+5,0) +
                                If(lbl_HdrOP4TotalCost_Details.Visible, lbl_HdrOP4TotalCost_Details.Width+5,0) +
                                lbl_HdrTotalCost_Details.Width+5+
                                lbl_HdrCalcOPs_Details.Width+5+
                                btn_DeleteSubline_Details.Width+35
                            Children:
                              - lbl_HdrCLIN_Details:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Align: =Align.Center
                                    Color: =nf_DHSBlue
                                    FontWeight: =FontWeight.Semibold
                                    Height: =Parent.Height - Parent.PaddingTop - Parent.PaddingBottom
                                    LayoutMinWidth: =96
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
