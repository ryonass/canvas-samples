Screens:
  scrOverview:
    Properties:
      Fill: =nfColor.Page
      OnVisible: |-
        =UpdateContext({ locLoading: true });
        UpdateContext({ locLoading: false })
    Children:
      - conOvwRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmpOvwHeader:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: ="overview"
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  HelpUrl: =nfApp.HelpUrl
                  HubUrl: =nfApp.HubUrl
                  IsStaff: =gblIsStaff
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Logo: =nfLogo
                  LogoWidth: =nfApp.LogoWidth
                  OnHelpSelect: =Launch(nfApp.HelpUrl)
                  OnHubSelect: =Launch(nfApp.HubUrl)
                  OnNavSelect: =nfGo(Self.SelectedKey)
                  ShowHubLink: =!IsBlank(nfApp.HubUrl)
                  Theme: =nfColor
                  Title: =nfApp.Name
                  UserImage: =User().Image
                  WelcomeName: =nfUserName
            - conOvwHeaderRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - conOvwBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  LayoutOverflowY: =LayoutOverflow.Scroll
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =nfGutter
                  PaddingRight: =nfGutter
                  PaddingTop: =nfSpace.Xl
                Children:
                  - conOvwHead:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =54
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conOvwTitleText:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              Height: =54
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - lblOvwTitle:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.H1
                                    Text: =nfGreeting & ", " & nfFirstName
                                    Wrap: =false
                              - lblOvwSub:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Body
                                    Text: =nfApp.Tagline
                                    Wrap: =false
                        - btnOvwNew:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="New " & nfItem
                              Height: =nfSize.Control
                              Icon: ="Add"
                              OnSelect: =nfGo("form")
                              Size: =nfType.Body
                              Text: ="New " & nfItem
                              Visible: =!nfIsPhone
                              Width: =140
                  - conOvwNotice:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.PrimarySoft
                        FillPortions: =0
                        Height: =56
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        PaddingLeft: =nfSpace.Lg
                        PaddingRight: =nfSpace.Lg
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Visible: =!IsBlank(nfApp.Notice)
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - lblOvwNotice:
                            Control: ModernText@1.0.0
                            Properties:
                              AutoHeight: =true
                              Color: =nfColor.InfoInk
                              FillPortions: =1
                              LayoutMinWidth: =0
                              PaddingBottom: =0
                              PaddingLeft: =0
