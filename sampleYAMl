Screens:
  scrList:
    Properties:
      Fill: =nfColor.Page
      OnVisible: |-
        =UpdateContext({ locLoading: true });
        Reset(txtLstSearch);
        Reset(drpLstStatus);
        UpdateContext({ locLoading: false })
    Children:
      - conLstRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmpLstHeader:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: ="list"
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  HubUrl: =nfApp.HubUrl
                  IsStaff: =gblIsStaff
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Logo: =nfLogo
                  OnHubSelect: =Launch(nfApp.HubUrl)
                  OnNavSelect: =nfGo(Self.SelectedKey)
                  OnRightAction: =false
                  RightActionLabel: =""
                  ShowHubLink: =!IsBlank(nfApp.HubUrl)
                  Theme: =nfColor
                  Title: =nfApp.Name
                  UserImage: =User().Image
                  WelcomeName: =nfUserName
            - conLstHeaderRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - conLstBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =nfGutter
                  PaddingRight: =nfGutter
                  PaddingTop: =nfSpace.Xl
                Children:
                  - conLstHead:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =54
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conLstTitleText:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              Height: =54
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - lblLstTitle:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.H1
                                    Text: =nfNavLabel("list")
                                    Wrap: =false
                              - lblLstSub:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Body
                                    Text: ="Everything you have asked for, newest first."
                                    Wrap: =false
                        - btnLstNew:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="New " & nfItem
                              Height: =nfSize.Control
                              Icon: ="Add"
                              OnSelect: =nfGo("form")
                              Size: =nfType.Body
                              Text: ="New " & nfItem
                              Visible: =!nfIsPhone
                              Width: =140
                  - conLstTools:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =If(nfIsPhone, 2 * nfSize.Control + nfSpace.Sm, nfSize.Control)
                        LayoutDirection: =If(nfIsPhone, LayoutDirection.Vertical, LayoutDirection.Horizontal)
                        LayoutGap: =nfSpace.Sm
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - txtLstSearch:
                            Control: ModernTextInput@1.1.2
                            Properties:
                              AccessibleLabel: ="Search " & nfItems
                              AlignInContainer: =AlignInContainer.Stretch
                              Appearance: =Appearance.Outline
                              FillPortions: =If(nfIsPhone, 0, 1)
                              Height: =nfSize.Control
                              LayoutMinWidth: =0
                              Placeholder: ="Search by title or asset tag"
                              Size: =nfType.Input
                        - drpLstStatus:
                            Control: ModernDropdown@1.0.3
                            Properties:
                              AccessibleLabel: ="Filter by status"
                              AlignInContainer: =AlignInContainer.Stretch
                              Appearance: =Appearance.Outline
                              Default: =LookUp(nfStatusFilters, Key = Coalesce(locStatusFilter, "all"))
                              Height: =nfSize.Control
                              ItemDisplayText: =ThisItem.Label
                              Items: =nfStatusFilters
                              LayoutMinWidth: =0
                              Size: =nfType.Input
                              Width: =200
                  - conLstTable:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conLstTableHead:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Sunk
                              FillPortions: =0
                              Height: =40
                              LayoutAlignItems: =LayoutAlignItems.Center
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Md
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              PaddingLeft: =nfSpace.Lg
                              PaddingRight: =nfSpace.Lg
                              RadiusTopLeft: =nfRadius.Md
                              RadiusTopRight: =nfRadius.Md
                              Visible: =!nfIsPhone
                            Children:
                              - lblLstHItem:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FillPortions: =1
                                    FontWeight: =FontWeight.Semibold
                                    LayoutMinWidth: =0
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: =Upper(nfItemCap)
                                    Wrap: =false
                              - lblLstHService:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="SERVICE"
                                    Width: =180
                                    Wrap: =false
                              - lblLstHAssettag:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="ASSET TAG"
                                    Visible: =nfIsDesktop
                                    Width: =120
                                    Wrap: =false
                              - lblLstHUpdated:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="UPDATED"
                                    Visible: =nfIsDesktop
                                    Width: =120
                                    Wrap: =false
                              - lblLstHStatus:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="STATUS"
                                    Width: =nfSize.Pill
                                    Wrap: =false
                              - lblLstHGo:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: =""
                                    Width: =16
                                    Wrap: =false
                        - galLstRows:
                            Control: Gallery@2.15.0
                            Variant: Vertical
                            Properties:
                              AccessibleLabel: =nfNavLabel("list")
                              Items: |-
                                =SortByColumns(
                                    Filter(
                                        colRequests,
                                        AppKey = nfApp.AppKey,
                                        RequesterEmail = nfUserEmail,
                                        IsBlank(txtLstSearch.Text) || StartsWith(Title, txtLstSearch.Text) || StartsWith(AssetTag, txtLstSearch.Text),
                                        drpLstStatus.Selected.Key = "all" || (drpLstStatus.Selected.Key = "open" && (Status = nfOpen.K1 || Status = nfOpen.K2 || Status = nfOpen.K3 || Status = nfOpen.K4)) || Status = drpLstStatus.Selected.Key
                                    ),
                                    "Modified",
                                    SortOrder.Descending
                                )
                              TemplatePadding: =0
                              TemplateSize: =nfSize.Row
                              Visible: =!nfIsPhone
                            Children:
                              - conLstRow:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    Height: =Parent.TemplateHeight - 1
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutGap: =nfSpace.Md
                                    PaddingLeft: =nfSpace.Lg
                                    PaddingRight: =nfSpace.Lg
                                    Width: =Parent.TemplateWidth
                                  Children:
                                    - lblLstCTitle:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Ink
                                          FillPortions: =1
                                          FontWeight: =FontWeight.Semibold
                                          LayoutMinWidth: =0
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =ThisItem.Title
                                          Wrap: =false
                                    - lblLstCService:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Ink2
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =nfServiceTitle(ThisItem.ServiceKey)
                                          Width: =180
                                          Wrap: =false
                                    - lblLstCAsset:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Ink2
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Coalesce(ThisItem.AssetTag, "None")
                                          Visible: =nfIsDesktop
                                          Width: =120
                                          Wrap: =false
                                    - lblLstCUpdated:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Ink2
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Text(ThisItem.Modified, "mmm d, yyyy")
                                          Visible: =nfIsDesktop
                                          Width: =120
                                          Wrap: =false
                                    - conLstPill:
                                        Control: GroupContainer@1.5.0
                                        Variant: ManualLayout
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          DropShadow: =DropShadow.None
                                          Fill: =nfColor.Transparent
                                          FillPortions: =0
                                          Height: =24
                                          LayoutMinHeight: =0
                                          LayoutMinWidth: =0
                                          Width: =nfSize.Pill
                                        Children:
                                          - conLstPillShape:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                Fill: =Switch(nfStatusTone(ThisItem.Status), "Info", nfColor.InfoSoft, "Warning", nfColor.WarningSoft, "Success", nfColor.SuccessSoft, "Danger", nfColor.DangerSoft, nfColor.NeutralSoft)
                                                Height: =24
                                                RadiusBottomLeft: =12
                                                RadiusBottomRight: =12
                                                RadiusTopLeft: =12
                                                RadiusTopRight: =12
                                                Width: =Min(Parent.Width, Len(nfStatusLabel(ThisItem.Status)) * 7 + 24)
                                              Children:
                                                - lblLstPill:
                                                    Control: ModernText@1.0.0
                                                    Properties:
                                                      Align: =Align.Center
                                                      AutoHeight: =true
                                                      Color: =Switch(nfStatusTone(ThisItem.Status), "Info", nfColor.InfoInk, "Warning", nfColor.WarningInk, "Success", nfColor.SuccessInk, "Danger", nfColor.DangerInk, nfColor.NeutralInk)
                                                      FontWeight: =FontWeight.Semibold
                                                      PaddingBottom: =0
                                                      PaddingLeft: =8
                                                      PaddingRight: =8
                                                      PaddingTop: =0
                                                      Size: =nfType.Small
                                                      Text: =nfStatusLabel(ThisItem.Status)
                                                      Width: =Parent.Width
                                                      Wrap: =false
                                                      Y: =(Parent.Height - Self.Height) / 2
                                    - imgLstGo:
                                        Control: Image@2.2.3
                                        Properties:
                                          Height: =16
                                          Image: ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#565C65' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6'/></svg>")
                                          Width: =16
                              - conLstRowRule:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Line
                                    Height: =1
                                    Width: =Parent.TemplateWidth
                                    Y: =Parent.TemplateHeight - 1
                              - btnLstRowOpen:
                                  Control: Classic/Button@2.2.0
                                  Properties:
                                    BorderStyle: =BorderStyle.None
                                    BorderThickness: =0
                                    Fill: =nfColor.Transparent
                                    FocusedBorderThickness: =2
                                    Height: =Parent.TemplateHeight - 1
                                    HoverBorderColor: =nfColor.Transparent
                                    HoverFill: =nfColor.Hover
                                    OnSelect: |-
                                      =Navigate(scrDetail, ScreenTransition.None, { locId: ThisItem.ID, locFrom: "list" })
                                    PressedBorderColor: =nfColor.Transparent
                                    PressedFill: =nfColor.Pressed
                                    RadiusBottomLeft: =0
                                    RadiusBottomRight: =0
                                    RadiusTopLeft: =0
                                    RadiusTopRight: =0
                                    Text: =""
                                    Tooltip: ="Open " & ThisItem.Title
                                    Width: =Parent.TemplateWidth
                        - galLstCards:
                            Control: Gallery@2.15.0
                            Variant: Vertical
                            Properties:
                              AccessibleLabel: =nfNavLabel("list")
                              Items: |-
                                =SortByColumns(
                                    Filter(
                                        colRequests,
                                        AppKey = nfApp.AppKey,
                                        RequesterEmail = nfUserEmail,
                                        IsBlank(txtLstSearch.Text) || StartsWith(Title, txtLstSearch.Text) || StartsWith(AssetTag, txtLstSearch.Text),
                                        drpLstStatus.Selected.Key = "all" || (drpLstStatus.Selected.Key = "open" && (Status = nfOpen.K1 || Status = nfOpen.K2 || Status = nfOpen.K3 || Status = nfOpen.K4)) || Status = drpLstStatus.Selected.Key
                                    ),
                                    "Modified",
                                    SortOrder.Descending
                                )
                              TemplatePadding: =0
                              TemplateSize: =nfSize.CardRow
                              Visible: =nfIsPhone
                            Children:
                              - conLstCard:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    Height: =Parent.TemplateHeight - 1
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutGap: =nfSpace.Md
                                    PaddingLeft: =nfSpace.Lg
                                    PaddingRight: =nfSpace.Lg
                                    Width: =Parent.TemplateWidth
                                  Children:
                                    - conLstCardText:
                                        Control: GroupContainer@1.5.0
                                        Variant: AutoLayout
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          DropShadow: =DropShadow.None
                                          Fill: =nfColor.Transparent
                                          Height: =60
                                          LayoutDirection: =LayoutDirection.Vertical
                                          LayoutGap: =2
                                          LayoutJustifyContent: =LayoutJustifyContent.Center
                                          LayoutMinHeight: =0
                                          LayoutMinWidth: =0
                                        Children:
                                          - lblLstCardTitle:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Stretch
                                                AutoHeight: =true
                                                Color: =nfColor.Ink
                                                FontWeight: =FontWeight.Semibold
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =ThisItem.Title
                                                Wrap: =false
                                          - lblLstCardMeta:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Stretch
                                                AutoHeight: =true
                                                Color: =nfColor.Ink2
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Small
                                                Text: =nfServiceTitle(ThisItem.ServiceKey) & " · " & Text(ThisItem.Modified, "mmm d")
                                                Wrap: =false
                                          - conLstCardPill:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Start
                                                DropShadow: =DropShadow.None
                                                Fill: =nfColor.Transparent
                                                FillPortions: =0
                                                Height: =24
                                                LayoutMinHeight: =0
                                                LayoutMinWidth: =0
                                                Width: =nfSize.Pill
                                              Children:
                                                - conLstCardPillShape:
                                                    Control: GroupContainer@1.5.0
                                                    Variant: ManualLayout
                                                    Properties:
                                                      DropShadow: =DropShadow.None
                                                      Fill: =Switch(nfStatusTone(ThisItem.Status), "Info", nfColor.InfoSoft, "Warning", nfColor.WarningSoft, "Success", nfColor.SuccessSoft, "Danger", nfColor.DangerSoft, nfColor.NeutralSoft)
                                                      Height: =24
                                                      RadiusBottomLeft: =12
                                                      RadiusBottomRight: =12
                                                      RadiusTopLeft: =12
                                                      RadiusTopRight: =12
                                                      Width: =Min(Parent.Width, Len(nfStatusLabel(ThisItem.Status)) * 7 + 24)
                                                    Children:
                                                      - lblLstCardPill:
                                                          Control: ModernText@1.0.0
                                                          Properties:
                                                            Align: =Align.Center
                                                            AutoHeight: =true
                                                            Color: =Switch(nfStatusTone(ThisItem.Status), "Info", nfColor.InfoInk, "Warning", nfColor.WarningInk, "Success", nfColor.SuccessInk, "Danger", nfColor.DangerInk, nfColor.NeutralInk)
                                                            FontWeight: =FontWeight.Semibold
                                                            PaddingBottom: =0
                                                            PaddingLeft: =8
                                                            PaddingRight: =8
                                                            PaddingTop: =0
                                                            Size: =nfType.Small
                                                            Text: =nfStatusLabel(ThisItem.Status)
                                                            Width: =Parent.Width
                                                            Wrap: =false
                                                            Y: =(Parent.Height - Self.Height) / 2
                                    - imgLstCardGo:
                                        Control: Image@2.2.3
                                        Properties:
                                          Height: =16
                                          Image: ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#565C65' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6'/></svg>")
                                          Width: =16
                              - conLstCardRule:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Line
                                    Height: =1
                                    Width: =Parent.TemplateWidth
                                    Y: =Parent.TemplateHeight - 1
                              - btnLstCardOpen:
                                  Control: Classic/Button@2.2.0
                                  Properties:
                                    BorderStyle: =BorderStyle.None
                                    BorderThickness: =0
                                    Fill: =nfColor.Transparent
                                    FocusedBorderThickness: =2
                                    Height: =Parent.TemplateHeight - 1
                                    HoverBorderColor: =nfColor.Transparent
                                    HoverFill: =nfColor.Hover
                                    OnSelect: |-
                                      =Navigate(scrDetail, ScreenTransition.None, { locId: ThisItem.ID, locFrom: "list" })
                                    PressedBorderColor: =nfColor.Transparent
                                    PressedFill: =nfColor.Pressed
                                    RadiusBottomLeft: =0
                                    RadiusBottomRight: =0
                                    RadiusTopLeft: =0
                                    RadiusTopRight: =0
                                    Text: =""
                                    Tooltip: ="Open " & ThisItem.Title
                                    Width: =Parent.TemplateWidth
                        - lblLstEmpty:
                            Control: ModernText@1.0.0
                            Properties:
                              Align: =Align.Center
                              AlignInContainer: =AlignInContainer.Stretch
                              AutoHeight: =true
                              Color: =nfColor.Ink3
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Body
                              Text: ="No " & nfItems & " match. Clear the search or choose another status."
                              Visible: |-
                                =IsEmpty(SortByColumns(
                                    Filter(
                                        colRequests,
                                        AppKey = nfApp.AppKey,
                                        RequesterEmail = nfUserEmail,
                                        IsBlank(txtLstSearch.Text) || StartsWith(Title, txtLstSearch.Text) || StartsWith(AssetTag, txtLstSearch.Text),
                                        drpLstStatus.Selected.Key = "all" || (drpLstStatus.Selected.Key = "open" && (Status = nfOpen.K1 || Status = nfOpen.K2 || Status = nfOpen.K3 || Status = nfOpen.K4)) || Status = drpLstStatus.Selected.Key
                                    ),
                                    "Modified",
                                    SortOrder.Descending
                                ))
            - conLstBottomRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Visible: =nfIsPhone
            - conLstBottomBar:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
                  FillPortions: =0
                  Height: =nfSize.BottomNav
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingLeft: =nfSpace.Sm
                  PaddingRight: =nfSpace.Sm
                  Visible: =nfIsPhone
                Children:
                  - cmpLstBottomNav:
                      Control: CanvasComponent
                      ComponentName: cmpBottomNav
                      Properties:
                        ActiveKey: ="list"
                        AlignInContainer: =AlignInContainer.Stretch
                        FillPortions: =1
                        IsStaff: =gblIsStaff
                        Items: =nfNavMain
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        OnSelect: =nfGo(Self.SelectedKey)
                        Theme: =nfColor
      - conLstLoading:
          Control: GroupContainer@1.5.0
          Variant: ManualLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Scrim
            Height: =Parent.Height
            Visible: =locLoading
            Width: =Parent.Width
          Children:
            - conLstLoadingCard:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
