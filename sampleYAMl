            - conHdrBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Width: =Parent.Width
                Children:
                  - conHdrGutter:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Xl
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        LayoutOverflowY: =LayoutOverflow.Scroll
                        PaddingBottom: =nfSpace.Xxl
                        PaddingLeft: =nfSpace.Xxl
                        PaddingRight: =nfSpace.Xxl
                        PaddingTop: =nfSpace.Xxl
                        Width: =Parent.Width
                      Children:
                        - conHdrCrumb:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: =nfHeights.crumb
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Width: =nfPageW
                            Children:
                              - btnHdrCrumb0:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Appearance: =ButtonAppearance.Transparent
                                    Height: =24
                                    OnSelect: =Navigate(scrIgceHome, ScreenTransition.None)
                                    Size: =nfType.Small
                                    Text: ="Estimates"
                                    Width: =Len("Estimates") * 7 + 24
                              - lblHdrSep1:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Color: =nfColor.Ink2
                                    Height: =20
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="/"
                                    Width: =10
                                    Wrap: =false
                              - btnHdrCrumb1:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Appearance: =ButtonAppearance.Transparent
                                    Height: =24
                                    OnSelect: =Navigate(scrIgceRequirement, ScreenTransition.None)
                                    Size: =nfType.Small
                                    Text: =nfIgcePRLabel(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id)
                                    Width: =Len(nfIgcePRLabel(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id)) * 7 + 24
                              - lblHdrSep2:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Color: =nfColor.Ink2
                                    Height: =20
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="/"
                                    Width: =10
                                    Wrap: =false
                              - lblHdrCrumb2:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Color: =nfColor.Ink2
                                    Height: =20
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="Revision " & LookUp(colIGCEHeader, ID = gblIgceHeaderID).Revision
                                    Width: =220
                                    Wrap: =false
                        - cmpHdrStepper:
                            Control: CanvasComponent
                            ComponentName: cmpStepper
                            Properties:
                              AccentColor: =nfColor.Navy
                              AlignInContainer: =AlignInContainer.Center
                              CheckIcon: =Blank()
                              ClickableSteps: ="All"
                              CurrentStep: =nfIgceStepIndex("header", LookUp(colIGCEHeader, ID = gblIgceHeaderID).ContainsGFP)
                              Density: ="Full"
                              Height: |-
                                =If(
                                    Self.Type = "Bar",
                                    Switch(Self.Size, "Small", 4, "Medium", 6, "Large", 8, 6),
                                    If(
                                        Self.Density = "Full",
                                        Switch(Self.Size, "Small", 60, "Medium", 72, "Large", 86, 72),
                                        Switch(Self.Size, "Small", 26, "Medium", 32, "Large", 40, 32)
                                    )
                                )
                              OnStepSelect: =nfIgceStepNav(Self.SelectedStep, LookUp(colIGCEHeader, ID = gblIgceHeaderID).ContainsGFP)
                              Size: ="Medium"
                              StepLabels: |-
                                =ForAll(
                                    Split(nfIgceStepLabels(LookUp(colIGCEHeader, ID = gblIgceHeaderID).ContainsGFP), "|") As s,
                                    { Label: s.Value }
                                )
                              Theme: ="Light"
                              Type: ="Step"
                              Width: =nfPageW
                        - lblHdrTitle:
                            Control: ModernText@1.0.0
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              Color: =nfColor.Ink
                              FontWeight: =FontWeight.Semibold
                              Height: =nfHeights.h2
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.H2
                              Text: ="IGCE header"
                              Width: =nfPageW
                              Wrap: =false
                        - lblHdrLead:
                            Control: ModernText@1.0.0
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              AutoHeight: =true
                              Color: =nfColor.Ink2
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Body
                              Text: ="Requirement details come from the Requirement Tracker. Rates set here apply to every line in the estimate."
                              Width: =nfPageW
                        - conHdrNoteIndep:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              BorderColor: =nfColor.Warn
                              BorderThickness: =1
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.WarnBg
                              FillPortions: =0
                              Height: =lblHdrNoteIndep.Height + nfSpace.Md * 2
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              PaddingBottom: =nfSpace.Md
                              PaddingLeft: =nfSpace.Lg
                              PaddingRight: =nfSpace.Lg
                              PaddingTop: =nfSpace.Md
                              RadiusBottomLeft: =6
                              RadiusBottomRight: =6
                              RadiusTopLeft: =6
                              RadiusTopRight: =6
                              Width: =nfPageW
                            Children:
                              - lblHdrNoteIndep:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Body
                                    Text: ="Independence required. A contractor likely to submit a proposal or quote cannot directly or indirectly provide data or input to this estimate."
                                    Width: =Parent.Width
                        - lblHdrSecReq:
                            Control: ModernText@1.0.0
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              Color: =nfColor.Ink
                              FontWeight: =FontWeight.Semibold
                              Height: =nfHeights.h3
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.H3
                              Text: ="Requirement"
                              Width: =nfPageW
                              Wrap: =false
                        - conHdrReqGrid:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: =(18 + nfSpace.Xs + nfHeights.input) * 2 + nfSpace.Lg
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Lg
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              LayoutWrap: =true
                              Width: =nfPageW
                            Children:
                              - conHdrFPR:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Start
                                    DropShadow: =DropShadow.None
                                    FillPortions: =0
                                    Height: =18 + nfSpace.Xs + nfHeights.input
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    Width: =220
                                  Children:
                                    - lblHdrFPR:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =18
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="PR number"
                                          Width: =Parent.Width
                                          Wrap: =false
                                    - lblHdrVPR:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink
                                          Height: =nfHeights.input
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =First(colIGCEHeaderEdit).PRTrackerNumber
                                          Width: =Parent.Width
                                          Wrap: =false
                              - conHdrFName:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Start
                                    DropShadow: =DropShadow.None
                                    FillPortions: =0
                                    Height: =18 + nfSpace.Xs + nfHeights.input
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    Width: =220
                                  Children:
                                    - lblHdrFName:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =18
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="Requirement name"
                                          Width: =Parent.Width
                                          Wrap: =false
                                    - lblHdrVName:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink
                                          Height: =nfHeights.input
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =nfIgceReqNameOf(First(colIGCEHeaderEdit).PRTrackerID.Id)
                                          Width: =Parent.Width
                                          Wrap: =false
                              - conHdrFRev:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Start
                                    DropShadow: =DropShadow.None
                                    FillPortions: =0
                                    Height: =18 + nfSpace.Xs + nfHeights.input
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    Width: =220
                                  Children:
                                    - lblHdrFRev:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =18
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="Revision"
                                          Width: =Parent.Width
                                          Wrap: =false
                                    - lblHdrVRev:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink
                                          Height: =nfHeights.input
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =First(colIGCEHeaderEdit).Revision
                                          Width: =Parent.Width
                                          Wrap: =false
                              - conHdrFType:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Start
                                    DropShadow: =DropShadow.None
                                    FillPortions: =0
                                    Height: =18 + nfSpace.Xs + nfHeights.input
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutGap: =nfSpace.Xs
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    Width: =220
                                  Children:
                                    - lblHdrFType:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =18
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: ="IGCE type"
                                          Width: =Parent.Width
                                          Wrap: =false
                                    - cboHdrType:
                                        Control: ModernCombobox@1.1.2
                                        Properties:
                                          AccessibleLabel: ="IGCE type"
                                          AlignInContainer: =AlignInContainer.Stretch
                                          AllowExternalSelectedItems: =false
                                          Appearance: =Appearance.Outline
                                          Color: =nfColor.Ink
                                          DefaultSelectedItems: =Filter(nfChoiceIGCEType, Value = First(colIGCEHeaderEdit).IGCEType.Value)
                                          DisplayMode: =If(nfIgceIsReadOnly(gblIgceHeaderID), DisplayMode.View, DisplayMode.Edit)
                                          Height: =nfHeights.input
                                          InputTextPlaceholder: ="Select a type"
                                          IsSearchable: =false
                                          ItemDisplayText: =ThisItem.Value
                                          Items: =nfChoiceIGCEType
                                          OnChange: |-
                                            =Patch(
                                                colIGCEHeaderEdit,
