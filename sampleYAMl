                        LayoutMinWidth: =0
                        RadiusBottomLeft: =20
                        RadiusBottomRight: =20
                        RadiusTopLeft: =20
                        RadiusTopRight: =20
                        Width: =40
                      Children:
                        - lblHdrInitials:
                            Control: ModernText@1.0.0
                            Properties:
                              AccessibleLabel: =User().FullName
                              Align: =Align.Center
                              Color: =nfColor.White
                              FontWeight: =FontWeight.Bold
                              Height: =Parent.Height
