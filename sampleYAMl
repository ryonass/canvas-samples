      - cmpDtlConfirm:
          Control: CanvasComponent
          ComponentName: cmpConfirmDialog
          Properties:
            CancelLabel: ="Go back"
            ConfirmLabel: =locConfirm.Label
            Height: =Parent.Height
            IsDanger: =locConfirm.Danger
            IsPhone: =nfIsPhone
            Message: =locConfirm.Message
            OnCancel: |-
              =UpdateContext({ locConfirm: Blank() })
            OnConfirm: |-
              =With(
                  { t: LookUp(nfTransitions, Key = locConfirm.Action) },
                  If(t.AssignToMe, nfAssignToMe(locId));
                  If(!IsBlank(t.ToStatus), nfSetStatus(locId, t.ToStatus, t.History))
              );
              UpdateContext({ locConfirm: Blank(), locItem: LookUp(colRequests, ID = locId) });
              UpdateContext({ locActions: ForAll(
                  Distinct(
                      Filter(
                          nfTransitions,
                          ";" & locItem.Status & ";" in From,
                          (Role = "Staff" && gblIsStaff) || (Role = "Owner" && locItem.RequesterEmail = nfUserEmail),
                          !OnlyIfUnassigned || IsBlank(locItem.AssignedTo)
                      ),
                      Key
                  ) As k,
                  LookUp(nfTransitions, Key = k.Value)
              ) });
              Notify(nfItemCap & " updated.", NotificationType.Success)
            Theme: =nfColor
            Title: =locConfirm.Title
            Visible: =!IsBlank(locConfirm)
            Width: =Parent.Width
