Screens:
  scrDetail:
    Properties:
      Fill: =nfColor.Page
      OnVisible: |-
        =UpdateContext({ locLoading: true });
        UpdateContext({ locItem: LookUp(colRequests, ID = locId), locConfirm: Blank() });
        UpdateContext({ locActions: ForAll(
            Distinct(
                Filter(
                    nfTransitions,
                    ";" & locItem.Status & ";" in From,
                    (Role = "Staff" && gblIsStaff) || (Role = "Owner" && locItem.RequesterEmail = nfUserEmail),
                    !OnlyIfUnassigned || IsBlank(locItem.AssignedTo)
                ),
                Key
            ) As k,
            LookUp(nfTransitions, Key = k.Value)
        ) });
        UpdateContext({ locLoading: false })
    Children:
      - conDtlRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmpDtlHeader:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: =If(locFrom = "queue", "queue", "list")
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  HubUrl: =nfApp.HubUrl
                  IsStaff: =gblIsStaff
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Logo: =nfLogo
                  OnHubSelect: =Launch(nfApp.HubUrl)
                  OnNavSelect: =nfGo(Self.SelectedKey)
                  OnRightAction: =false
                  RightActionLabel: =""
                  ShowHubLink: =!IsBlank(nfApp.HubUrl)
                  Theme: =nfColor
                  Title: =nfApp.Name
                  UserImage: =User().Image
                  WelcomeName: =nfUserName
            - conDtlHeaderRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - conDtlBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  LayoutOverflowY: =LayoutOverflow.Scroll
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =nfGutter
                  PaddingRight: =nfGutter
                  PaddingTop: =nfSpace.Xl
                Children:
                  - conDtlCrumb:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =nfSize.Control
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - btnDtlBack:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: ="Back to " & nfNavLabel(If(locFrom = "queue", "queue", "list"))
                              Appearance: =ButtonAppearance.Transparent
                              Color: =nfColor.Primary
                              Height: =nfSize.Control
                              Icon: ="ArrowLeft"
                              OnSelect: |-
                                =If(locFrom = "queue", Navigate(scrQueue, ScreenTransition.None), Navigate(scrList, ScreenTransition.None, { locStatusFilter: "all" }))
                              Size: =nfType.Body
                              Text: =nfNavLabel(If(locFrom = "queue", "queue", "list"))
                              Width: =150
                  - conDtlMissing:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        FillPortions: =0
                        Height: =96
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Sm
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        PaddingBottom: =nfSpace.Xl
                        PaddingLeft: =nfSpace.Xl
                        PaddingRight: =nfSpace.Xl
                        PaddingTop: =nfSpace.Xl
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Visible: =IsBlank(locItem)
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - lblDtlMissingTitle:
                            Control: ModernText@1.0.0
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              AutoHeight: =true
                              Color: =nfColor.Ink
                              FontWeight: =FontWeight.Semibold
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.H2
                              Text: =nfItemCap & " not found"
                        - lblDtlMissingBody:
                            Control: ModernText@1.0.0
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              AutoHeight: =true
                              Color: =nfColor.Ink2
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Body
                              Text: ="It may have been removed, or the link is out of date."
                  - conDtlHead:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =54
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =!IsBlank(locItem)
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conDtlTitleText:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              Height: =54
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - lblDtlTitle:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.H1
                                    Text: =locItem.Title
                                    Wrap: =false
                              - lblDtlSub:
                                  Control: ModernText@1.0.0
                                  Properties:
