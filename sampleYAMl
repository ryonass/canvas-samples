                              - lbl_SmQtyCalc4_Details:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Align: =Align.Left
                                    Color: =RGBA(97, 97, 97, 1)
                                    Height: =44
                                    PaddingBottom: =0
                                    PaddingLeft: =4
                                    PaddingRight: =4
                                    PaddingTop: =0
                                    Size: =14
                                    Text: =Coalesce(num_SmQty0_Details.Value, 0)
                                    VerticalAlign: =VerticalAlign.Middle
                                    Visible: =Coalesce(rad_SmCalc_Details.Selected.V, false) && lbl_HdrCalcOPs_Details.Visible
                                    Width: =130
                                    Wrap: =false
                                    X: =130
                              - num_SmRate4_Details:
                                  Control: ModernNumberInput@1.1.2
                                  Properties:
                                    AccessibleLabel: ="Option Period 4 rate"
                                    Appearance: =Appearance.Outline
                                    Color: =nf_DHSBlue
                                    Default: =locSubEdit.OP4Rate
                                    DisplayMode: =If(gl_FormMode = FormMode.View, DisplayMode.View, DisplayMode.Edit)
                                    Height: =32
                                    HintText: ="0"
                                    Max: =1000000
                                    Min: =0
                                    Size: =14
                                    Visible: =!(Coalesce(rad_SmCalc_Details.Selected.V, false) && lbl_HdrCalcOPs_Details.Visible)
                                    Width: =130
                                    X: =270
                                    Y: =6
                              - lbl_SmRateCalc4_Details:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Align: =Align.Left
                                    Color: =RGBA(97, 97, 97, 1)
                                    Height: =44
                                    PaddingBottom: =0
                                    PaddingLeft: =4
                                    PaddingRight: =4
                                    PaddingTop: =0
                                    Size: =14
                                    Text: |-
                                      =Text(Round(Coalesce(num_SmRate0_Details.Value, 0) * (1 + Coalesce(gl_IGCE.'Inflation Rate', 0)) ^ 4, 2), "#,##0.00")
                                    VerticalAlign: =VerticalAlign.Middle
                                    Visible: =Coalesce(rad_SmCalc_Details.Selected.V, false) && lbl_HdrCalcOPs_Details.Visible
                                    Width: =130
                                    Wrap: =false
                                    X: =270
                              - lbl_SmCost4_Details:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Align: =Align.Right
                                    Color: =nf_DHSBlue
                                    Height: =44
                                    PaddingBottom: =0
                                    PaddingLeft: =4
                                    PaddingRight: =4
                                    PaddingTop: =0
                                    Size: =14
                                    Text: |-
                                      =Text(
                                          (If(Coalesce(rad_SmCalc_Details.Selected.V, false) && lbl_HdrCalcOPs_Details.Visible, Coalesce(num_SmQty0_Details.Value, 0), Coalesce(num_SmQty4_Details.Value, 0))) *
                                          (If(Coalesce(rad_SmCalc_Details.Selected.V, false) && lbl_HdrCalcOPs_Details.Visible, Round(Coalesce(num_SmRate0_Details.Value, 0) * (1 + Coalesce(gl_IGCE.'Inflation Rate', 0)) ^ 4, 2), Coalesce(num_SmRate4_Details.Value, 0))),
                                          "#,##0.00"
                                      )
                                    VerticalAlign: =VerticalAlign.Middle
                                    Width: =130
                                    Wrap: =false
                                    X: =410
                              - lbl_SmTotal4_Details:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Align: =Align.Right
                                    Color: =nf_DHSBlue
                                    Height: =44
                                    PaddingBottom: =0
                                    PaddingLeft: =4
                                    PaddingRight: =4
                                    PaddingTop: =0
                                    Size: =14
                                    Text: |-
                                      =Text(
                                          (If(Coalesce(rad_SmCalc_Details.Selected.V, false) && lbl_HdrCalcOPs_Details.Visible, Coalesce(num_SmQty0_Details.Value, 0), Coalesce(num_SmQty4_Details.Value, 0))) *
                                          (If(Coalesce(rad_SmCalc_Details.Selected.V, false) && lbl_HdrCalcOPs_Details.Visible, Round(Coalesce(num_SmRate0_Details.Value, 0) * (1 + Coalesce(gl_IGCE.'Inflation Rate', 0)) ^ 4, 2), Coalesce(num_SmRate4_Details.Value, 0))) *
                                          If(
                                              cmp_Labor_Details.Value && gl_IGCE.'IGCE Type'.Value = "Cost Reimbursement",
                                              1 + gl_IGCE.'Fringe Rate' + (1 + gl_IGCE.'Fringe Rate') * (gl_IGCE.'Overhead Rate' + gl_IGCE.'G & A Rate' + gl_IGCE.'FCCOM Rate'),
                                              1
                                          ),
                                          "#,##0.00"
                                      )
                                    VerticalAlign: =VerticalAlign.Middle
                                    Visible: =cmp_Labor_Details.Value && gl_IGCE.'IGCE Type'.Value = "Cost Reimbursement"
                                    Width: =130
                                    Wrap: =false
                                    X: =550
                  - con_SmFoot_Details:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =40
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =12
                        LayoutJustifyContent: =LayoutJustifyContent.End
                      Children:
                        - btn_SmCancel_Details:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: =Self.Text
                              Appearance: =ButtonAppearance.Secondary
                              Color: =nf_DHSBlue
                              FillPortions: =0
                              FontWeight: =FontWeight.Semibold
                              Height: =32
                              OnSelect: |-
                                =Reset(txt_SmRef_Details);
                                Reset(txt_SmDesc_Details);
                                Reset(txt_SmSerial_Details);
                                Reset(cmb_SmType_Details);
                                Reset(cmb_SmUnits_Details);
                                Reset(cmb_SmOdc_Details);
                                Reset(cmb_SmPropType_Details);
                                Reset(rad_SmCalc_Details);
                                Reset(rad_SmSoftware_Details);
                                Reset(rad_SmIncludes_Details);
                                Reset(num_SmQty0_Details);
                                Reset(num_SmRate0_Details);
                                Reset(num_SmQty1_Details);
                                Reset(num_SmRate1_Details);
                                Reset(num_SmQty2_Details);
                                Reset(num_SmRate2_Details);
                                Reset(num_SmQty3_Details);
                                Reset(num_SmRate3_Details);
                                Reset(num_SmQty4_Details);
                                Reset(num_SmRate4_Details);
                                UpdateContext({locSubModalOpen: false})
                              Text: =If(gl_FormMode = FormMode.View, "Close", "Cancel")
                              Width: =120
                        - btn_SmSave_Details:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: =Self.Text
                              DisplayMode: |-
                                =If(
                                    IsBlank(Trim(txt_SmDesc_Details.Text)) || IsBlank(num_SmQty0_Details.Value) || IsBlank(num_SmRate0_Details.Value),
                                    DisplayMode.Disabled,
                                    DisplayMode.Edit
                                )
                              FillPortions: =0
                              FontWeight: =FontWeight.Semibold
                              Height: =32
                              OnSelect: |-
                                =With(
                                    {
                                        wCalc: Coalesce(rad_SmCalc_Details.Selected.V, false) && lbl_HdrCalcOPs_Details.Visible,
                                        wQ0: Coalesce(num_SmQty0_Details.Value, 0),
                                        wR0: Coalesce(num_SmRate0_Details.Value, 0),
                                        wInfl: Coalesce(gl_IGCE.'Inflation Rate', 0),
                                        wForced: gl_IGCELine.Category.Value in ["Capitalized Equipment", "Accountable Property"]
                                    },
                                    Patch(
                                        [@IGCESubLine_IGCE_SPList],
                                        If(locSubEditID = 0, Defaults([@IGCESubLine_IGCE_SPList]), LookUp([@IGCESubLine_IGCE_SPList], ID = locSubEditID)),
                                        {
                                            'Ref #': txt_SmRef_Details.Text,
                                            Title: txt_SmDesc_Details.Text,
                                            SublineType: {Value: cmb_SmType_Details.Selected.Value},
                                            Units: If(cmp_Labor_Details.Value, {Value: "HR"}, {Value: cmb_SmUnits_Details.Selected.Value}),
                                            ODCCategory: {Value: cmb_SmOdc_Details.Selected.Value},
                                            'Software License/Subscription': Coalesce(rad_SmSoftware_Details.Selected.V, false),
                                            IncludesProperty: If(wForced, true, Coalesce(rad_SmIncludes_Details.Selected.V, false)),
                                            PropertyType: If(wForced, {Value: "Accountable"}, {Value: cmb_SmPropType_Details.Selected.Value}),
                                            SerialNumber: txt_SmSerial_Details.Text,
                                            BaseYearQuantity: wQ0,
                                            BaseYearRate: wR0,
                                            'Calc OPs': wCalc,
                                            OP1Quantity: If(!con_SmPer1_Details.Visible, 0, wCalc, wQ0, Coalesce(num_SmQty1_Details.Value, 0)),
                                            OP1Rate: If(!con_SmPer1_Details.Visible, 0, wCalc, Round(wR0 * (1 + wInfl) ^ 1, 2), Coalesce(num_SmRate1_Details.Value, 0)),
                                            OP2Quantity: If(!con_SmPer2_Details.Visible, 0, wCalc, wQ0, Coalesce(num_SmQty2_Details.Value, 0)),
                                            OP2Rate: If(!con_SmPer2_Details.Visible, 0, wCalc, Round(wR0 * (1 + wInfl) ^ 2, 2), Coalesce(num_SmRate2_Details.Value, 0)),
                                            OP3Quantity: If(!con_SmPer3_Details.Visible, 0, wCalc, wQ0, Coalesce(num_SmQty3_Details.Value, 0)),
                                            OP3Rate: If(!con_SmPer3_Details.Visible, 0, wCalc, Round(wR0 * (1 + wInfl) ^ 3, 2), Coalesce(num_SmRate3_Details.Value, 0)),
                                            OP4Quantity: If(!con_SmPer4_Details.Visible, 0, wCalc, wQ0, Coalesce(num_SmQty4_Details.Value, 0)),
                                            OP4Rate: If(!con_SmPer4_Details.Visible, 0, wCalc, Round(wR0 * (1 + wInfl) ^ 4, 2), Coalesce(num_SmRate4_Details.Value, 0)),
                                            IGCELine: {
                                                '@odata.type': "#Microsoft.Azure.Connectors.SharePoint.SPListExpandedReference",
                                                Id: gl_IGCELine.ID,
                                                Value: gl_IGCELine.Title
                                            },
                                            IGCELineID: gl_IGCELine.ID
                                        }
                                    )
                                );
                                With(
                                    {
                                        wSubs: Filter([@IGCESubLine_IGCE_SPList], IGCELineID = gl_IGCELine.ID),
                                        wF: If(
                                            cmp_Labor_Details.Value && gl_IGCE.'IGCE Type'.Value = "Cost Reimbursement",
                                            1 + gl_IGCE.'Fringe Rate' + (1 + gl_IGCE.'Fringe Rate') * (gl_IGCE.'Overhead Rate' + gl_IGCE.'G & A Rate' + gl_IGCE.'FCCOM Rate'),
                                            1
                                        )
                                    },
                                    Set(
                                        gl_IGCELine,
                                        Patch(
                                            [@IGCELine_IGCE_SPList],
                                            gl_IGCELine,
                                            {
                                                Labor: cmp_Labor_Details.Value,
                                                Category: cmp_Category_Details.Value,
                                                'Base Year Cost': Sum(wSubs, BaseYearQuantity * BaseYearRate) * wF,
                                                'Base Year Hours/Quantity': Sum(wSubs, BaseYearQuantity),
                                                'Option Period 1 Cost': Sum(wSubs, OP1Quantity * OP1Rate) * wF,
                                                'Option Period 1 Hours/Quantity': Sum(wSubs, OP1Quantity),
                                                'Option Period 2 Cost': Sum(wSubs, OP2Quantity * OP2Rate) * wF,
                                                'Option Period 2 Hours/Quantity': Sum(wSubs, OP2Quantity),
                                                'Option Period 3 Cost': Sum(wSubs, OP3Quantity * OP3Rate) * wF,
                                                'Option Period 3 Hours/Quantity': Sum(wSubs, OP3Quantity),
                                                'Option Period 4 Cost': Sum(wSubs, OP4Quantity * OP4Rate) * wF,
                                                'Option Period 4 Hours/Quantity': Sum(wSubs, OP4Quantity),
                                                AccountablePropertyTotal: Sum(
                                                    Filter(wSubs, IncludesProperty && PropertyType.Value = "Accountable"),
                                                    BaseYearQuantity * BaseYearRate + OP1Quantity * OP1Rate + OP2Quantity * OP2Rate + OP3Quantity * OP3Rate + OP4Quantity * OP4Rate
                                                )
                                            }
                                        )
                                    )
                                );
                                If(
                                    IsEmpty(Errors([@IGCESubLine_IGCE_SPList])) && IsEmpty(Errors([@IGCELine_IGCE_SPList])),
                                    Notify("Subline saved", NotificationType.Success);
                                    Reset(txt_SmRef_Details);
                                    Reset(txt_SmDesc_Details);
                                    Reset(txt_SmSerial_Details);
                                    Reset(cmb_SmType_Details);
                                    Reset(cmb_SmUnits_Details);
                                    Reset(cmb_SmOdc_Details);
                                    Reset(cmb_SmPropType_Details);
                                    Reset(rad_SmCalc_Details);
                                    Reset(rad_SmSoftware_Details);
                                    Reset(rad_SmIncludes_Details);
                                    Reset(num_SmQty0_Details);
                                    Reset(num_SmRate0_Details);
                                    Reset(num_SmQty1_Details);
                                    Reset(num_SmRate1_Details);
                                    Reset(num_SmQty2_Details);
                                    Reset(num_SmRate2_Details);
                                    Reset(num_SmQty3_Details);
                                    Reset(num_SmRate3_Details);
                                    Reset(num_SmQty4_Details);
                                    Reset(num_SmRate4_Details);
                                    UpdateContext({locSubModalOpen: false}),
                                    Notify("The subline was not saved. Check the fields and try again.", NotificationType.Error)
                                )
                              Text: ="Save"
                              Visible: =gl_FormMode <> FormMode.View
                              Width: =120
