                            Variant: Vertical
                            Properties:
                              AccessibleLabel: =nfNavLabel("list")
                              Items: |-
                                =SortByColumns(
                                    Filter(
                                        colRequests,
                                        RequesterEmail = nfUserEmail,
                                        IsBlank(txtLstSearch.Text) || StartsWith(Title, txtLstSearch.Text) || StartsWith(AssetTag, txtLstSearch.Text),
                                        drpLstStatus.Selected.Key = "all" || (drpLstStatus.Selected.Key = "open" && IsOpen = true) || Status = drpLstStatus.Selected.Key
                                    ),
                                    "Modified",
                                    SortOrder.Descending
                                )
                              TemplatePadding: =0
                              TemplateSize: =nfSize.CardRow
                              Visible: |-
                                =nfIsPhone && !IsEmpty(SortByColumns(
                                    Filter(
                                        colRequests,
                                        RequesterEmail = nfUserEmail,
                                        IsBlank(txtLstSearch.Text) || StartsWith(Title, txtLstSearch.Text) || StartsWith(AssetTag, txtLstSearch.Text),
                                        drpLstStatus.Selected.Key = "all" || (drpLstStatus.Selected.Key = "open" && IsOpen = true) || Status = drpLstStatus.Selected.Key
                                    ),
                                    "Modified",
                                    SortOrder.Descending
                                ))
                            Children:
                              - conLstCard:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    Height: =Parent.TemplateHeight - 1
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutGap: =nfSpace.Md
                                    PaddingLeft: =nfSpace.Lg
                                    PaddingRight: =nfSpace.Lg
                                    Width: =Parent.TemplateWidth
                                  Children:
                                    - conLstCardText:
                                        Control: GroupContainer@1.5.0
                                        Variant: AutoLayout
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          DropShadow: =DropShadow.None
                                          Fill: =nfColor.Transparent
                                          Height: =60
                                          LayoutDirection: =LayoutDirection.Vertical
                                          LayoutGap: =2
                                          LayoutJustifyContent: =LayoutJustifyContent.Center
                                          LayoutMinHeight: =0
                                          LayoutMinWidth: =0
                                        Children:
                                          - lblLstCardTitle:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Stretch
                                                AutoHeight: =true
                                                Color: =nfColor.Ink
                                                FontWeight: =FontWeight.Semibold
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =ThisItem.Title
                                                Wrap: =false
                                          - lblLstCardMeta:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Stretch
                                                AutoHeight: =true
                                                Color: =nfColor.Ink2
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Small
                                                Text: =nfServiceTitle(ThisItem.ServiceKey) & " · " & Text(ThisItem.Modified, "mmm d")
                                                Wrap: =false
                                          - conLstCardPill:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Start
                                                DropShadow: =DropShadow.None
                                                Fill: =nfColor.Transparent
                                                FillPortions: =0
                                                Height: =24
                                                LayoutMinHeight: =0
                                                LayoutMinWidth: =0
                                                Width: =nfSize.Pill
                                              Children:
                                                - conLstCardPillShape:
                                                    Control: GroupContainer@1.5.0
                                                    Variant: ManualLayout
                                                    Properties:
                                                      DropShadow: =DropShadow.None
                                                      Fill: =LookUp(nfTone, Tone = nfStatusTone(ThisItem.Status)).Fill
                                                      Height: =24
                                                      RadiusBottomLeft: =12
                                                      RadiusBottomRight: =12
                                                      RadiusTopLeft: =12
                                                      RadiusTopRight: =12
                                                      Width: =Min(Parent.Width, Len(nfStatusLabel(ThisItem.Status)) * 7 + 24)
                                                    Children:
                                                      - lblLstCardPill:
                                                          Control: ModernText@1.0.0
                                                          Properties:
                                                            Align: =Align.Center
                                                            AutoHeight: =true
                                                            Color: =LookUp(nfTone, Tone = nfStatusTone(ThisItem.Status)).Ink
                                                            FontWeight: =FontWeight.Semibold
                                                            PaddingBottom: =0
                                                            PaddingLeft: =8
                                                            PaddingRight: =8
                                                            PaddingTop: =0
                                                            Size: =nfType.Small
                                                            Text: =nfStatusLabel(ThisItem.Status)
                                                            Width: =Parent.Width
                                                            Wrap: =false
                                                            Y: =(Parent.Height - Self.Height) / 2
                                    - imgLstCardGo:
                                        Control: Image@2.2.3
                                        Properties:
                                          Height: =16
                                          Image: ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5A5B5D' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6'/></svg>")
                                          Width: =16
                              - conLstCardRule:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Line
                                    Height: =1
                                    Width: =Parent.TemplateWidth
                                    Y: =Parent.TemplateHeight - 1
                              - btnLstCardOpen:
                                  Control: Classic/Button@2.2.0
                                  Properties:
                                    BorderStyle: =BorderStyle.None
                                    BorderThickness: =0
                                    Fill: =nfColor.Transparent
                                    FocusedBorderThickness: =2
                                    Height: =Parent.TemplateHeight - 1
                                    HoverBorderColor: =nfColor.Transparent
                                    HoverFill: =nfColor.Hover
                                    OnSelect: |-
                                      =Navigate(scrDetail, ScreenTransition.None, { locId: ThisItem.ID, locFrom: "list" })
                                    PressedBorderColor: =nfColor.Transparent
                                    PressedFill: =nfColor.Pressed
                                    RadiusBottomLeft: =0
                                    RadiusBottomRight: =0
                                    RadiusTopLeft: =0
                                    RadiusTopRight: =0
                                    Text: =""
                                    Tooltip: ="Open " & ThisItem.Title
                                    Width: =Parent.TemplateWidth
                        - cmpLstEmpty:
                            Control: CanvasComponent
                            ComponentName: cmpStatePanel
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              FillPortions: =1
                              IsPhone: =nfIsPhone
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Message: =If(IsEmpty(nfMyRequests), "When you submit a " & nfItem & ", it shows here.", "Clear the search, or choose another status.")
                              OnPrimary: |-
                                =If(
                                    IsEmpty(nfMyRequests),
                                    nfGo("form"),
                                    UpdateContext({ locStatusFilter: "all" });
                                    Reset(txtLstSearch);
                                    Reset(drpLstStatus)
                                )
                              OnSecondary: =false
                              PrimaryText: =If(IsEmpty(nfMyRequests), "New " & nfItem, "Clear filters")
                              SecondaryText: =""
                              Theme: =nfColor
                              Title: =If(IsEmpty(nfMyRequests), "No " & nfItems & " yet", "No " & nfItems & " match")
                              Variant: ="Empty"
                              Visible: |-
                                =IsEmpty(SortByColumns(
                                    Filter(
                                        colRequests,
                                        RequesterEmail = nfUserEmail,
                                        IsBlank(txtLstSearch.Text) || StartsWith(Title, txtLstSearch.Text) || StartsWith(AssetTag, txtLstSearch.Text),
                                        drpLstStatus.Selected.Key = "all" || (drpLstStatus.Selected.Key = "open" && IsOpen = true) || Status = drpLstStatus.Selected.Key
                                    ),
                                    "Modified",
                                    SortOrder.Descending
                                ))
            - conLstBottomRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Visible: =nfIsPhone
            - conLstBottomBar:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
                  FillPortions: =0
                  Height: =nfSize.BottomNav
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingLeft: =nfSpace.Sm
                  PaddingRight: =nfSpace.Sm
                  Visible: =nfIsPhone
                Children:
                  - cmpLstBottomNav:
                      Control: CanvasComponent
                      ComponentName: cmpBottomNav
                      Properties:
                        ActiveKey: ="list"
                        AlignInContainer: =AlignInContainer.Stretch
                        FillPortions: =1
                        IsStaff: =gblIsStaff
                        Items: =nfNavMain
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        OnSelect: =nfGo(Self.SelectedKey)
                        Theme: =nfColor
      - conLstLoading:
          Control: GroupContainer@1.5.0
          Variant: ManualLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Scrim
            Height: =Parent.Height
            Visible: =locLoading
            Width: =Parent.Width
          Children:
            - conLstLoadingCard:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
                  Height: =56
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutJustifyContent: =LayoutJustifyContent.Center
                  RadiusBottomLeft: =nfRadius.Md
                  RadiusBottomRight: =nfRadius.Md
                  RadiusTopLeft: =nfRadius.Md
                  RadiusTopRight: =nfRadius.Md
                  Width: =200
                  X: =(Parent.Width - Self.Width) / 2
                  Y: =(Parent.Height - Self.Height) / 2
                Children:
                  - lblLstLoading:
                      Control: ModernText@1.0.0
                      Properties:
                        Align: =Align.Center
                        AutoHeight: =true
                        Color: =nfColor.Ink
                        FontWeight: =FontWeight.Semibold
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.Body
                        Text: ="Loading..."
                        Width: =120
