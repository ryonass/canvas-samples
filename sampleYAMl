Screens:
  scrIgceLines:
    Properties:
      Fill: =nfColor.Paper
      OnVisible: |-
        =UpdateContext({ locLineID: Coalesce(locLineID, First(SortByColumns(Filter(colIGCELine, IGCEHeaderID = gblIgceHeaderID), "LineNumber")).ID) });
        UpdateContext({ locModal: "", locSubEditID: 0 });
        nfIGCEValidate(gblIgceHeaderID)
    Children:
      - conLinRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Height: =Parent.Height
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - conLinTopBar:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Navy
                  FillPortions: =0
                  Height: =nfHeights.topBar
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =nfSpace.Lg
                  LayoutMaxHeight: =nfHeights.topBar
                  LayoutMinHeight: =nfHeights.topBar
                  LayoutMinWidth: =0
                  PaddingLeft: =nfSpace.Xl
                  PaddingRight: =nfSpace.Xl
                  Width: =Parent.Width
                Children:
                  - lblLinAppName:
                      Control: ModernText@1.0.0
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        Color: =nfColor.NavyInk
                        FontWeight: =FontWeight.Semibold
                        Height: =nfHeights.topBar
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.H3
                        Text: |-
                          ="PR: " & nfIgcePRLabel(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id) & " | IGCE"
                        Width: |-
                          =Len("PR: " & nfIgcePRLabel(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id) & " | IGCE") * 9 + 16
                        Wrap: =false
                  - lblLinMeta:
                      Control: ModernText@1.0.0
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        Color: =nfColor.NavyInk
                        Height: =nfHeights.topBar
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.Small
                        Text: |-
                          =nfIgceReqNameOf(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id)
                          & "  |  Revision "
                          & LookUp(colIGCEHeader, ID = gblIgceHeaderID).Revision
                        Visible: =nfIsDesktop
                        Width: =360
                        Wrap: =false
                  - conLinBarSpacer:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                  - conLinPill0:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        BorderColor: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Draft", nfColor.NavyInk, nfColor.Rule)
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Draft", nfColor.NavyInk, nfColor.Transparent)
                        FillPortions: =0
                        Height: =24
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =12
                        RadiusBottomRight: =12
                        RadiusTopLeft: =12
                        RadiusTopRight: =12
                        Visible: =App.Width >= 1280
                        Width: =60
                      Children:
                        - lblLinPillT0:
                            Control: ModernText@1.0.0
                            Properties:
                              Align: =Align.Center
                              Color: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Draft", nfColor.Navy, nfColor.Rule)
                              FontWeight: =FontWeight.Semibold
                              Height: =24
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Cap
                              Text: ="Draft"
                              Width: =60
                              Wrap: =false
                  - conLinPill1:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        BorderColor: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Submitted", nfColor.NavyInk, nfColor.Rule)
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Submitted", nfColor.NavyInk, nfColor.Transparent)
                        FillPortions: =0
                        Height: =24
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =12
                        RadiusBottomRight: =12
                        RadiusTopLeft: =12
                        RadiusTopRight: =12
                        Visible: =App.Width >= 1280
                        Width: =84
                      Children:
                        - lblLinPillT1:
                            Control: ModernText@1.0.0
                            Properties:
                              Align: =Align.Center
                              Color: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Submitted", nfColor.Navy, nfColor.Rule)
                              FontWeight: =FontWeight.Semibold
                              Height: =24
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Cap
                              Text: ="Submitted"
                              Width: =84
                              Wrap: =false
                  - conLinPill2:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        BorderColor: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "COR review", nfColor.NavyInk, nfColor.Rule)
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "COR review", nfColor.NavyInk, nfColor.Transparent)
                        FillPortions: =0
                        Height: =24
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =12
                        RadiusBottomRight: =12
                        RadiusTopLeft: =12
                        RadiusTopRight: =12
                        Visible: =App.Width >= 1280
                        Width: =92
                      Children:
                        - lblLinPillT2:
                            Control: ModernText@1.0.0
                            Properties:
                              Align: =Align.Center
                              Color: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "COR review", nfColor.Navy, nfColor.Rule)
                              FontWeight: =FontWeight.Semibold
                              Height: =24
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Cap
                              Text: ="COR review"
                              Width: =92
                              Wrap: =false
                  - conLinPill3:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        BorderColor: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Approved", nfColor.NavyInk, nfColor.Rule)
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Approved", nfColor.NavyInk, nfColor.Transparent)
                        FillPortions: =0
                        Height: =24
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =12
                        RadiusBottomRight: =12
                        RadiusTopLeft: =12
                        RadiusTopRight: =12
                        Visible: =App.Width >= 1280
                        Width: =80
                      Children:
                        - lblLinPillT3:
                            Control: ModernText@1.0.0
                            Properties:
                              Align: =Align.Center
                              Color: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Approved", nfColor.Navy, nfColor.Rule)
                              FontWeight: =FontWeight.Semibold
                              Height: =24
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Cap
                              Text: ="Approved"
                              Width: =80
                              Wrap: =false
                  - conLinAvatar:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Avatar
                        FillPortions: =0
                        Height: =40
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =20
                        RadiusBottomRight: =20
                        RadiusTopLeft: =20
                        RadiusTopRight: =20
                        Width: =40
                      Children:
                        - lblLinInitials:
                            Control: ModernText@1.0.0
                            Properties:
                              AccessibleLabel: =User().FullName
                              Align: =Align.Center
                              Color: =nfColor.White
                              FontWeight: =FontWeight.Bold
                              Height: =Parent.Height
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.H3
                              Text: =nfIgceInitials
                              Width: =Parent.Width
                              Wrap: =false
            - conLinBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Width: =Parent.Width
                Children:
                  - conLinGutter:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Xl
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        LayoutOverflowY: =LayoutOverflow.Scroll
                        PaddingBottom: =nfSpace.Xxl
                        PaddingLeft: =nfSpace.Xxl
                        PaddingRight: =nfSpace.Xxl
                        PaddingTop: =nfSpace.Xxl
                        Width: =Parent.Width
                      Children:
                        - conLinCrumb:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: =nfHeights.crumb
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Width: =nfPageW
                            Children:
                              - btnLinCrumb0:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Appearance: =ButtonAppearance.Transparent
                                    Height: =24
                                    OnSelect: =Navigate(scrIgceHome, ScreenTransition.None)
                                    Size: =nfType.Small
                                    Text: ="Estimates"
                                    Width: =Len("Estimates") * 7 + 24
                              - lblLinSep1:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Color: =nfColor.Ink2
                                    Height: =20
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="/"
                                    Width: =10
                                    Wrap: =false
                              - btnLinCrumb1:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Appearance: =ButtonAppearance.Transparent
                                    Height: =24
                                    OnSelect: =Navigate(scrIgceRequirement, ScreenTransition.None)
                                    Size: =nfType.Small
                                    Text: =nfIgcePRLabel(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id)
                                    Width: =Len(nfIgcePRLabel(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id)) * 7 + 24
                              - lblLinSep2:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Color: =nfColor.Ink2
                                    Height: =20
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="/"
                                    Width: =10
                                    Wrap: =false
                              - lblLinCrumb2:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Color: =nfColor.Ink2
                                    Height: =20
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="Revision " & LookUp(colIGCEHeader, ID = gblIgceHeaderID).Revision
                                    Width: =220
                                    Wrap: =false
                        - cmpLinStepper:
                            Control: CanvasComponent
                            ComponentName: cmpStepper
                            Properties:
                              AccentColor: =nfColor.Navy
                              AlignInContainer: =AlignInContainer.Center
                              CheckIcon: =Blank()
                              ClickableSteps: ="All"
                              CurrentStep: =nfIgceStepIndex("lines", LookUp(colIGCEHeader, ID = gblIgceHeaderID).ContainsGFP)
                              Density: ="Full"
                              Height: |-
                                =If(
                                    Self.Type = "Bar",
                                    Switch(Self.Size, "Small", 4, "Medium", 6, "Large", 8, 6),
                                    If(
                                        Self.Density = "Full",
                                        Switch(Self.Size, "Small", 60, "Medium", 72, "Large", 86, 72),
                                        Switch(Self.Size, "Small", 26, "Medium", 32, "Large", 40, 32)
                                    )
                                )
                              OnStepSelect: =nfIgceStepNav(Self.SelectedStep, LookUp(colIGCEHeader, ID = gblIgceHeaderID).ContainsGFP)
                              Size: ="Medium"
                              StepLabels: |-
                                =ForAll(
                                    Split(nfIgceStepLabels(LookUp(colIGCEHeader, ID = gblIgceHeaderID).ContainsGFP), "|") As s,
                                    { Label: s.Value }
                                )
                              Theme: ="Light"
                              Type: ="Step"
                              Width: =nfPageW
                        - lblLinTitle:
                            Control: ModernText@1.0.0
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              Color: =nfColor.Ink
                              FontWeight: =FontWeight.Semibold
                              Height: =nfHeights.h2
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.H2
                              Text: ="Lines"
                              Width: =nfPageW
                              Wrap: =false
                        - lblLinLead:
                            Control: ModernText@1.0.0
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              AutoHeight: =true
                              Color: =nfColor.Ink2
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Body
                              Text: |-
                                ="Each line is a task or CLIN. Labor lines take hours and a direct rate; fringe, overhead and the rest come from the header. With Calc OPs on, option period rates inflate from the base at "
                                & LookUp(colIGCEHeader, ID = gblIgceHeaderID).InflationRate
                                & "% a year."
                              Width: =nfPageW
                        - conLinLnTableCard:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              BorderColor: =nfColor.Rule
                              BorderThickness: =1
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Surface
                              FillPortions: =0
                              Height: =nfSpace.Lg * 2 + nfHeights.hdrRow + nfSpace.Sm + nfHeights.row * 6
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Sm
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              LayoutOverflowX: =LayoutOverflow.Scroll
                              PaddingBottom: =nfSpace.Lg
                              PaddingLeft: =nfSpace.Lg
                              PaddingRight: =nfSpace.Lg
                              PaddingTop: =nfSpace.Lg
                              RadiusBottomLeft: =8
                              RadiusBottomRight: =8
                              RadiusTopLeft: =8
                              RadiusTopRight: =8
                              Width: =nfPageW
                            Children:
                              - conLinLnHdrRow:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Start
                                    DropShadow: =DropShadow.None
                                    FillPortions: =0
                                    Height: =nfHeights.hdrRow
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    Width: =790
                                  Children:
                                    - lblLinHNo:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="NO"
                                          Width: =60
                                          Wrap: =false
                                    - lblLinHDesc:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="DESCRIPTION"
                                          Width: =280
                                          Wrap: =false
                                          X: =60
                                    - lblLinHType:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="CATEGORY"
                                          Width: =140
                                          Wrap: =false
                                          X: =340
                                    - lblLinHTot:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Align: =Align.Right
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="TOTAL"
                                          Width: =130
                                          Wrap: =false
                                          X: =490
                              - galLinLnRows:
                                  Control: Gallery@2.15.0
                                  Variant: Vertical
                                  Properties:
                                    AccessibleLabel: ="Lines in this estimate"
                                    FillPortions: =0
                                    Height: =nfHeights.row * 6
                                    Items: =SortByColumns(Filter(colIGCELine, IGCEHeaderID = gblIgceHeaderID), "LineNumber")
                                    TemplatePadding: =0
                                    TemplateSize: =nfHeights.row
                                    Width: =790
                                  Children:
                                    - conLinLnRow:
                                        Control: GroupContainer@1.5.0
                                        Variant: ManualLayout
                                        Properties:
                                          DropShadow: =DropShadow.None
                                          Height: =Parent.TemplateHeight
                                          Width: =Parent.TemplateWidth
                                        Children:
                                          - lblLinRNo:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                Color: =nfColor.Ink
                                                Height: =nfHeights.row
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =ThisItem.LineNumber
                                                Width: =60
                                                Wrap: =false
                                          - txtLinRDesc:
                                              Control: ModernTextInput@1.1.2
                                              Properties:
                                                AccessibleLabel: ="Line description"
                                                Appearance: =Appearance.Outline
                                                Color: =nfColor.Ink
                                                Default: =ThisItem.Title
                                                DisplayMode: =If(nfIgceIsReadOnly(gblIgceHeaderID), DisplayMode.View, DisplayMode.Edit)
                                                Height: =28
                                                MaxLength: =255
                                                OnChange: |-
                                                  =nfIgceStageLine(ThisItem.ID);
                                                  Patch(
                                                      colIGCELineEdit,
                                                      First(colIGCELineEdit),
                                                      {
                                                          Title: Self.Text
                                                      }
                                                  );
                                                  nfIGCESaveLine(ThisItem.ID)
                                                Placeholder: ="SOW/SOO/PWS description"
                                                Required: =true
                                                Size: =nfType.Body
                                                TriggerOutput: =TriggerOutput.FocusOut
                                                ValidationState: =If(IsBlank(ThisItem.Title), ValidationState.Error, ValidationState.None)
                                                Width: =270
                                                X: =60
                                                Y: =(nfHeights.row - 28) / 2
                                          - lblLinRType:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                Color: =nfColor.Ink2
                                                Height: =nfHeights.row
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: ="Labor"
                                                Visible: =ThisItem.Labor
                                                Width: =140
                                                Wrap: =false
                                                X: =340
                                          - cboLinRCat:
                                              Control: ModernCombobox@1.1.2
                                              Properties:
                                                AccessibleLabel: ="Line category"
                                                AllowExternalSelectedItems: =false
                                                Appearance: =Appearance.Outline
                                                Color: =nfColor.Ink
                                                DefaultSelectedItems: =Filter(colChoiceCategory, Value = ThisItem.Category.Value)
                                                DisplayMode: =If(nfIgceIsReadOnly(gblIgceHeaderID), DisplayMode.View, DisplayMode.Edit)
                                                Height: =28
                                                InputTextPlaceholder: ="Pick a category"
                                                IsSearchable: =false
                                                ItemDisplayText: =ThisItem.Value
                                                Items: =colChoiceCategory
                                                OnChange: |-
                                                  =nfIgceStageLine(ThisItem.ID);
                                                  Patch(
                                                      colIGCELineEdit,
                                                      First(colIGCELineEdit),
                                                      {
                                                          Category: { Value: Self.Selected.Value }
                                                      }
                                                  );
                                                  nfIGCESaveLine(ThisItem.ID);
                                                  nfIGCEValidate(gblIgceHeaderID)
                                                Required: =true
                                                SelectMultiple: =false
                                                Size: =nfType.Body
                                                ValidationState: =If(IsBlank(ThisItem.Category.Value), ValidationState.Error, ValidationState.None)
                                                Visible: =!ThisItem.Labor
                                                Width: =140
                                                X: =340
                                                Y: =(nfHeights.row - 28) / 2
                                          - lblLinRTot:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                Align: =Align.Right
                                                Color: =nfColor.Money
                                                FontWeight: =FontWeight.Semibold
                                                Height: =nfHeights.row
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =nfIGCEMoney(nfIgceLineTotalOf(ThisItem.ID))
                                                Width: =130
                                                Wrap: =false
                                                X: =490
                                          - btnLinRPick:
                                              Control: ModernButton@1.0.0
                                              Properties:
                                                Appearance: =If(ThisItem.ID = locLineID, ButtonAppearance.Primary, ButtonAppearance.Secondary)
                                                Height: =28
                                                OnSelect: |-
                                                  =UpdateContext({ locLineID: ThisItem.ID })
                                                Size: =nfType.Cap
                                                Text: |-
                                                  ="Sublines ("
                                                  & CountRows(Filter(colIGCESubLine, IGCELineID = ThisItem.ID))
                                                  & ")"
                                                Width: =104
                                                X: =620
                                                Y: =(nfHeights.row - 28) / 2
                                          - btnLinRDel:
                                              Control: ModernButton@1.0.0
                                              Properties:
                                                Appearance: =ButtonAppearance.Transparent
                                                Height: =28
                                                OnSelect: |-
                                                  =nfIGCEDeleteLine(ThisItem.ID);
                                                  UpdateContext({ locLineID: 0 });
                                                  nfIGCEValidate(gblIgceHeaderID)
                                                Size: =nfType.Cap
                                                Text: ="Delete"
                                                Tooltip: ="Delete this line and every subline under it"
                                                Visible: =!nfIgceIsReadOnly(gblIgceHeaderID)
                                                Width: =54
                                                X: =730
                                                Y: =(nfHeights.row - 28) / 2
                        - conLinAddBar:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: =nfHeights.btn
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Md
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Width: =nfPageW
                            Children:
                              - btnLinAddLabor:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Appearance: =ButtonAppearance.Secondary
                                    Height: =nfHeights.btn
                                    OnSelect: |-
