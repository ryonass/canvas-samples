Screens:
  scrIgceHeader:
    Properties:
      Fill: =nfColor.Paper
      OnVisible: |-
        =// Stage the estimate into the edit row. Every control below binds to this row,
        // and Continue calls nfIGCESaveHeader, which is the only routine that writes a
        // header. Phase 2 list: IGCEHeader.
        With(
            { _h: LookUp(colIGCEHeader, ID = gblIgceHeaderID) },
            Patch(
                colIGCEHeaderEdit,
                First(colIGCEHeaderEdit),
                {
                    Title: _h.Title,
                    Revision: _h.Revision,
                    PRTrackerID: _h.PRTrackerID,
                    PRTrackerNumber: _h.PRTrackerNumber,
                    PRID: _h.PRID,
                    IGCEType: _h.IGCEType,
                    PointOfContact: _h.PointOfContact,
                    COR: _h.COR,
                    BasePeriodStart: _h.BasePeriodStart,
                    BasePeriodEnd: _h.BasePeriodEnd,
                    OptionPeriods: _h.OptionPeriods,
                    InflationRate: _h.InflationRate,
                    FringeRate: _h.FringeRate,
                    OverheadRate: _h.OverheadRate,
                    GARate: _h.GARate,
                    FCCOMRate: _h.FCCOMRate,
                    ProfitFeeRate: _h.ProfitFeeRate,
                    ContractAccessFeeRate: _h.ContractAccessFeeRate,
                    IndirectBurdenRate: _h.IndirectBurdenRate,
                    ContainsGFP: _h.ContainsGFP
                }
            )
        );
        nfIGCEValidate(gblIgceHeaderID)
    Children:
      - conHdrRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Height: =Parent.Height
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - conHdrTopBar:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Navy
                  FillPortions: =0
                  Height: =nfHeights.topBar
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =nfSpace.Lg
                  LayoutMaxHeight: =nfHeights.topBar
                  LayoutMinHeight: =nfHeights.topBar
                  LayoutMinWidth: =0
                  PaddingLeft: =nfSpace.Xl
                  PaddingRight: =nfSpace.Xl
                  Width: =Parent.Width
                Children:
                  - lblHdrAppName:
                      Control: ModernText@1.0.0
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        Color: =nfColor.NavyInk
                        FontWeight: =FontWeight.Semibold
                        Height: =nfHeights.topBar
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.H3
                        Text: |-
                          ="PR: " & nfIgcePRLabel(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id) & " | IGCE"
                        Width: |-
                          =Len("PR: " & nfIgcePRLabel(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id) & " | IGCE") * 9 + 16
                        Wrap: =false
                  - lblHdrMeta:
                      Control: ModernText@1.0.0
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        Color: =nfColor.NavyInk
                        Height: =nfHeights.topBar
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.Small
                        Text: |-
                          =nfIgceReqNameOf(LookUp(colIGCEHeader, ID = gblIgceHeaderID).PRTrackerID.Id)
                          & "  |  Revision "
                          & LookUp(colIGCEHeader, ID = gblIgceHeaderID).Revision
                        Visible: =nfIsDesktop
                        Width: =360
                        Wrap: =false
                  - conHdrBarSpacer:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                  - conHdrPill0:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        BorderColor: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Draft", nfColor.NavyInk, nfColor.Rule)
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Draft", nfColor.NavyInk, nfColor.Transparent)
                        FillPortions: =0
                        Height: =24
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =12
                        RadiusBottomRight: =12
                        RadiusTopLeft: =12
                        RadiusTopRight: =12
                        Visible: =App.Width >= 1280
                        Width: =60
                      Children:
                        - lblHdrPillT0:
                            Control: ModernText@1.0.0
                            Properties:
                              Align: =Align.Center
                              Color: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Draft", nfColor.Navy, nfColor.Rule)
                              FontWeight: =FontWeight.Semibold
                              Height: =24
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Cap
                              Text: ="Draft"
                              Width: =60
                              Wrap: =false
                  - conHdrPill1:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        BorderColor: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Submitted", nfColor.NavyInk, nfColor.Rule)
