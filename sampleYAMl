Screens:
  scrIgceHome:
    Properties:
      Fill: =nfColor.Paper
      OnVisible: |-
        =UpdateContext({ locHomeNewOpen: Coalesce(locHomeNewOpen, false) })
    Children:
      - conHomeRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Height: =Parent.Height
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - conHomeTopBar:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Navy
                  FillPortions: =0
                  Height: =nfHeights.topBar
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =nfSpace.Lg
                  LayoutMaxHeight: =nfHeights.topBar
                  LayoutMinHeight: =nfHeights.topBar
                  LayoutMinWidth: =0
                  PaddingLeft: =nfSpace.Xl
                  PaddingRight: =nfSpace.Xl
                  Width: =Parent.Width
                Children:
                  - lblHomeAppName:
                      Control: ModernText@1.0.0
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        Color: =nfColor.NavyInk
                        FontWeight: =FontWeight.Semibold
                        Height: =nfHeights.topBar
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.H3
                        Text: ="CISA COCO IGCE"
                        Width: =Len("CISA COCO IGCE") * 9 + 16
                        Wrap: =false
                  - conHomeBarSpacer:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                  - conDashAvatar:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Avatar
                        FillPortions: =0
                        Height: =40
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =20
                        RadiusBottomRight: =20
                        RadiusTopLeft: =20
                        RadiusTopRight: =20
                        Width: =40
                      Children:
                        - lblDashInitials:
                            Control: ModernText@1.0.0
                            Properties:
                              AccessibleLabel: =User().FullName
                              Align: =Align.Center
                              Color: =nfColor.White
                              FontWeight: =FontWeight.Bold
                              Height: =Parent.Height
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.H3
                              Text: =nfIgceInitials
                              Width: =Parent.Width
                              Wrap: =false
            - conHomeBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Width: =Parent.Width
                Children:
                  - conHomeGutter:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Xl
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        LayoutOverflowY: =LayoutOverflow.Scroll
                        PaddingBottom: =nfSpace.Xxl
                        PaddingLeft: =nfSpace.Xxl
                        PaddingRight: =nfSpace.Xxl
                        PaddingTop: =nfSpace.Xxl
                        Width: =Parent.Width
                      Children:
                        - conHomeHead:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: =34 + nfSpace.Sm + 40
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Sm
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Width: =nfPageW
                            Children:
                              - lblHomeTitle:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    Height: =34
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.H2
                                    Text: ="Estimates"
                                    Width: =Parent.Width
                                    Wrap: =false
                              - lblHomeLead:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Body
                                    Text: |-
                                      ="Signed in as " & nfIgceMe
                                      & ". Open a requirement to see every revision of its IGCE."
                                    Width: =Parent.Width
                        - cmpHomeTabs:
                            Control: CanvasComponent
                            ComponentName: cmpSegmentedControl
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              DefaultValue: ="mine"
                              Disabled: =false
                              DisplayMode: ="Text"
                              EqualWidth: =true
                              Height: =Switch(Self.Size, "Small", 32, "Medium", 40, "Large", 48, 40)
                              IconPosition: ="Left"
                              OnChange: =false
                              Options: |-
                                =Table(
                                    { Value: "mine",   Label: "My estimates (" & nfIgceMineCount & ")" },
                                    { Value: "review", Label: "Awaiting my review (" & nfIgceReviewCount & ")" },
                                    { Value: "all",    Label: "All (" & nfIgceAllCount & ")" }
                                )
                              Size: ="Medium"
                              Theme: ="Light"
                              Width: |-
                                =If(
                                    Self.DisplayMode = "Icons" && !Self.EqualWidth,
                                    Switch(Self.Size, "Small", 32, "Medium", 40, "Large", 48, 40)
                                        * CountRows(Self.Options) + 4,
                                    Self.DisplayMode = "Text",
                                    Switch(Self.Size, "Small", 72, "Medium", 88, "Large", 104, 88)
                                        * CountRows(Self.Options) + 4,
                                    Switch(Self.Size, "Small", 96, "Medium", 112, "Large", 132, 112)
                                        * CountRows(Self.Options) + 4
                                )
                        - conHomeToolbar:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: =nfHeights.input
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Md
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Width: =nfPageW
                            Children:
                              - txtHomeSearch:
                                  Control: ModernTextInput@1.1.2
                                  Properties:
                                    AccessibleLabel: ="Search by PR number or requirement name"
                                    AlignInContainer: =AlignInContainer.Center
                                    Appearance: =Appearance.Outline
                                    Color: =nfColor.Ink
                                    FillPortions: =1
                                    Height: =nfHeights.input
                                    Placeholder: ="Search PR number or requirement"
                                    Size: =nfType.Body2
                                    Type: =TextInputType.Search
                                    Width: =Parent.Width
                              - btnHomeNew:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Center
                                    Height: =nfHeights.btn
                                    OnSelect: |-
                                      =UpdateContext({ locHomeNewOpen: !locHomeNewOpen })
                                    Size: =nfType.Body2
                                    Text: ="New IGCE"
                                    Width: =150
                        - conHomeNewCard:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              BorderColor: =nfColor.Rule
                              BorderThickness: =1
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Surface
                              FillPortions: =0
                              Height: =nfSpace.Xl * 2 + nfHeights.input + nfSpace.Sm + 40
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Sm
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              PaddingBottom: =nfSpace.Xl
                              PaddingLeft: =nfSpace.Xl
                              PaddingRight: =nfSpace.Xl
                              PaddingTop: =nfSpace.Xl
                              RadiusBottomLeft: =8
                              RadiusBottomRight: =8
                              RadiusTopLeft: =8
                              RadiusTopRight: =8
                              Visible: =locHomeNewOpen
                              Width: =nfPageW
                            Children:
                              - lblHomeNewLabel:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    Color: =nfColor.Ink2
                                    Height: =18
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: =If(CountRows(nfIgceFreePRs) = 0, "Every requirement in the tracker already has an IGCE.", "Requirement from the Requirement Tracker")
                                    Width: =Parent.Width
                                    Wrap: =false
                              - conHomeNewRow:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    FillPortions: =0
                                    Height: =nfHeights.input
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutGap: =nfSpace.Md
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    Width: =Parent.Width
                                  Children:
                                    - cboHomeNewPR:
                                        Control: ModernCombobox@1.1.2
                                        Properties:
                                          AccessibleLabel: ="Requirement from the Requirement Tracker"
                                          AlignInContainer: =AlignInContainer.Center
                                          AllowExternalSelectedItems: =false
                                          Appearance: =Appearance.Outline
                                          Color: =nfColor.Ink
                                          DefaultSelectedItems: =FirstN(nfIgceFreePRs, 1)
                                          FillPortions: =1
                                          Height: =nfHeights.input
                                          InputTextPlaceholder: ="Select a requirement"
                                          ItemDisplayText: |-
                                            =ThisItem.PRTrackerNumber
                                            & "  "
                                            & ThisItem.RequirementName
                                          Items: =nfIgceFreePRs
                                          SelectMultiple: =false
                                          Size: =nfType.Body2
                                          Visible: =CountRows(nfIgceFreePRs) > 0
                                          Width: =Parent.Width
                                    - btnHomeCreate:
                                        Control: ModernButton@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Height: =nfHeights.btn
                                          OnSelect: |-
                                            =// Phase 2 list: IGCEHeader. The new estimate is staged here and written by
                                            // nfIGCESaveHeader, which is the only routine that writes a header.
                                            Patch(
                                                colIGCEHeaderEdit,
                                                First(colIGCEHeaderEdit),
                                                {
                                                    Title: cboHomeNewPR.Selected.PRTrackerNumber,
                                                    Revision: 1,
                                                    PRTrackerID: { Id: cboHomeNewPR.Selected.ID, Value: cboHomeNewPR.Selected.PRTrackerNumber },
                                                    PRTrackerNumber: cboHomeNewPR.Selected.PRTrackerNumber,
                                                    PRID: Text(cboHomeNewPR.Selected.ID),
                                                    IGCEType: { Value: "" },
                                                    PointOfContact: gblSignedIn,
                                                    COR: cboHomeNewPR.Selected.COR,
                                                    BasePeriodStart: Blank(),
                                                    BasePeriodEnd: Blank(),
                                                    OptionPeriods: 0,
                                                    InflationRate: 0,
                                                    FringeRate: 0,
                                                    OverheadRate: 0,
                                                    GARate: 0,
                                                    FCCOMRate: 0,
                                                    ProfitFeeRate: 0,
                                                    ContractAccessFeeRate: 0,
                                                    IndirectBurdenRate: 0,
                                                    ContainsGFP: false
                                                }
                                            );
                                            nfIGCESaveHeader(0);
                                            Set(gblIgceHeaderID, Max(colIGCEHeader, ID));
                                            UpdateContext({ locHomeNewOpen: false });
                                            Navigate(scrIgceHeader, ScreenTransition.None)
                                          Size: =nfType.Body2
                                          Text: ="Start estimate"
                                          Visible: =CountRows(nfIgceFreePRs) > 0
                                          Width: =150
                                    - btnHomeNewCancel:
                                        Control: ModernButton@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Appearance: =ButtonAppearance.Secondary
                                          Height: =nfHeights.btn
                                          OnSelect: |-
                                            =UpdateContext({ locHomeNewOpen: false })
                                          Size: =nfType.Body2
                                          Text: ="Cancel"
                                          Width: =110
                        - conHomeTableCard:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.Center
                              BorderColor: =nfColor.Rule
                              BorderThickness: =1
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Surface
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Sm
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              LayoutOverflowX: =LayoutOverflow.Scroll
                              PaddingBottom: =nfSpace.Lg
                              PaddingLeft: =nfSpace.Lg
                              PaddingRight: =nfSpace.Lg
                              PaddingTop: =nfSpace.Lg
                              RadiusBottomLeft: =8
                              RadiusBottomRight: =8
                              RadiusTopLeft: =8
                              RadiusTopRight: =8
                              Width: =nfPageW
                            Children:
                              - conHomeHdrRow:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    FillPortions: =0
                                    Height: =nfHeights.hdrRow
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    Width: =Max(860, Parent.Width - (2 * nfSpace.Lg))
                                  Children:
                                    - lblHomeHPrNumber:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          LayoutMinWidth: =120
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="PR NUMBER"
                                          Width: =120
                                          Wrap: =false
                                    - lblHomeHRequirement:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Color: =nfColor.Ink2
                                          FillPortions: =1
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          LayoutMinWidth: =200
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="REQUIREMENT"
                                          Wrap: =false
                                    - lblHomeHRevision:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          LayoutMinWidth: =70
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="REVISION"
                                          Width: =70
                                          Wrap: =false
                                    - lblHomeHStatus:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          LayoutMinWidth: =110
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="STATUS"
                                          Width: =110
                                          Wrap: =false
                                    - lblHomeHCeiling:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Align: =Align.Right
                                          AlignInContainer: =AlignInContainer.Center
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          LayoutMinWidth: =110
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="CEILING"
                                          Width: =110
                                          Wrap: =false
                                    - lblHomeHPoc:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          LayoutMinWidth: =90
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="POC"
                                          Width: =90
                                          Wrap: =false
                                    - lblHomeHCor:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          LayoutMinWidth: =90
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="COR"
                                          Width: =90
                                          Wrap: =false
                                    - lblHomeHUpdated:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Center
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          Height: =nfHeights.hdrRow
                                          LayoutMinWidth: =70
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Cap
                                          Text: ="UPDATED"
                                          Width: =70
                                          Wrap: =false
                              - galHomeRows:
                                  Control: Gallery@2.15.0
                                  Variant: Vertical
                                  Properties:
                                    AccessibleLabel: ="Estimates, one row per requirement"
                                    AlignInContainer: =AlignInContainer.Start
                                    Height: =Parent.Height - nfHeights.hdrRow - nfSpace.Sm
                                    Items: |-
                                      =Sort(
                                          Filter(
                                              nfIgceLatest As e,
                                              (
                                                  cmpHomeTabs.SelectedValue = "all"
                                                  || (
                                                      cmpHomeTabs.SelectedValue = "mine"
                                                      && CountRows(
                                                             Filter(
                                                                 colIGCEHeader,
                                                                 PRID = e.PRID,
                                                                 PointOfContact.Email = nfIgceMe
                                                             )
                                                         ) > 0
                                                  )
                                                  || (
                                                      cmpHomeTabs.SelectedValue = "review"
                                                      && e.COR.Email = nfIgceMe
                                                      && (e.Status.Value = "Submitted" || e.Status.Value = "COR review")
                                                  )
                                              )
                                              && (
                                                  IsBlank(Trim(txtHomeSearch.Text))
                                                  || StartsWith(e.PRTrackerNumber, Trim(txtHomeSearch.Text))
                                                  || StartsWith(nfIgceReqNameOf(e.PRTrackerID.Id), Trim(txtHomeSearch.Text))
                                              )
                                          ),
                                          Modified,
                                          SortOrder.Descending
                                      )
                                    TemplatePadding: =0
                                    TemplateSize: =nfHeights.row
                                    Width: =Max(860, Parent.Width - (2 * nfSpace.Lg))
                                  Children:
                                    - conHomeRow:
                                        Control: GroupContainer@1.5.0
                                        Variant: AutoLayout
                                        Properties:
                                          DropShadow: =DropShadow.None
                                          Height: =Parent.TemplateHeight
                                          LayoutAlignItems: =LayoutAlignItems.Center
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          Width: =Parent.TemplateWidth
                                        Children:
                                          - lblHomeRPRnumber:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Center
                                                Color: =nfColor.Ink
                                                Height: =nfHeights.row
                                                LayoutMinWidth: =120
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =ThisItem.PRTrackerNumber
                                                Width: =120
                                                Wrap: =false
                                          - lblHomeRRequirement:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Center
                                                Color: =nfColor.Ink
                                                FillPortions: =1
                                                Height: =nfHeights.row
                                                LayoutMinWidth: =200
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =nfIgceReqNameOf(ThisItem.PRTrackerID.Id)
                                                Wrap: =false
                                          - lblHomeRRevision:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Center
                                                Color: =nfColor.Ink
                                                Height: =nfHeights.row
                                                LayoutMinWidth: =70
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: |-
                                                  =ThisItem.Revision
                                                  & If(nfIgceRevCountOf(ThisItem.PRID) > 1, " of " & nfIgceRevCountOf(ThisItem.PRID), "")
                                                Width: =70
                                                Wrap: =false
                                          - conHomeRStatus:
                                              Control: GroupContainer@1.5.0
                                              Variant: AutoLayout
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Center
                                                DropShadow: =DropShadow.None
                                                FillPortions: =0
                                                Height: =nfHeights.row
                                                LayoutAlignItems: =LayoutAlignItems.Center
                                                LayoutDirection: =LayoutDirection.Horizontal
                                                LayoutGap: =nfSpace.Xs
                                                LayoutMinHeight: =0
                                                LayoutMinWidth: =110
                                                Width: =110
                                              Children:
                                                - conHomeRStatusChip:
                                                    Control: GroupContainer@1.5.0
                                                    Variant: ManualLayout
                                                    Properties:
                                                      AlignInContainer: =AlignInContainer.Center
                                                      DropShadow: =DropShadow.None
                                                      Fill: =nfIgceStatusStyle(ThisItem.Status.Value)
                                                      FillPortions: =0
                                                      Height: =nfHeights.chip
                                                      LayoutMinHeight: =0
                                                      LayoutMinWidth: =0
                                                      RadiusBottomLeft: =10
                                                      RadiusBottomRight: =10
                                                      RadiusTopLeft: =10
                                                      RadiusTopRight: =10
                                                      Width: =98
                                                    Children:
                                                      - conHomeRStatusTxt:
                                                          Control: ModernText@1.0.0
                                                          Properties:
                                                            Align: =Align.Center
                                                            Color: =nfIgceStatusInk(ThisItem.Status.Value)
                                                            FontWeight: =FontWeight.Semibold
                                                            Height: =Parent.Height
                                                            PaddingBottom: =0
                                                            PaddingLeft: =0
                                                            PaddingRight: =0
                                                            PaddingTop: =0
                                                            Size: =nfType.Cap
                                                            Text: =ThisItem.Status.Value
                                                            Width: =Parent.Width
                                                            Wrap: =false
                                          - lblHomeRCeiling:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                Align: =Align.Right
                                                AlignInContainer: =AlignInContainer.Center
                                                Color: =nfColor.Money
                                                FontWeight: =FontWeight.Semibold
                                                Height: =nfHeights.row
                                                LayoutMinWidth: =110
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =nfIGCEMoney(nfIgceCeilingOf(ThisItem.ID))
                                                Width: =110
                                                Wrap: =false
                                          - lblHomeRPOC:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Center
                                                Color: =nfColor.Ink
                                                Height: =nfHeights.row
                                                LayoutMinWidth: =90
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =ThisItem.PointOfContact.DisplayName
                                                Width: =90
                                                Wrap: =false
                                          - lblHomeRCOR:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Center
                                                Color: =nfColor.Ink
                                                Height: =nfHeights.row
                                                LayoutMinWidth: =90
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: =ThisItem.COR.DisplayName
                                                Width: =90
                                                Wrap: =false
                                          - lblHomeRUpdated:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Center
                                                Color: =nfColor.Ink
                                                Height: =nfHeights.row
                                                LayoutMinWidth: =70
