                        DropShadow: =DropShadow.None
                        Fill: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Submitted", nfColor.NavyInk, nfColor.Transparent)
                        FillPortions: =0
                        Height: =24
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =12
                        RadiusBottomRight: =12
                        RadiusTopLeft: =12
                        RadiusTopRight: =12
                        Visible: =App.Width >= 1280
                        Width: =84
                      Children:
                        - lblHdrPillT1:
                            Control: ModernText@1.0.0
                            Properties:
                              Align: =Align.Center
                              Color: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "Submitted", nfColor.Navy, nfColor.Rule)
                              FontWeight: =FontWeight.Semibold
                              Height: =24
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Cap
                              Text: ="Submitted"
                              Width: =84
                              Wrap: =false
                  - conHdrPill2:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.Center
                        BorderColor: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "COR review", nfColor.NavyInk, nfColor.Rule)
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =If(LookUp(colIGCEHeader, ID = gblIgceHeaderID).Status.Value = "COR review", nfColor.NavyInk, nfColor.Transparent)
                        FillPortions: =0
                        Height: =24
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =12
                        RadiusBottomRight: =12
                        RadiusTopLeft: =12
                        RadiusTopRight: =12
