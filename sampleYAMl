                              AccessibleLabel: ="Edit"
                              Appearance: =ButtonAppearance.Secondary
                              Height: =nfSize.Control
                              Icon: ="Edit"
                              OnSelect: |-
                                =Navigate(scrForm, ScreenTransition.None, { locId: locId })
                              Size: =nfType.Body
                              Text: ="Edit"
                              Visible: =locItem.RequesterEmail = nfUserEmail && LookUp(nfStatus, Key = locItem.Status).Editable
                        - btnDtlAct1:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: =Last(FirstN(locActions, 1)).Label
                              Appearance: =If(Last(FirstN(locActions, 1)).Primary, ButtonAppearance.Primary, ButtonAppearance.Secondary)
                              BasePaletteColor: =If(Last(FirstN(locActions, 1)).Danger, nfColor.Danger, nfColor.Primary)
                              Height: =nfSize.Control
                              OnSelect: |-
                                =With({ t: Last(FirstN(locActions, 1)) }, UpdateContext({ locConfirm: { Action: t.Key, Title: t.ConfirmTitle, Message: t.ConfirmMessage, Label: t.Label, Danger: t.Danger } }))
                              Size: =nfType.Body
                              Text: =Last(FirstN(locActions, 1)).Label
                              Visible: =CountRows(locActions) >= 1
                              Width: =Len(Last(FirstN(locActions, 1)).Label) * 8 + 40
