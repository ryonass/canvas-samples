ComponentDefinitions:
  cmpHeader:
    DefinitionType: CanvasComponent
    CustomProperties:
      ActiveKey:
        PropertyKind: Input
        DisplayName: ActiveKey
        Description: Key of the main tab to show as active.
        DataType: Text
        Default: ="home"
      IsStaff:
        PropertyKind: Input
        DisplayName: IsStaff
        Description: Pass =gblIsStaff. StaffOnly tabs are hidden when false.
        DataType: Boolean
        Default: =false
      Items:
        PropertyKind: Input
        DisplayName: Items
        Description: Main tabs. Pass =nfNavMain. Same columns as cmpBottomNav.
        DataType: Table
        Default: |-
          =Table({ Key: "home", Label: "Home", Count: 0, StaffOnly: false }, { Key: "list", Label: "List", Count: 3, StaffOnly: false })
      Layout:
        PropertyKind: Input
        DisplayName: Layout
        Description: Pass =nfLayout. Phone, Tablet or Desktop.
        DataType: Text
        Default: ="Desktop"
      Links:
        PropertyKind: Input
        DisplayName: Links
        Description: Links on the right, in order. Pass =nfHeaderLinks. Columns Label and Url. A row with a blank Url is hidden. Up to four show, and only the first on a phone.
        DataType: Table
        Default: |-
          =Table({ Label: "Help", Url: "https://example.gov/help" })
      Logo:
        PropertyKind: Input
        DisplayName: Logo
        Description: Logo, drawn 32 high. Pass =nfLogo, an image added to the app under Media (SVG or PNG). Hidden when blank.
        DataType: Image
        Default: =Blank()
      LogoWidth:
        PropertyKind: Input
        DisplayName: LogoWidth
        Description: Logo width. Pass =nfApp.LogoWidth. The image is fitted inside it, never stretched.
        DataType: Number
        Default: =32
      OnLinkSelect:
        PropertyKind: Event
        DisplayName: OnLinkSelect
        Description: A link was selected. The screen opens it, for example =Launch(Self.SelectedUrl).
        ReturnType: None
        Default: =false
      OnNavSelect:
        PropertyKind: Event
        DisplayName: OnNavSelect
        Description: A tab was selected. The screen navigates, for example =nfGo(Self.SelectedKey).
        ReturnType: None
        Default: =false
      SelectedKey:
        PropertyKind: Output
        DisplayName: SelectedKey
        Description: Key of the tab the user selected. Read it in OnNavSelect.
        DataType: Text
      SelectedUrl:
        PropertyKind: Output
        DisplayName: SelectedUrl
        Description: Url of the link the user selected. Read it in OnLinkSelect.
        DataType: Text
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
        DataType: Record
        Default: |-
          ={
              Primary: RGBA(0, 82, 136, 1),
              PrimaryDark: RGBA(0, 62, 103, 1),
              PrimarySoft: RGBA(214, 227, 236, 1),
              OnPrimary: RGBA(255, 255, 255, 1),
              HeaderFill: RGBA(0, 43, 71, 1),
              HeaderInk: RGBA(255, 255, 255, 1),
              HeaderInk2: RGBA(214, 227, 236, 1),
              Page: RGBA(237, 238, 238, 1),
              Surface: RGBA(255, 255, 255, 1),
              Sunk: RGBA(248, 248, 249, 1),
              Line: RGBA(222, 223, 224, 1),
              Ink: RGBA(25, 25, 26, 1),
              Ink2: RGBA(68, 69, 71, 1),
              Ink3: RGBA(90, 91, 93, 1),
              Focus: RGBA(0, 120, 174, 1),
              Danger: RGBA(196, 18, 48, 1),
              DangerSoft: RGBA(246, 217, 222, 1),
              NeutralInk: RGBA(68, 69, 71, 1),
              NeutralSoft: RGBA(229, 229, 229, 1),
              InfoInk: RGBA(0, 62, 103, 1),
              InfoSoft: RGBA(214, 233, 242, 1),
              WarningInk: RGBA(92, 72, 9, 1),
              WarningSoft: RGBA(250, 243, 209, 1),
              SuccessInk: RGBA(49, 79, 26, 1),
              SuccessSoft: RGBA(229, 238, 222, 1),
              DangerInk: RGBA(102, 9, 25, 1),
              Hover: RGBA(0, 82, 136, 0.08),
              Pressed: RGBA(0, 82, 136, 0.16),
              Scrim: RGBA(25, 25, 26, 0.5),
              Transparent: RGBA(0, 0, 0, 0)
          }
      Title:
        PropertyKind: Input
        DisplayName: Title
        Description: The app name.
        DataType: Text
        Default: ="App name"
      UserImage:
        PropertyKind: Input
        DisplayName: UserImage
        Description: Signed in user's photo. Pass =User().Image. Initials show when it is blank.
        DataType: Image
        Default: =Blank()
      WelcomeName:
        PropertyKind: Input
        DisplayName: WelcomeName
        Description: Signed in user's full name. Shown as initials when there is no photo.
        DataType: Text
        Default: =""
    Properties:
      Fill: =cmpHeader.Theme.HeaderFill
      Height: =56
      SelectedKey: =_hdrSelectedKey
      SelectedUrl: =_hdrSelectedUrl
      Width: =1366
    Children:
      - conHdrBar:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =cmpHeader.Theme.HeaderFill
            Height: =Parent.Height
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            LayoutGap: =12
            PaddingLeft: =If(cmpHeader.Layout = "Phone", 16, 24)
            PaddingRight: =If(cmpHeader.Layout = "Phone", 16, 24)
            Width: =Parent.Width
          Children:
            - imgHdrLogo:
                Control: Image@2.2.3
                Properties:
                  Height: =32
                  Image: =cmpHeader.Logo
                  Visible: =!IsBlank(cmpHeader.Logo)
                  Width: =cmpHeader.LogoWidth
            - lblHdrTitle:
                Control: ModernText@1.0.0
                Properties:
                  AutoHeight: =true
                  Color: =cmpHeader.Theme.HeaderInk
                  FillPortions: =If(cmpHeader.Layout = "Phone", 1, 0)
                  FontWeight: =FontWeight.Semibold
                  LayoutMinWidth: =0
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =If(cmpHeader.Layout = "Phone", 14, 16)
                  Text: =cmpHeader.Title
                  Width: =If(cmpHeader.Layout = "Phone", 0, 200)
                  Wrap: =false
            - conHdrTabs:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =cmpHeader.Theme.Transparent
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =4
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Visible: =!(cmpHeader.Layout = "Phone")
                Children:
                  - conHdrTab1:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =cmpHeader.Theme.Transparent
                        FillPortions: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =CountRows(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff)) >= 1
                        Width: =Len(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count & ")", "")) * 8 + 32
                      Children:
                        - btnHdrTab1:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: =Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count & ")", "") & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key = cmpHeader.ActiveKey, ", current page", "")
                              AlignInContainer: =AlignInContainer.Stretch
                              Appearance: =ButtonAppearance.Transparent
                              Color: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key = cmpHeader.ActiveKey, cmpHeader.Theme.HeaderInk, cmpHeader.Theme.HeaderInk2)
                              FillPortions: =1
                              FontWeight: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key = cmpHeader.ActiveKey, FontWeight.Semibold, FontWeight.Normal)
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              OnSelect: |-
                                =Set(_hdrSelectedKey, Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key);
                                cmpHeader.OnNavSelect()
                              Size: =14
                              Text: =Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count & ")", "")
                        - conHdrMark1:
                            Control: GroupContainer@1.5.0
                            Variant: ManualLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key = cmpHeader.ActiveKey, cmpHeader.Theme.HeaderInk, cmpHeader.Theme.Transparent)
                              FillPortions: =0
                              Height: =3
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                  - conHdrTab2:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =cmpHeader.Theme.Transparent
                        FillPortions: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =CountRows(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff)) >= 2
                        Width: =Len(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Count & ")", "")) * 8 + 32
                      Children:
                        - btnHdrTab2:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: =Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Count & ")", "") & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Key = cmpHeader.ActiveKey, ", current page", "")
                              AlignInContainer: =AlignInContainer.Stretch
                              Appearance: =ButtonAppearance.Transparent
                              Color: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Key = cmpHeader.ActiveKey, cmpHeader.Theme.HeaderInk, cmpHeader.Theme.HeaderInk2)
                              FillPortions: =1
                              FontWeight: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Key = cmpHeader.ActiveKey, FontWeight.Semibold, FontWeight.Normal)
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              OnSelect: |-
                                =Set(_hdrSelectedKey, Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Key);
                                cmpHeader.OnNavSelect()
                              Size: =14
                              Text: =Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Count & ")", "")
                        - conHdrMark2:
                            Control: GroupContainer@1.5.0
                            Variant: ManualLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Key = cmpHeader.ActiveKey, cmpHeader.Theme.HeaderInk, cmpHeader.Theme.Transparent)
                              FillPortions: =0
                              Height: =3
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                  - conHdrTab3:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =cmpHeader.Theme.Transparent
                        FillPortions: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =CountRows(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff)) >= 3
                        Width: =Len(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Count & ")", "")) * 8 + 32
                      Children:
                        - btnHdrTab3:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: =Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Count & ")", "") & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Key = cmpHeader.ActiveKey, ", current page", "")
                              AlignInContainer: =AlignInContainer.Stretch
                              Appearance: =ButtonAppearance.Transparent
                              Color: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Key = cmpHeader.ActiveKey, cmpHeader.Theme.HeaderInk, cmpHeader.Theme.HeaderInk2)
                              FillPortions: =1
                              FontWeight: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Key = cmpHeader.ActiveKey, FontWeight.Semibold, FontWeight.Normal)
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              OnSelect: |-
                                =Set(_hdrSelectedKey, Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 3)).Key);
