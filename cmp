ComponentDefinitions:
  cmpConfirmDialog:
    DefinitionType: CanvasComponent
    CustomProperties:
      CancelLabel:
        PropertyKind: Input
        DisplayName: CancelLabel
        Description: Cancel button text.
        DataType: Text
        Default: ="Go back"
      ConfirmLabel:
        PropertyKind: Input
        DisplayName: ConfirmLabel
        Description: Confirm button text. Name the action, for example Delete request.
        DataType: Text
        Default: ="Confirm"
      IsDanger:
        PropertyKind: Input
        DisplayName: IsDanger
        Description: Colours the confirm button as destructive.
        DataType: Boolean
        Default: =false
      IsPhone:
        PropertyKind: Input
        DisplayName: IsPhone
        Description: Pass =nfIsPhone. Shows the dialog as a bottom sheet.
        DataType: Boolean
        Default: =false
      Message:
        PropertyKind: Input
