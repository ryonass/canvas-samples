Screens:
  scr_IGCEDetails:
    Properties:
      Fill: =nfColor.Page
      OnVisible: =ClearCollect(colSublines, Filter([@IGCESubLine], IGCELineID = gl_IGCELine.ID))
    Children:
      - con_Shell_Details:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmp_Header_Details:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: =""
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  IsStaff: =false
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Links: =nfHeaderLinks
                  Logo: =nfLogo
                  LogoWidth: =nfApp.LogoWidth
                  OnLinkSelect: =If(Self.SelectedUrl = "app:help", Navigate(scr_Help, ScreenTransition.Fade), Launch(Self.SelectedUrl))
                  OnNavSelect: =false
                  Theme: =nfColor
                  Title: |-
                    ="PR: " & gl_PRTracker & " | IGCE: " & gl_IGCE.ID
                  UserImage: =User().Image
                  WelcomeName: =nf_User.DisplayName
            - con_ActionBar_Details:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
                  FillPortions: =0
                  Height: =nfSize.Control + 2 * nfSpace.Sm
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =nfSpace.Sm
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                Children:
                  - btn_Back_Details:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Back"
                        Appearance: =ButtonAppearance.Subtle
                        DisplayMode: =If(gl_FormMode = FormMode.View, DisplayMode.Edit, DisplayMode.View)
                        Height: =nfSize.Control
                        Icon: ="ArrowLeft"
                        Layout: =If(nfIsPhone, ButtonLayout.IconOnly, ButtonLayout.IconBefore)
                        OnSelect: |
                          =Set(gl_FormMode, FormMode.View);
                          Back(ScreenTransition.Fade);
                        RadiusBottomLeft: =4
                        RadiusBottomRight: =4
                        RadiusTopLeft: =4
                        RadiusTopRight: =4
                        Size: =nfType.Body
                        Text: ="Back"
                        Tooltip: ="Back"
                        Width: =If(nfIsPhone, nfSize.Control, 90)
                  - con_ActionGap_Details:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        Height: =1
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                  - btn_View_1:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Stop editing"
                        Appearance: =ButtonAppearance.Secondary
                        Height: =nfSize.Control
                        Icon: ="Dismiss"
                        Layout: =If(nfIsPhone, ButtonLayout.IconOnly, ButtonLayout.IconBefore)
                        OnSelect: =Set(gl_FormMode,FormMode.View)
                        Size: =nfType.Body
                        Text: ="Stop editing"
                        Tooltip: ="Stop editing"
                        Visible: =gl_FormMode = FormMode.Edit
                        Width: =If(nfIsPhone, nfSize.Control, 130)
                  - btn_TopEdit_Details:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Edit"
                        Height: =nfSize.Control
                        Icon: ="Edit"
                        OnSelect: =Set(gl_FormMode,FormMode.Edit)
                        Size: =nfType.Body
                        Text: ="Edit"
                        Tooltip: ="Edit"
                        Visible: =gl_FormMode = FormMode.View && gl_IGCE.Status.Value <> "Complete"
                        Width: =90
                  - btn_TopSave_Details:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Save"
                        Height: =nfSize.Control
                        Icon: ="Save"
                        OnSelect: |-
                          =Set(
                              gl_IGCELine,
                              Patch(
                                  [@IGCELine],
                                  gl_IGCELine,
                                  {
                                      Description: cmp_LineDescription_Details.Value,
                                      Labor: cmp_Labor_Details.Value,
                                      Category: cmp_Category_Details.Value
                                  }
                              )
                          );
                          If(
                              IsEmpty(Errors([@IGCELine])),
                              Notify("Line saved.", NotificationType.Success);
                              Set(gl_FormMode, FormMode.View),
                              Notify("The line was not saved. " & First(Errors([@IGCELine])).Message, NotificationType.Error)
                          )
                        Size: =nfType.Body
                        Text: ="Save"
                        Tooltip: ="Save"
                        Visible: =!(gl_FormMode = FormMode.View)
                        Width: =90
            - con_ActionRule_Details:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - con_Main_Details:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  LayoutOverflowY: =LayoutOverflow.Scroll
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingTop: =nfSpace.Xl
                Children:
                  - con_Line_Details:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.SetByContainer
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        FillPortions: =0
                        Height: |-
                          =Sum(
                              Self.PaddingTop,
                              Self.PaddingBottom,
                              lbl_LineTitle_Details.Height,
                              con_LineTable_Details.Height,
                              Self.LayoutGap
                          )
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =8
                        LayoutMaxHeight: =
                        LayoutMaxWidth: =
                        PaddingBottom: =16
                        PaddingLeft: =16
                        PaddingRight: =16
                        PaddingTop: =16
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                      Children:
                        - lbl_LineTitle_Details:
                            Control: ModernText@1.0.0
                            Properties:
                              Color: =nfColor.Ink
                              FontWeight: =FontWeight.Semibold
                              Height: =30
                              LayoutMinWidth: =96
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              RadiusBottomLeft: =0
                              RadiusBottomRight: =0
                              RadiusTopLeft: =0
                              RadiusTopRight: =0
                              Size: =nfType.H2
                              Text: ="Line"
                              VerticalAlign: =VerticalAlign.Top
                              Width: =Parent.Width
                        - con_LineTable_Details:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.SetByContainer
                              BorderStyle: =BorderStyle.None
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: |-
                                =If(
                                    nfIsPhone,
                                    Sum(
                                        If(cmp_LineNumber_Details.Visible, cmp_LineNumber_Details.Height + 8, 0),
                                        If(cmp_Labor_Details.Visible, cmp_Labor_Details.Height + 8, 0),
                                        If(cmp_Category_Details.Visible, cmp_Category_Details.Height + 8, 0),
                                        If(cmp_LineDescription_Details.Visible, cmp_LineDescription_Details.Height + 8, 0),
                                        If(btn_DeleteLine_Details.Visible, btn_DeleteLine_Details.Height + 8, 0)
                                    ) - 8,
                                    90
                                )
                              LayoutAlignItems: =If(nfIsPhone, LayoutAlignItems.Stretch, LayoutAlignItems.Center)
                              LayoutDirection: =If(nfIsPhone, LayoutDirection.Vertical, LayoutDirection.Horizontal)
                              LayoutGap: =8
                              LayoutMaxHeight: =
                              LayoutMaxWidth: =
                              LayoutOverflowX: =If(nfIsPhone, LayoutOverflow.Hide, LayoutOverflow.Scroll)
                            Children:
                              - cmp_LineNumber_Details:
                                  Control: CanvasComponent
                                  ComponentName: cmp_Text
                                  Properties:
                                    CustomValidationError: =""
                                    DefaultValue: =gl_IGCELine.LineNumber
                                    DisplayMode: =DisplayMode.Disabled
                                    Height: =76
                                    Label: =DataSourceInfo([@IGCELine],DataSourceInfo.DisplayName,'Line Number')
                                    LayoutMaxHeight: =
                                    LayoutMaxWidth: =
                                    Required: =false
                                    Theme: =nfColor
                                    Width: =150
                              - cmp_Labor_Details:
                                  Control: CanvasComponent
                                  ComponentName: cmp_Boolean
                                  Properties:
                                    DefaultValue: =gl_IGCELine.Labor//If(IsBlank(gl_IGCELine.Labor),false,gl_IGCELine.Labor)
                                    DisplayMode: |-
                                      =If(
                                          gl_FormMode = FormMode.Edit,
                                          Switch(
                                              gl_IGCELine.Category.Value,
                                              "Standard Line",
                                              DisplayMode.Edit,
                                              "Products/Supplies",
                                              DisplayMode.Edit,
                                              DisplayMode.Disabled
                                          ),
                                          gl_FormMode
                                      )
                                    Height: =76
                                    Label: =DataSourceInfo([@IGCELine],DataSourceInfo.DisplayName,Labor)
                                    LayoutMaxHeight: =
                                    LayoutMaxWidth: =
                                    OnCheck: =
                                    OnUncheck: =
                                    Theme: =nfColor
                                    Width: =50
                              - cmp_Category_Details:
                                  Control: CanvasComponent
                                  ComponentName: cmp_Combobox
                                  Properties:
                                    CustomValidationError: =""
                                    DefaultValue: ={Value:gl_IGCELine.Category.Value}
                                    DisplayMode: =If(gl_FormMode=FormMode.View,DisplayMode.View,DisplayMode.Edit)
                                    Height: =76
                                    Items: =Choices([@IGCELine].Category).Value
                                    Label: =DataSourceInfo([@IGCELine],DataSourceInfo.DisplayName,Category)
                                    OnChange: =
                                    Required: =false
                                    Theme: =nfColor
                                    Width: =250
                              - cmp_LineDescription_Details:
                                  Control: CanvasComponent
                                  ComponentName: cmp_Text
                                  Properties:
                                    CustomValidationError: =""
                                    DefaultValue: =gl_IGCELine.Description
                                    DisplayMode: =If(gl_FormMode=FormMode.View,DisplayMode.View,DisplayMode.Edit)
                                    FillPortions: =If(nfIsPhone, 0, 1)
                                    Height: =76
                                    Label: =DataSourceInfo([@IGCELine],DataSourceInfo.DisplayName,Description)
                                    LayoutMaxHeight: =
                                    LayoutMaxWidth: =
                                    Required: =false
                                    Theme: =nfColor
                                    Width: =150
                              - btn_DeleteLine_Details:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    AccessibleLabel: ="Delete this line"
                                    Align: =Align.Center
                                    Appearance: =ButtonAppearance.Secondary
                                    BasePaletteColor: =nfColor.Danger
                                    DisplayMode: =If(!(gl_IGCE.Status.Value = "Complete") && (gl_IGCELine.Category.Value = "Standard Line" || gl_IGCELine.Category.Value = "Products/Supplies"), DisplayMode.Edit, DisplayMode.Disabled)
                                    Height: =nfSize.Control
                                    Icon: ="Delete"
                                    OnSelect: |-
                                      =UpdateContext({ locDeleteLine: true })
                                    PaddingBottom: =0
                                    PaddingLeft: =8
                                    PaddingRight: =8
                                    PaddingTop: =0
                                    RadiusBottomLeft: =4
                                    RadiusBottomRight: =4
                                    RadiusTopLeft: =4
                                    RadiusTopRight: =4
                                    Size: =nfType.Body
                                    Text: ="Delete line"
                                    VerticalAlign: =VerticalAlign.Middle
                                    Width: =136
                  - con_Subline_Details:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.SetByContainer
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        FillPortions: =0
                        Height: |-
                          =Sum(
                              Self.PaddingTop,
                              Self.PaddingBottom,
                              con_SublineTitle_Details.Height,
                              If(IsEmpty(colSublines), cmp_SublinesEmpty_Details.Height, con_SublineTable_Details.Height),
                              Self.LayoutGap
                          )
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =8
                        LayoutMaxHeight: =
                        LayoutMaxWidth: =
                        LayoutMinHeight: =200
                        PaddingBottom: =16
                        PaddingLeft: =16
                        PaddingRight: =16
                        PaddingTop: =16
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Visible: =true//!IsBlank(gl_IGCELine.Category.Value)
                        Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                      Children:
                        - con_SublineTitle_Details:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.SetByContainer
                              DropShadow: =DropShadow.None
                              FillPortions: =0
                              Height: =32
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =8
                              LayoutMaxHeight: =
                              LayoutMaxWidth: =
                              LayoutMinHeight: =40
                              Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                            Children:
                              - lbl_Subline_Details:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    LayoutMinWidth: =96
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    RadiusBottomLeft: =0
                                    RadiusBottomRight: =0
                                    RadiusTopLeft: =0
                                    RadiusTopRight: =0
                                    Size: =nfType.H2
                                    Text: ="Sublines"
                                    VerticalAlign: =VerticalAlign.Top
                                    Width: =Parent.Width - Parent.LayoutGap - btn_AddSubline_Details.Width
                              - btn_AddSubline_Details:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    Align: =Align.Center
                                    DisplayMode: =If(gl_IGCE.Status.Value = "Complete", DisplayMode.Disabled, DisplayMode.Edit)
                                    FontWeight: =FontWeight.Bold
                                    Height: =nfSize.Control
                                    Icon: ="Add"
                                    OnSelect: |-
                                      =UpdateContext({ locSubline: Blank(), locSublineNew: true, locSublineDialog: true });
                                      Reset(txt_DlgRef_Details);
                                      Reset(txt_DlgDescription_Details);
                                      Reset(drp_DlgType_Details);
                                      Reset(drp_DlgUnits_Details);
                                      Reset(rad_DlgCalcOPs_Details);
                                      Reset(drp_DlgODCCategory_Details);
                                      Reset(rad_DlgSoftware_Details);
                                      Reset(rad_DlgIncludesProperty_Details);
                                      Reset(drp_DlgPropertyType_Details);
                                      Reset(txt_DlgSerial_Details);
                                      Reset(txt_DlgQuantity_Details);
                                      Reset(txt_DlgRate_Details);
                                      Reset(txt_DlgOP1Quantity_Details);
                                      Reset(txt_DlgOP1Rate_Details);
                                      Reset(txt_DlgOP2Quantity_Details);
                                      Reset(txt_DlgOP2Rate_Details);
                                      Reset(txt_DlgOP3Quantity_Details);
                                      Reset(txt_DlgOP3Rate_Details);
                                      Reset(txt_DlgOP4Quantity_Details);
                                      Reset(txt_DlgOP4Rate_Details)
                                    PaddingBottom: =0
                                    PaddingLeft: =8
                                    PaddingRight: =8
                                    PaddingTop: =0
                                    RadiusBottomLeft: =4
                                    RadiusBottomRight: =4
                                    RadiusTopLeft: =4
                                    RadiusTopRight: =4
                                    Text: ="Add subline"
                                    VerticalAlign: =VerticalAlign.Middle
                                    Width: =136
                        - cmp_SublinesEmpty_Details:
                            Control: CanvasComponent
                            ComponentName: cmpStatePanel
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              Height: =180
                              IsPhone: =nfIsPhone
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Message: ="Add a subline to cost this line."
                              OnPrimary: =Select(btn_AddSubline_Details)
                              OnSecondary: =false
                              PrimaryText: =If(gl_IGCE.Status.Value = "Complete", "", "Add subline")
                              SecondaryText: =""
                              Theme: =nfColor
                              Title: ="No sublines yet"
                              Variant: ="Empty"
                              Visible: =IsEmpty(colSublines)
                        - con_SublineTable_Details:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              AlignInContainer: =AlignInContainer.SetByContainer
                              BorderColor: =nfColor.Line
                              BorderThickness: =1
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Surface
                              Height: =con_TableFields_Details.Height + gal_Sublines_Details.Height + con_SublineFooter_Details.Height + 2
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutMaxHeight: =
                              LayoutMaxWidth: =
                              LayoutMinHeight: =0
                              RadiusBottomLeft: =nfRadius.Md
                              RadiusBottomRight: =nfRadius.Md
                              RadiusTopLeft: =nfRadius.Md
                              RadiusTopRight: =nfRadius.Md
                              Visible: =!(IsEmpty(colSublines))
                              Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                            Children:
                              - con_TableFields_Details:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Sunk
                                    FillPortions: =0
                                    Height: =40
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutGap: =If(con_SublineTable_Details.Width >= 620, nfSpace.Md, nfSpace.Sm)
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    PaddingLeft: =If(con_SublineTable_Details.Width >= 620, nfSpace.Md, nfSpace.Sm)
                                    PaddingRight: =If(con_SublineTable_Details.Width >= 620, nfSpace.Md, nfSpace.Sm)
                                  Children:
                                    - lbl_HdrRef_Details:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper("#")
                                          Visible: =con_SublineTable_Details.Width >= 620
                                          Width: =72
                                          Wrap: =false
                                    - lbl_HdrDescription_Details:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FillPortions: =1
                                          FontWeight: =FontWeight.Semibold
                                          LayoutMinWidth: =90
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper("Description")
                                          Wrap: =false
                                    - lbl_HdrQty_Details:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Align: =Align.Right
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper(Switch(gl_IGCELine.Category.Value, "Travel", "Trips", If(cmp_Labor_Details.Value, "Base hours", "Base qty")))
                                          Visible: =con_SublineTable_Details.Width >= 900
                                          Width: =110
                                          Wrap: =false
                                    - lbl_HdrRate_Details:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Align: =Align.Right
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper(Switch(gl_IGCELine.Category.Value, "Travel", "Not to exceed", "Unit price"))
                                          Visible: =con_SublineTable_Details.Width >= 900
                                          Width: =120
                                          Wrap: =false
                                    - lbl_HdrBase_Details:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Align: =Align.Right
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper("Base year")
                                          Visible: =con_SublineTable_Details.Width >= 620
                                          Width: =130
                                          Wrap: =false
                                    - lbl_HdrOPs_Details:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Align: =Align.Right
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper("Option periods")
                                          Visible: =con_SublineTable_Details.Width >= 620 && gl_IGCE.'Option Periods' > 0
                                          Width: =140
                                          Wrap: =false
                                    - lbl_HdrTotal_Details:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Align: =Align.Right
                                          AlignInContainer: =AlignInContainer.Stretch
                                          Color: =nfColor.Ink2
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =Upper("Total")
                                          Width: =If(con_SublineTable_Details.Width >= 620, 130, 100)
                                          Wrap: =false
                                    - con_HdrActions_Details:
                                        Control: GroupContainer@1.5.0
                                        Variant: ManualLayout
                                        Properties:
                                          DropShadow: =DropShadow.None
                                          Fill: =nfColor.Transparent
                                          FillPortions: =0
                                          Height: =1
                                          LayoutMinHeight: =0
                                          LayoutMinWidth: =0
                                          Width: =72
                              - gal_Sublines_Details:
                                  Control: Gallery@2.15.0
                                  Variant: BrowseLayout_Vertical_OneTextVariant_ver5.0
                                  Properties:
                                    AccessibleLabel: ="Sublines"
                                    FillPortions: =0
                                    Height: =(If(con_SublineTable_Details.Width >= 900, 44, 60)) * CountRows(colSublines)
                                    Items: |-
                                      =Sort(colSublines, 'Ref #')
                                    LayoutMinHeight: =0
                                    LayoutMinWidth: =0
                                    TemplateSize: =If(con_SublineTable_Details.Width >= 900, 44, 60)
                                  Children:
                                    - con_TableRecords_Details:
                                        Control: GroupContainer@1.5.0
                                        Variant: AutoLayout
                                        Properties:
                                          DropShadow: =DropShadow.None
                                          Fill: =nfColor.Transparent
                                          Height: =Parent.TemplateHeight - 1
                                          LayoutAlignItems: =LayoutAlignItems.Stretch
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutGap: =If(con_SublineTable_Details.Width >= 620, nfSpace.Md, nfSpace.Sm)
                                          PaddingLeft: =If(con_SublineTable_Details.Width >= 620, nfSpace.Md, nfSpace.Sm)
                                          PaddingRight: =If(con_SublineTable_Details.Width >= 620, nfSpace.Md, nfSpace.Sm)
                                          Width: =Parent.TemplateWidth
                                        Children:
                                          - lbl_Ref_Details:
                                              Control: ModernText@1.0.0
                                              Properties:
                                                AlignInContainer: =AlignInContainer.Stretch
                                                Color: =nfColor.Ink2
                                                PaddingBottom: =0
                                                PaddingLeft: =0
                                                PaddingRight: =0
                                                PaddingTop: =0
                                                Size: =nfType.Body
                                                Text: |-
                                                  =ThisItem.'Ref #'
                                                Visible: =con_SublineTable_Details.Width >= 620
                                                Width: =72
                                                Wrap: =false
                                          - con_Description_Details:
                                              Control: GroupContainer@1.5.0
                                              Variant: AutoLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                Fill: =nfColor.Transparent
                                                LayoutDirection: =LayoutDirection.Vertical
                                                LayoutGap: =2
                                                LayoutJustifyContent: =LayoutJustifyContent.Center
                                                LayoutMinHeight: =0
                                                LayoutMinWidth: =90
                                              Children:
                                                - lbl_Description_Details:
                                                    Control: ModernText@1.0.0
                                                    Properties:
                                                      AlignInContainer: =AlignInContainer.Stretch
                                                      Color: =nfColor.Ink
                                                      FontWeight: =FontWeight.Semibold
                                                      Height: =22
