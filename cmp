ComponentDefinitions:
  cmpHeader:
    DefinitionType: CanvasComponent
    CustomProperties:
      ActiveKey:
        PropertyKind: Input
        DisplayName: ActiveKey
        Description: Key of the main tab to show as active.
        DataType: Text
        Default: ="home"
      IsStaff:
        PropertyKind: Input
        DisplayName: IsStaff
        Description: Pass =gblIsStaff. StaffOnly tabs are hidden when false.
        DataType: Boolean
        Default: =false
      Items:
        PropertyKind: Input
        DisplayName: Items
        Description: Main tabs. Pass =nfNavMain. Same columns as cmpBottomNav.
        DataType: Table
        Default: |-
          =Table({ Key: "home", Label: "Home", Count: 0, StaffOnly: false }, { Key: "list", Label: "List", Count: 3, StaffOnly: false })
      Layout:
        PropertyKind: Input
        DisplayName: Layout
        Description: Pass =nfLayout. Phone, Tablet or Desktop.
        DataType: Text
        Default: ="Desktop"
      Links:
        PropertyKind: Input
        DisplayName: Links
        Description: Links on the right, in order. Pass =nfHeaderLinks. Columns Label and Url. A row with a blank Url is hidden. Up to four show, and only the first on a phone.
        DataType: Table
        Default: |-
          =Table({ Label: "Help", Url: "https://example.gov/help" })
      Logo:
        PropertyKind: Input
        DisplayName: Logo
        Description: Logo, drawn 32 high. Pass =nfLogo, an image added to the app under Media (SVG or PNG). Hidden when blank.
        DataType: Image
        Default: =Blank()
      LogoWidth:
        PropertyKind: Input
        DisplayName: LogoWidth
        Description: Logo width. Pass =nfApp.LogoWidth. The image is fitted inside it, never stretched.
        DataType: Number
        Default: =32
      OnLinkSelect:
        PropertyKind: Event
        DisplayName: OnLinkSelect
        Description: A link was selected. The screen opens it, for example =Launch(Self.SelectedUrl).
        ReturnType: None
        Default: =false
      OnNavSelect:
        PropertyKind: Event
        DisplayName: OnNavSelect
        Description: A tab was selected. The screen navigates, for example =nfGo(Self.SelectedKey).
        ReturnType: None
        Default: =false
      SelectedKey:
        PropertyKind: Output
        DisplayName: SelectedKey
        Description: Key of the tab the user selected. Read it in OnNavSelect.
        DataType: Text
      SelectedUrl:
        PropertyKind: Output
        DisplayName: SelectedUrl
        Description: Url of the link the user selected. Read it in OnLinkSelect.
        DataType: Text
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
        DataType: Record
        Default: |-
          ={
              Primary: RGBA(0, 82, 136, 1),
              PrimaryDark: RGBA(0, 62, 103, 1),
              PrimarySoft: RGBA(214, 227, 236, 1),
              OnPrimary: RGBA(255, 255, 255, 1),
              HeaderFill: RGBA(0, 43, 71, 1),
              HeaderInk: RGBA(255, 255, 255, 1),
              HeaderInk2: RGBA(214, 227, 236, 1),
              Page: RGBA(237, 238, 238, 1),
              Surface: RGBA(255, 255, 255, 1),
              Sunk: RGBA(248, 248, 249, 1),
              Line: RGBA(222, 223, 224, 1),
              Ink: RGBA(25, 25, 26, 1),
     
