ComponentDefinitions:
  cmpStatusPill:
    DefinitionType: CanvasComponent
    CustomProperties:
      Label:
        PropertyKind: Input
        DisplayName: Label
        Description: Text in the pill. Pass =nfStatusLabel(key).
        DataType: Text
        Default: ="Submitted"
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
        DataType: Record
        Default: |-
          ={
              Primary: RGBA(0, 94, 162, 1),
              PrimaryDark: RGBA(26, 68, 128, 1),
              PrimarySoft: RGBA(217, 232, 246, 1),
              OnPrimary: RGBA(255, 255, 255, 1),
              HeaderFill: RGBA(22, 46, 81, 1),
              HeaderInk: RGBA(255, 255, 255, 1),
              HeaderInk2: RGBA(217, 232, 246, 1),
              Page: RGBA(240, 240, 240, 1),
              Surface: RGBA(255, 255, 255, 1),
              Sunk: RGBA(247, 249, 250, 1),
              Line: RGBA(223, 225, 226, 1),
              Ink: RGBA(27, 27, 27, 1),
              Ink2: RGBA(61, 69, 81, 1),
              Ink3: RGBA(86, 92, 101, 1),
              Focus: RGBA(36, 145, 255, 1),
              Danger: RGBA(181, 9, 9, 1),
              DangerSoft: RGBA(244, 227, 219, 1),
              NeutralInk: RGBA(61, 69, 81, 1),
              NeutralSoft: RGBA(230, 230, 230, 1),
              InfoInk: RGBA(26, 68, 128, 1),
              InfoSoft: RGBA(217, 232, 246, 1),
              WarningInk: RGBA(92, 72, 9, 1),
              WarningSoft: RGBA(250, 243, 209, 1),
              SuccessInk: RGBA(25, 49, 30, 1),
              SuccessSoft: RGBA(236, 243, 236, 1),
              DangerInk: RGBA(111, 51, 49, 1),
              Hover: RGBA(0, 94, 162, 0.08),
              Pressed: RGBA(0, 94, 162, 0.16),
              Scrim: RGBA(27, 27, 27, 0.5),
              Transparent: RGBA(0, 0, 0, 0)
          }
      Tone:
        PropertyKind: Input
        DisplayName: Tone
        Description: Neutral, Info, Warning, Success or Danger. Pass =nfStatusTone(key).
        DataType: Text
        Default: ="Info"
    Properties:
      Fill: =cmpStatusPill.Theme.Transparent
      Height: =24
      Width: =140
    Children:
      - conPillShape:
          Control: GroupContainer@1.5.0
          Variant: ManualLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =Switch(cmpStatusPill.Tone, "Info", cmpStatusPill.Theme.InfoSoft, "Warning", cmpStatusPill.Theme.WarningSoft, "Success", cmpStatusPill.Theme.SuccessSoft, "Danger", cmpStatusPill.Theme.DangerSoft, cmpStatusPill.Theme.NeutralSoft)
            Height: =24
            RadiusBottomLeft: =12
            RadiusBottomRight: =12
            RadiusTopLeft: =12
            RadiusTopRight: =12
            Width: =Min(Parent.Width, Len(cmpStatusPill.Label) * 7 + 24)
            Y: =(Parent.Height - 24) / 2
          Children:
            - lblPill:
                Control: ModernText@1.0.0
                Properties:
                  AccessibleLabel: |-
                    ="Status: " & cmpStatusPill.Label
                  Align: =Align.Center
                  AutoHeight: =true
                  Color: =Switch(cmpStatusPill.Tone, "Info", cmpStatusPill.Theme.InfoInk, "Warning", cmpStatusPill.Theme.WarningInk, "Success", cmpStatusPill.Theme.SuccessInk, "Danger", cmpStatusPill.Theme.DangerInk, cmpStatusPill.Theme.NeutralInk)
                  FontWeight: =FontWeight.Semibold
                  PaddingBottom: =0
                  PaddingLeft: =8
                  PaddingRight: =8
                  PaddingTop: =0
                  Size: =12
                  Text: =cmpStatusPill.Label
                  Width: =Parent.Width
                  Wrap: =false
                  Y: =(Parent.Height - Self.Height) / 2




/---

        ComponentDefinitions:
  cmpFormField:
    DefinitionType: CanvasComponent
    CustomProperties:
      ErrorText:
        PropertyKind: Input
        DisplayName: ErrorText
        Description: Message shown when ShowError is true.
        DataType: Text
        Default: ="This field is required"
      HelpText:
        PropertyKind: Input
        DisplayName: HelpText
        Description: One line of guidance under the label. Hidden when blank.
        DataType: Text
        Default: =""
      Label:
        PropertyKind: Input
        DisplayName: Label
        Description: Visible label. Use the same words in the input's AccessibleLabel.
        DataType: Text
        Default: ="Field label"
      Required:
        PropertyKind: Input
        DisplayName: Required
        Description: Adds a * after the label.
        DataType: Boolean
        Default: =false
      ShowError:
        PropertyKind: Input
        DisplayName: ShowError
        Description: Show ErrorText. Usually =locTried && IsBlank(the input).
        DataType: Boolean
        Default: =false
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
        DataType: Record
        Default: |-
          ={
              Primary: RGBA(0, 94, 162, 1),
              PrimaryDark: RGBA(26, 68, 128, 1),
              PrimarySoft: RGBA(217, 232, 246, 1),
              OnPrimary: RGBA(255, 255, 255, 1),
              HeaderFill: RGBA(22, 46, 81, 1),
              HeaderInk: RGBA(255, 255, 255, 1),
              HeaderInk2: RGBA(217, 232, 246, 1),
              Page: RGBA(240, 240, 240, 1),
              Surface: RGBA(255, 255, 255, 1),
              Sunk: RGBA(247, 249, 250, 1),
              Line: RGBA(223, 225, 226, 1),
              Ink: RGBA(27, 27, 27, 1),
              Ink2: RGBA(61, 69, 81, 1),
              Ink3: RGBA(86, 92, 101, 1),
              Focus: RGBA(36, 145, 255, 1),
              Danger: RGBA(181, 9, 9, 1),
              DangerSoft: RGBA(244, 227, 219, 1),
              NeutralInk: RGBA(61, 69, 81, 1),
              NeutralSoft: RGBA(230, 230, 230, 1),
              InfoInk: RGBA(26, 68, 128, 1),
              InfoSoft: RGBA(217, 232, 246, 1),
              WarningInk: RGBA(92, 72, 9, 1),
              WarningSoft: RGBA(250, 243, 209, 1),
              SuccessInk: RGBA(25, 49, 30, 1),
              SuccessSoft: RGBA(236, 243, 236, 1),
              DangerInk: RGBA(111, 51, 49, 1),
              Hover: RGBA(0, 94, 162, 0.08),
              Pressed: RGBA(0, 94, 162, 0.16),
              Scrim: RGBA(27, 27, 27, 0.5),
              Transparent: RGBA(0, 0, 0, 0)
          }
    Properties:
      Fill: =cmpFormField.Theme.Transparent
      Height: =56
      Width: =320
    Children:
      - lblFfLabel:
          Control: ModernText@1.0.0
          Properties:
            AutoHeight: =true
            Color: =cmpFormField.Theme.Ink
            FontWeight: =FontWeight.Semibold
            PaddingBottom: =0
            PaddingLeft: =0
            PaddingRight: =0
            PaddingTop: =0
            Size: =14
            Text: =cmpFormField.Label & If(cmpFormField.Required, " *", "")
            Width: =Parent.Width
            Wrap: =false
      - lblFfHelp:
          Control: ModernText@1.0.0
          Properties:
            AutoHeight: =true
            Color: =cmpFormField.Theme.Ink3
            PaddingBottom: =0
            PaddingLeft: =0
            PaddingRight: =0
            PaddingTop: =0
            Size: =12
            Text: =cmpFormField.HelpText
            Visible: =!IsBlank(cmpFormField.HelpText)
            Width: =Parent.Width
            Wrap: =false
            Y: =20
      - lblFfError:
          Control: ModernText@1.0.0
          Properties:
            AutoHeight: =true
            Color: =cmpFormField.Theme.Danger
            FontWeight: =FontWeight.Semibold
            PaddingBottom: =0
            PaddingLeft: =0
            PaddingRight: =0
            PaddingTop: =0
            Size: =12
            Text: |-
              ="Error: " & cmpFormField.ErrorText
            Visible: =cmpFormField.ShowError && !IsBlank(cmpFormField.ErrorText)
            Width: =Parent.Width
            Wrap: =false
            Y: =If(!IsBlank(cmpFormField.HelpText), 38, 20)

/---

      ComponentDefinitions:
  cmpConfirmDialog:
    DefinitionType: CanvasComponent
    CustomProperties:
      CancelLabel:
        PropertyKind: Input
        DisplayName: CancelLabel
        Description: Cancel button text.
        DataType: Text
        Default: ="Go back"
      ConfirmLabel:
        PropertyKind: Input
        DisplayName: ConfirmLabel
        Description: Confirm button text. Name the action, for example Delete request.
        DataType: Text
        Default: ="Confirm"
      IsDanger:
        PropertyKind: Input
        DisplayName: IsDanger
        Description: Colours the confirm button as destructive.
        DataType: Boolean
        Default: =false
      IsPhone:
        PropertyKind: Input
        DisplayName: IsPhone
        Description: Pass =nfIsPhone. Shows the dialog as a bottom sheet.
        DataType: Boolean
        Default: =false
      Message:
        PropertyKind: Input
        DisplayName: Message
        Description: One or two sentences on what will happen.
        DataType: Text
        Default: ="This cannot be undone."
      OnCancel:
        PropertyKind: Event
        DisplayName: OnCancel
        Description: Cancel or the backdrop was selected. The screen hides the dialog.
        ReturnType: None
        Default: =false
      OnConfirm:
        PropertyKind: Event
        DisplayName: OnConfirm
        Description: Confirm was selected. The screen does the work, then hides the dialog.
        ReturnType: None
        Default: =false
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
        DataType: Record
        Default: |-
          ={
              Primary: RGBA(0, 94, 162, 1),
              PrimaryDark: RGBA(26, 68, 128, 1),
              PrimarySoft: RGBA(217, 232, 246, 1),
              OnPrimary: RGBA(255, 255, 255, 1),
              HeaderFill: RGBA(22, 46, 81, 1),
              HeaderInk: RGBA(255, 255, 255, 1),
              HeaderInk2: RGBA(217, 232, 246, 1),
              Page: RGBA(240, 240, 240, 1),
              Surface: RGBA(255, 255, 255, 1),
              Sunk: RGBA(247, 249, 250, 1),
              Line: RGBA(223, 225, 226, 1),
              Ink: RGBA(27, 27, 27, 1),
              Ink2: RGBA(61, 69, 81, 1),
              Ink3: RGBA(86, 92, 101, 1),
              Focus: RGBA(36, 145, 255, 1),
              Danger: RGBA(181, 9, 9, 1),
              DangerSoft: RGBA(244, 227, 219, 1),
              NeutralInk: RGBA(61, 69, 81, 1),
              NeutralSoft: RGBA(230, 230, 230, 1),
              InfoInk: RGBA(26, 68, 128, 1),
              InfoSoft: RGBA(217, 232, 246, 1),
              WarningInk: RGBA(92, 72, 9, 1),
              WarningSoft: RGBA(250, 243, 209, 1),
              SuccessInk: RGBA(25, 49, 30, 1),
              SuccessSoft: RGBA(236, 243, 236, 1),
              DangerInk: RGBA(111, 51, 49, 1),
              Hover: RGBA(0, 94, 162, 0.08),
              Pressed: RGBA(0, 94, 162, 0.16),
              Scrim: RGBA(27, 27, 27, 0.5),
              Transparent: RGBA(0, 0, 0, 0)
          }
      Title:
        PropertyKind: Input
        DisplayName: Title
        Description: Dialog heading, phrased as the question.
        DataType: Text
        Default: ="Are you sure?"
    Properties:
      Fill: =cmpConfirmDialog.Theme.Transparent
      Height: =768
      Width: =1366
    Children:
      - btnCdScrim:
          Control: Classic/Button@2.2.0
          Properties:
            BorderStyle: =BorderStyle.None
            BorderThickness: =0
            Fill: =cmpConfirmDialog.Theme.Scrim
            FocusedBorderThickness: =2
            Height: =Parent.Height
            HoverBorderColor: =cmpConfirmDialog.Theme.Transparent
            HoverFill: =cmpConfirmDialog.Theme.Scrim
            OnSelect: =cmpConfirmDialog.OnCancel()
            PressedBorderColor: =cmpConfirmDialog.Theme.Transparent
            PressedFill: =cmpConfirmDialog.Theme.Scrim
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Text: =""
            Tooltip: ="Close dialog"
            Width: =Parent.Width
      - conCdCard:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.Bold
            Fill: =cmpConfirmDialog.Theme.Surface
            Height: =If(cmpConfirmDialog.IsPhone, 232, 216)
            LayoutDirection: =LayoutDirection.Vertical
            LayoutGap: =12
            PaddingBottom: =If(cmpConfirmDialog.IsPhone, 32, 24)
            PaddingLeft: =24
            PaddingRight: =24
            PaddingTop: =24
            RadiusBottomLeft: =If(cmpConfirmDialog.IsPhone, 0, 12)
            RadiusBottomRight: =If(cmpConfirmDialog.IsPhone, 0, 12)
            RadiusTopLeft: =12
            RadiusTopRight: =12
            Width: =If(cmpConfirmDialog.IsPhone, Parent.Width, Min(440, Parent.Width - 32))
            X: =If(cmpConfirmDialog.IsPhone, 0, (Parent.Width - Self.Width) / 2)
            Y: =If(cmpConfirmDialog.IsPhone, Parent.Height - Self.Height, (Parent.Height - Self.Height) / 2)
          Children:
            - lblCdTitle:
                Control: ModernText@1.0.0
                Properties:
                  AlignInContainer: =AlignInContainer.Stretch
                  AutoHeight: =true
                  Color: =cmpConfirmDialog.Theme.Ink
                  FontWeight: =FontWeight.Semibold
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =18
                  Text: =cmpConfirmDialog.Title
            - lblCdMessage:
                Control: ModernText@1.0.0
                Properties:
                  AlignInContainer: =AlignInContainer.Stretch
                  AutoHeight: =true
                  Color: =cmpConfirmDialog.Theme.Ink2
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =14
                  Text: =cmpConfirmDialog.Message
            - conCdButtons:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =cmpConfirmDialog.Theme.Transparent
                  FillPortions: =0
                  Height: =40
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =8
                  LayoutJustifyContent: =LayoutJustifyContent.End
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                Children:
                  - btnCdCancel:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =cmpConfirmDialog.CancelLabel
                        Appearance: =ButtonAppearance.Secondary
                        Height: =40
                        OnSelect: =cmpConfirmDialog.OnCancel()
                        Size: =14
                        Text: =cmpConfirmDialog.CancelLabel
                        Width: =If(cmpConfirmDialog.IsPhone, (Parent.Width - 8) / 2, 120)
                  - btnCdConfirm:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =cmpConfirmDialog.ConfirmLabel
                        BasePaletteColor: =If(cmpConfirmDialog.IsDanger, cmpConfirmDialog.Theme.Danger, cmpConfirmDialog.Theme.Primary)
                        Height: =40
                        OnSelect: =cmpConfirmDialog.OnConfirm()
                        Size: =14
                        Text: =cmpConfirmDialog.ConfirmLabel
                        Width: =If(cmpConfirmDialog.IsPhone, (Parent.Width - 8) / 2, 160)

/---
        ComponentDefinitions:
  cmpHeader:
    DefinitionType: CanvasComponent
    CustomProperties:
      ActiveKey:
        PropertyKind: Input
        DisplayName: ActiveKey
        Description: Key of the main tab to show as active.
        DataType: Text
        Default: ="home"
      HubUrl:
        PropertyKind: Input
        DisplayName: HubUrl
        Description: Services Hub address. The link is hidden when blank.
        DataType: Text
        Default: =""
      IsStaff:
        PropertyKind: Input
        DisplayName: IsStaff
        Description: Pass =gblIsStaff. StaffOnly tabs are hidden when false.
        DataType: Boolean
        Default: =false
      Items:
        PropertyKind: Input
        DisplayName: Items
        Description: Main tabs. Pass =nfNavMain. Same columns as cmpTopNav.
        DataType: Table
        Default: |-
          =Table({ Key: "home", Label: "Home", Count: 0, StaffOnly: false }, { Key: "list", Label: "List", Count: 3, StaffOnly: false })
      Layout:
        PropertyKind: Input
        DisplayName: Layout
        Description: Pass =nfLayout. Phone, Tablet or Desktop.
        DataType: Text
        Default: ="Desktop"
      Logo:
        PropertyKind: Input
        DisplayName: Logo
        Description: Logo, 32 by 32. Pass =nfLogo, built from the SVG in nfApp.LogoSvg. Hidden when blank.
        DataType: Image
        Default: =Blank()
      OnHubSelect:
        PropertyKind: Event
        DisplayName: OnHubSelect
        Description: The Services Hub link was selected. The screen launches the URL.
        ReturnType: None
        Default: =false
      OnNavSelect:
        PropertyKind: Event
        DisplayName: OnNavSelect
        Description: A tab was selected. The screen navigates, for example =nfGo(Self.SelectedKey).
        ReturnType: None
        Default: =false
      OnRightAction:
        PropertyKind: Event
        DisplayName: OnRightAction
        Description: The right hand button was selected.
        ReturnType: None
        Default: =false
      RightActionLabel:
        PropertyKind: Input
        DisplayName: RightActionLabel
        Description: Optional button before the initials. Hidden when blank.
        DataType: Text
        Default: =""
      SelectedKey:
        PropertyKind: Output
        DisplayName: SelectedKey
        Description: Key of the tab the user selected. Read it in OnNavSelect.
        DataType: Text
      ShowHubLink:
        PropertyKind: Input
        DisplayName: ShowHubLink
        Description: Show the Services Hub link.
        DataType: Boolean
        Default: =true
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
        DataType: Record
        Default: |-
          ={
              Primary: RGBA(0, 94, 162, 1),
              PrimaryDark: RGBA(26, 68, 128, 1),
              PrimarySoft: RGBA(217, 232, 246, 1),
              OnPrimary: RGBA(255, 255, 255, 1),
              HeaderFill: RGBA(22, 46, 81, 1),
              HeaderInk: RGBA(255, 255, 255, 1),
              HeaderInk2: RGBA(217, 232, 246, 1),
              Page: RGBA(240, 240, 240, 1),
              Surface: RGBA(255, 255, 255, 1),
              Sunk: RGBA(247, 249, 250, 1),
              Line: RGBA(223, 225, 226, 1),
              Ink: RGBA(27, 27, 27, 1),
              Ink2: RGBA(61, 69, 81, 1),
              Ink3: RGBA(86, 92, 101, 1),
              Focus: RGBA(36, 145, 255, 1),
              Danger: RGBA(181, 9, 9, 1),
              DangerSoft: RGBA(244, 227, 219, 1),
              NeutralInk: RGBA(61, 69, 81, 1),
              NeutralSoft: RGBA(230, 230, 230, 1),
              InfoInk: RGBA(26, 68, 128, 1),
              InfoSoft: RGBA(217, 232, 246, 1),
              WarningInk: RGBA(92, 72, 9, 1),
              WarningSoft: RGBA(250, 243, 209, 1),
              SuccessInk: RGBA(25, 49, 30, 1),
              SuccessSoft: RGBA(236, 243, 236, 1),
              DangerInk: RGBA(111, 51, 49, 1),
              Hover: RGBA(0, 94, 162, 0.08),
              Pressed: RGBA(0, 94, 162, 0.16),
              Scrim: RGBA(27, 27, 27, 0.5),
              Transparent: RGBA(0, 0, 0, 0)
          }
      Title:
        PropertyKind: Input
        DisplayName: Title
        Description: The app name.
        DataType: Text
        Default: ="App name"
      UserImage:
        PropertyKind: Input
        DisplayName: UserImage
        Description: Signed in user's photo. Pass =User().Image. Initials show when it is blank.
        DataType: Image
        Default: =Blank()
      WelcomeName:
        PropertyKind: Input
        DisplayName: WelcomeName
        Description: Signed in user's full name. Shown as initials when there is no photo.
        DataType: Text
        Default: =""
    Properties:
      Fill: =cmpHeader.Theme.HeaderFill
      Height: =56
      SelectedKey: =_hdrSelectedKey
      Width: =1366
    Children:
      - conHdrBar:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =cmpHeader.Theme.HeaderFill
            Height: =Parent.Height
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            LayoutGap: =12
            PaddingLeft: =If(cmpHeader.Layout = "Phone", 16, 24)
            PaddingRight: =If(cmpHeader.Layout = "Phone", 16, 24)
            Width: =Parent.Width
          Children:
            - imgHdrLogo:
                Control: Image@2.2.3
                Properties:
                  Height: =32
                  Image: =cmpHeader.Logo
                  Visible: =!IsBlank(cmpHeader.Logo)
                  Width: =32
            - lblHdrTitle:
                Control: ModernText@1.0.0
                Properties:
                  AutoHeight: =true
                  Color: =cmpHeader.Theme.HeaderInk
                  FillPortions: =If(cmpHeader.Layout = "Phone", 1, 0)
                  FontWeight: =FontWeight.Semibold
                  LayoutMinWidth: =0
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =If(cmpHeader.Layout = "Phone", 14, 16)
                  Text: =cmpHeader.Title
                  Width: =If(cmpHeader.Layout = "Phone", 0, 200)
                  Wrap: =false
            - conHdrTabs:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =cmpHeader.Theme.Transparent
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =4
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Visible: =!(cmpHeader.Layout = "Phone")
                Children:
                  - conHdrTab1:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =cmpHeader.Theme.Transparent
                        FillPortions: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =CountRows(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff)) >= 1
                        Width: =Len(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count & ")", "")) * 8 + 32
                      Children:
                        - btnHdrTab1:
                            Control: ModernButton@1.0.0
                            Properties:
                              AccessibleLabel: =Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count & ")", "") & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key = cmpHeader.ActiveKey, ", current page", "")
                              AlignInContainer: =AlignInContainer.Stretch
                              Appearance: =ButtonAppearance.Transparent
                              Color: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key = cmpHeader.ActiveKey, cmpHeader.Theme.HeaderInk, cmpHeader.Theme.HeaderInk2)
                              FillPortions: =1
                              FontWeight: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key = cmpHeader.ActiveKey, FontWeight.Semibold, FontWeight.Normal)
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              OnSelect: |-
                                =Set(_hdrSelectedKey, Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key);
                                cmpHeader.OnNavSelect()
                              Size: =14
                              Text: =Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Count & ")", "")
                        - conHdrMark1:
                            Control: GroupContainer@1.5.0
                            Variant: ManualLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 1)).Key = cmpHeader.ActiveKey, cmpHeader.Theme.HeaderInk, cmpHeader.Theme.Transparent)
                              FillPortions: =0
                              Height: =3
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                  - conHdrTab2:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =cmpHeader.Theme.Transparent
                        FillPortions: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =CountRows(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff)) >= 2
                        Width: =Len(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Label & If(Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Count > 0, " (" & Last(FirstN(Filter(cmpHeader.Items, !StaffOnly || cmpHeader.IsStaff), 2)).Count & ")", "")) * 8 + 32
                      Children:
                        - btnHdrTab2:
