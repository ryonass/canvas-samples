                        - conStpStep1:
                            Control: GroupContainer@1.5.0
                            Variant: ManualLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              FillPortions: =0
                              Height: =36
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Visible: =CountRows(nfFormSteps) >= 1
                              Width: =52 + Len(Last(FirstN(nfFormSteps, 1)).Label) * 9
