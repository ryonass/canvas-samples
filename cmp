Screens:
  scrForm:
    Properties:
      Fill: =nfColor.Page
      OnVisible: |-
        =UpdateContext({ locLoading: true });
        UpdateContext({ locConfirm: Blank() });
        ResetForm(frmFrmItem);
        UpdateContext({ locLoading: false })
    Children:
      - conFrmRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmpFrmHeader:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: ="form"
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  IsStaff: =gblIsStaff
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Links: =nfHeaderLinks
                  Logo: =nfLogo
                  LogoWidth: =nfApp.LogoWidth
                  OnLinkSelect: =Launch(Self.SelectedUrl)
                  OnNavSelect: =nfGo(Self.SelectedKey)
                  Theme: =nfColor
                  Title: =nfApp.Name
                  UserImage: =User().Image
                  WelcomeName: =nfUserName
            - conFrmHeaderRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - conFrmBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  LayoutOverflowY: =LayoutOverflow.Scroll
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfFormMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfFormMaxW) / 2)
                  PaddingTop: =nfSpace.Xl
                Children:
                  - conFrmHead:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =54
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conFrmTitleText:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              Height: =54
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - lblFrmTitle:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.H1
                                    Text: =If(locId > 0, "Edit " & nfItem, nfNavLabel("form"))
                                    Wrap: =false
                              - lblFrmSub:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Body
                                    Text: =If(locId > 0, nfItemCap & " " & locId, "Your " & nfItem & " goes to the " & nfApp.Team & ".")
                                    Wrap: =false
                  - conFrmHelp:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.PrimarySoft
                        FillPortions: =0
                        Height: =96
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =nfSpace.Xs
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        PaddingBottom: =nfSpace.Md
                        PaddingLeft: =nfSpace.Lg
                        PaddingRight: =nfSpace.Lg
                        PaddingTop: =nfSpace.Md
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - lblFrmHelpText:
                            Control: ModernText@1.0.0
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              AutoHeight: =true
                              Color: =nfColor.InfoInk
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =nfType.Body
                              Text: =nfApp.FormInstructions
                        - conFrmContact:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              FillPortions: =0
                              Height: =nfSize.Control
                              LayoutAlignItems: =LayoutAlignItems.Center
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Sm
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - lblFrmContact:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AutoHeight: =true
                                    Color: =nfColor.InfoInk
                                    FillPortions: =1
                                    LayoutMinWidth: =0
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="Questions? Email " & nfApp.ContactEmail
                                    Wrap: =false
                              - btnFrmEmail:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    AccessibleLabel: ="Email us"
                                    Appearance: =ButtonAppearance.Subtle
                                    Height: =nfSize.Control
                                    OnSelect: =Launch("mailto:" & nfApp.ContactEmail)
                                    Size: =nfType.Body
                                    Text: ="Email us"
                  - conFrmCard:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        FillPortions: =0
                        Height: =RoundUp(6 / If(nfIsPhone, 1, 2), 0) * 88 + 2 * nfSpace.Lg
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        PaddingBottom: =nfSpace.Lg
                        PaddingLeft: =nfSpace.Lg
                        PaddingRight: =nfSpace.Lg
                        PaddingTop: =nfSpace.Lg
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - frmFrmItem:
                            Control: Form@2.4.4
                            Variant: Modern
                            Layout: Vertical
                            Properties:
                              DataSource: =colRequests
                              DefaultMode: =If(locId > 0, FormMode.Edit, FormMode.New)
                              Item: =LookUp(colRequests, ID = locId)
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              NumberOfColumns: =If(nfIsPhone, 1, 2)
                              OnFailure: =Notify("The " & nfItem & " could not be saved. " & Self.Error, NotificationType.Error)
                              OnSuccess: |-
                                =With(
                                    {
                                        // The form has just written to colRequests. A new row has no ID yet: a collection does not number
                                        // its rows the way a list does. Find the row, and work out the next number for a new one.
                                        row: If(locId > 0, LookUp(colRequests, ID = locId), LookUp(colRequests, IsBlank(ID))),
                                        id: If(locId > 0, locId, Max(colRequests, ID) + 1)
                                    },
                                    // What a SharePoint list sets by itself: the ID, the dates, and IsOpen's default.
                                    Patch(colRequests, row, { ID: id, IsOpen: LookUp(nfStatus, Key = row.Status).Open, Created: If(locId > 0, row.Created, Now()), Modified: Now() });
                                    Collect(colHistory, { RequestId: id, Action: If(locId > 0, "Edited", nfStatusLabel(nfStartStatus)), ActorEmail: nfUserEmail, ActorName: nfUserName, Created: Now() });
                                    Notify(nfItemCap & If(locId > 0, " saved.", " submitted."), NotificationType.Success);
                                    Navigate(scrDetail, ScreenTransition.None, { locId: id, locFrom: "list" })
                                )
                            Children:
                              - crdFrmTitle:
                                  Control: TypedDataCard@1.0.7
                                  Variant: ModernTextualEdit
                                  IsLocked: true
                                  Properties:
                                    BorderColor: =nfColor.Transparent
                                    DataField: ="Title"
                                    Default: =ThisItem.Title
                                    DisplayName: ="Title"
                                    MaxLength: =255
                                    Required: =true
                                    Update: =txtFrmTitleValue.Text
                                    Width: =400
                                    WidthFit: =true
                                    X: =0
                                    Y: =0
                                  Children:
                                    - lblFrmTitleKey:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldName
                                        Properties:
                                          AutoHeight: =true
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Parent.DisplayName
                                          Width: =Parent.Width - 48
                                          Wrap: =false
                                          X: =24
                                          Y: =10
                                    - txtFrmTitleValue:
                                        Control: ModernTextInput@1.1.2
                                        MetadataKey: FieldValue
                                        Properties:
                                          AccessibleLabel: =Parent.DisplayName
                                          Default: =Parent.Default
                                          DisplayMode: =Parent.DisplayMode
                                          MaxLength: =Parent.MaxLength
                                          Required: =Parent.Required
                                          Size: =nfType.Input
                                          ValidationState: =If(IsBlank(Parent.Error), ValidationState.None, ValidationState.Error)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =lblFrmTitleKey.Y + lblFrmTitleKey.Height + 4
                                    - lblFrmTitleError:
                                        Control: ModernText@1.0.0
                                        MetadataKey: ErrorMessage
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          Size: =nfType.Small
                                          Text: =Parent.Error
                                          Visible: =And(!IsBlank(Parent.Error), Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =txtFrmTitleValue.Y + txtFrmTitleValue.Height
                                    - lblFrmTitleStar:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldRequired
                                        Properties:
                                          Align: =Align.Center
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Text: ="*"
                                          Visible: =And(Parent.Required, Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =30
                                          Y: =lblFrmTitleKey.Y
                              - crdFrmSvc:
                                  Control: TypedDataCard@1.0.7
                                  Variant: ModernTextualEdit
                                  IsLocked: true
                                  Properties:
                                    BorderColor: =nfColor.Transparent
                                    DataField: ="ServiceKey"
                                    Default: =ThisItem.ServiceKey
                                    DisplayName: ="Service"
                                    MaxLength: =255
                                    Required: =true
                                    Update: =drpFrmSvcValue.Selected.Key
                                    Width: =400
                                    WidthFit: =true
                                    X: =1
                                    Y: =0
                                  Children:
                                    - lblFrmSvcKey:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldName
                                        Properties:
                                          AutoHeight: =true
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Parent.DisplayName
                                          Width: =Parent.Width - 48
                                          Wrap: =false
                                          X: =24
                                          Y: =10
                                    - drpFrmSvcValue:
                                        Control: ModernDropdown@1.0.3
                                        MetadataKey: FieldValue
                                        Properties:
                                          AccessibleLabel: =Parent.DisplayName
                                          Default: =LookUp(colServices, Key = Parent.Default)
                                          DisplayMode: =Parent.DisplayMode
                                          ItemDisplayText: =ThisItem.Title
                                          Items: =colServices
                                          Size: =nfType.Input
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =lblFrmSvcKey.Y + lblFrmSvcKey.Height + 4
                                    - lblFrmSvcError:
                                        Control: ModernText@1.0.0
                                        MetadataKey: ErrorMessage
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          Size: =nfType.Small
                                          Text: =Parent.Error
                                          Visible: =And(!IsBlank(Parent.Error), Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =drpFrmSvcValue.Y + drpFrmSvcValue.Height
                                    - lblFrmSvcStar:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldRequired
                                        Properties:
                                          Align: =Align.Center
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Text: ="*"
                                          Visible: =And(Parent.Required, Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =30
                                          Y: =lblFrmSvcKey.Y
                              - crdFrmDivision:
                                  Control: TypedDataCard@1.0.7
                                  Variant: ModernComboBoxEdit
                                  IsLocked: true
                                  Properties:
                                    BorderColor: =nfColor.Transparent
                                    DataField: ="DivisionMEO"
                                    Default: =ThisItem.DivisionMEO
                                    DisplayName: ="Division or MEO"
                                    Required: =true
                                    Update: =cmbFrmDivisionValue.Selected
                                    Width: =400
                                    WidthFit: =true
                                    X: =0
                                    Y: =1
                                  Children:
                                    - lblFrmDivisionKey:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldName
                                        Properties:
                                          AutoHeight: =true
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Parent.DisplayName
                                          Width: =Parent.Width - 48
                                          Wrap: =false
                                          X: =24
                                          Y: =10
                                    - cmbFrmDivisionValue:
                                        Control: ModernCombobox@1.1.2
                                        MetadataKey: FieldValue
                                        Properties:
                                          AccessibleLabel: =Parent.DisplayName
                                          DefaultSelectedItems: =[Parent.Default]
                                          DisplayMode: =Parent.DisplayMode
                                          ItemDisplayText: =ThisItem.Value
                                          Items: =colDivisions
                                          SelectMultiple: =false
                                          Size: =nfType.Input
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =lblFrmDivisionKey.Y + lblFrmDivisionKey.Height + 4
                                    - lblFrmDivisionError:
                                        Control: ModernText@1.0.0
                                        MetadataKey: ErrorMessage
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          Size: =nfType.Small
                                          Text: =Parent.Error
                                          Visible: =And(!IsBlank(Parent.Error), Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =cmbFrmDivisionValue.Y + cmbFrmDivisionValue.Height
                                    - lblFrmDivisionStar:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldRequired
                                        Properties:
                                          Align: =Align.Center
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Text: ="*"
                                          Visible: =And(Parent.Required, Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =30
                                          Y: =lblFrmDivisionKey.Y
                              - crdFrmLocation:
                                  Control: TypedDataCard@1.0.7
                                  Variant: ModernComboBoxEdit
                                  IsLocked: true
                                  Properties:
                                    BorderColor: =nfColor.Transparent
                                    DataField: ="Location"
                                    Default: =ThisItem.Location
                                    DisplayName: ="Location"
                                    Required: =false
                                    Update: =cmbFrmLocationValue.Selected
                                    Width: =400
                                    WidthFit: =true
                                    X: =1
                                    Y: =1
                                  Children:
                                    - lblFrmLocationKey:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldName
                                        Properties:
                                          AutoHeight: =true
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Parent.DisplayName
                                          Width: =Parent.Width - 48
                                          Wrap: =false
                                          X: =24
                                          Y: =10
                                    - cmbFrmLocationValue:
                                        Control: ModernCombobox@1.1.2
                                        MetadataKey: FieldValue
                                        Properties:
                                          AccessibleLabel: =Parent.DisplayName
                                          DefaultSelectedItems: =[Parent.Default]
                                          DisplayMode: =Parent.DisplayMode
                                          ItemDisplayText: =ThisItem.Value
                                          Items: =colLocations
                                          SelectMultiple: =false
                                          Size: =nfType.Input
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =lblFrmLocationKey.Y + lblFrmLocationKey.Height + 4
                                    - lblFrmLocationError:
                                        Control: ModernText@1.0.0
                                        MetadataKey: ErrorMessage
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          Size: =nfType.Small
                                          Text: =Parent.Error
                                          Visible: =And(!IsBlank(Parent.Error), Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =cmbFrmLocationValue.Y + cmbFrmLocationValue.Height
                                    - lblFrmLocationStar:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldRequired
                                        Properties:
                                          Align: =Align.Center
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Text: ="*"
                                          Visible: =And(Parent.Required, Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =30
                                          Y: =lblFrmLocationKey.Y
                              - crdFrmAsset:
                                  Control: TypedDataCard@1.0.7
                                  Variant: ModernTextualEdit
                                  IsLocked: true
                                  Properties:
                                    BorderColor: =nfColor.Transparent
                                    DataField: ="AssetTag"
                                    Default: =ThisItem.AssetTag
                                    DisplayName: ="Asset tag"
                                    MaxLength: =50
                                    Required: =false
                                    Update: =txtFrmAssetValue.Text
                                    Width: =400
                                    WidthFit: =true
                                    X: =0
                                    Y: =2
                                  Children:
                                    - lblFrmAssetKey:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldName
                                        Properties:
                                          AutoHeight: =true
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Parent.DisplayName
                                          Width: =Parent.Width - 48
                                          Wrap: =false
                                          X: =24
                                          Y: =10
                                    - txtFrmAssetValue:
                                        Control: ModernTextInput@1.1.2
                                        MetadataKey: FieldValue
                                        Properties:
                                          AccessibleLabel: =Parent.DisplayName
                                          Default: =Parent.Default
                                          DisplayMode: =Parent.DisplayMode
                                          MaxLength: =Parent.MaxLength
                                          Required: =Parent.Required
                                          Size: =nfType.Input
                                          ValidationState: =If(IsBlank(Parent.Error), ValidationState.None, ValidationState.Error)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =lblFrmAssetKey.Y + lblFrmAssetKey.Height + 4
                                    - lblFrmAssetError:
                                        Control: ModernText@1.0.0
                                        MetadataKey: ErrorMessage
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          Size: =nfType.Small
                                          Text: =Parent.Error
                                          Visible: =And(!IsBlank(Parent.Error), Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =txtFrmAssetValue.Y + txtFrmAssetValue.Height
                                    - lblFrmAssetStar:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldRequired
                                        Properties:
                                          Align: =Align.Center
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Text: ="*"
                                          Visible: =And(Parent.Required, Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =30
                                          Y: =lblFrmAssetKey.Y
                              - crdFrmRef:
                                  Control: TypedDataCard@1.0.7
                                  Variant: ModernTextualEdit
                                  IsLocked: true
                                  Properties:
                                    BorderColor: =nfColor.Transparent
                                    DataField: ="ExternalRef"
                                    Default: =ThisItem.ExternalRef
                                    DisplayName: ="External reference"
                                    MaxLength: =100
                                    Required: =false
                                    Update: =txtFrmRefValue.Text
                                    Width: =400
                                    WidthFit: =true
                                    X: =1
                                    Y: =2
                                  Children:
                                    - lblFrmRefKey:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldName
                                        Properties:
                                          AutoHeight: =true
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Parent.DisplayName
                                          Width: =Parent.Width - 48
                                          Wrap: =false
                                          X: =24
                                          Y: =10
                                    - txtFrmRefValue:
                                        Control: ModernTextInput@1.1.2
                                        MetadataKey: FieldValue
                                        Properties:
                                          AccessibleLabel: =Parent.DisplayName
                                          Default: =Parent.Default
                                          DisplayMode: =Parent.DisplayMode
                                          MaxLength: =Parent.MaxLength
                                          Required: =Parent.Required
                                          Size: =nfType.Input
                                          ValidationState: =If(IsBlank(Parent.Error), ValidationState.None, ValidationState.Error)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =lblFrmRefKey.Y + lblFrmRefKey.Height + 4
                                    - lblFrmRefError:
                                        Control: ModernText@1.0.0
                                        MetadataKey: ErrorMessage
                                        Properties:
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          Size: =nfType.Small
                                          Text: =Parent.Error
                                          Visible: =And(!IsBlank(Parent.Error), Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =txtFrmRefValue.Y + txtFrmRefValue.Height
                                    - lblFrmRefStar:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldRequired
                                        Properties:
                                          Align: =Align.Center
                                          AutoHeight: =true
                                          Color: =nfColor.Danger
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Text: ="*"
                                          Visible: =And(Parent.Required, Parent.DisplayMode = DisplayMode.Edit)
                                          Width: =30
                                          Y: =lblFrmRefKey.Y
                              - crdFrmReqEmail:
                                  Control: TypedDataCard@1.0.7
                                  Variant: ModernTextualEdit
                                  IsLocked: true
                                  Properties:
                                    BorderColor: =nfColor.Transparent
                                    DataField: ="RequesterEmail"
                                    Default: =If(frmFrmItem.Mode = FormMode.New, nfUserEmail, ThisItem.RequesterEmail)
                                    DisplayName: ="RequesterEmail"
                                    MaxLength: =255
                                    Required: =false
                                    Update: =txtFrmReqEmailValue.Text
                                    Visible: =false
                                    Width: =400
                                    WidthFit: =true
                                    X: =0
                                    Y: =3
                                  Children:
                                    - lblFrmReqEmailKey:
                                        Control: ModernText@1.0.0
                                        MetadataKey: FieldName
                                        Properties:
                                          AutoHeight: =true
                                          FontWeight: =FontWeight.Semibold
                                          PaddingBottom: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =Parent.DisplayName
                                          Width: =Parent.Width - 48
                                          Wrap: =false
                                          X: =24
                                          Y: =10
                                    - txtFrmReqEmailValue:
                                        Control: ModernTextInput@1.1.2
                                        MetadataKey: FieldValue
                                        Properties:
                                          AccessibleLabel: =Parent.DisplayName
                                          Default: =Parent.Default
                                          DisplayMode: =Parent.DisplayMode
                                          MaxLength: =Parent.MaxLength
                                          Required: =Parent.Required
                                          Size: =nfType.Input
                                          ValidationState: =If(IsBlank(Parent.Error), ValidationState.None, ValidationState.Error)
                                          Width: =Parent.Width - 48
                                          X: =24
                                          Y: =lblFrmReqEmailKey.Y + lblFrmReqEmailKey.Height + 4
                                    - lblFrmReqEmailError:
                                        Control: ModernText@1.0.0
                                        MetadataKey: ErrorMessage
