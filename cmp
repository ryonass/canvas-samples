        PropertyKind: Output
        DisplayName: Validation Error
        Description: A custom property
        DataType: Text
      Value:
        PropertyKind: Output
        DisplayName: Value
        Description: A custom property
        DataType: Number
    Properties:
      Height: =76
      IsValid: =IsBlank(cmp_Number.ValidationError)
      OnReset: =Reset(txt_NumberValue)
      ValidationError: |-
        =If(
            Self.Required && IsBlank(txt_NumberValue.Text), "Required",
            !IsNumeric(txt_NumberValue.Text) && !IsBlank(txt_NumberValue.Text), "Invalid number",
            Value(txt_NumberValue.Text) < cmp_Number.MinValue, $"Must be greater than {cmp_Number.MinValue}.",
            Value(txt_NumberValue.Text) > cmp_Number.MaxValue, $"Must be less than {cmp_Number.MaxValue}.",
            cmp_Number.CustomValidationError
        )
      Value: =txt_NumberValue.Text/*IfError(Value(txt_NumberValue.Text),Blank())*/
      Width: =150
    Children:
      - lbl_NumberError:
          Control: ModernText@1.0.0
          Properties:
            Color: =cmp_Number.Theme.Danger
            Height: =22
            PaddingBottom: =0
            PaddingLeft: =3
            PaddingRight: =0
            PaddingTop: =0
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Size: =12
            Text: =cmp_Number.ValidationError
            Width: =Parent.Width
            Y: =txt_NumberValue.Y+txt_NumberValue.Height
      - txt_NumberValue:
          Control: ModernTextInput@1.1.2
          Properties:
            Align: =Align.Right
            Appearance: =Appearance.Outline
            Color: |-
              =If(
                  cmp_Number.Required && IsBlank(Self.Text),
                  cmp_Number.Theme.Danger,
                  cmp_Number.Theme.Ink
              )
            Default: |-
              =cmp_Number.DefaultValue/*If(
                  IsBlank(cmp_Number.DefaultValue),
                  "0",
                  cmp_Number.DefaultValue
              )*/
            DisplayMode: =cmp_Number.DisplayMode
            MaxLength: =-1
            Placeholder: =""
            ValidationState: =If(cmp_Number.IsValid, ValidationState.None, ValidationState.Error)
            Width: =Parent.Width
            Y: =lbl_NumberLabel.Y+lbl_NumberLabel.Height
      - lbl_NumberLabel:
          Control: ModernText@1.0.0
          Properties:
            Color: =cmp_Number.Theme.Ink
            FontWeight: =FontWeight.Semibold
            Height: =22
            PaddingBottom: =0
            PaddingLeft: =3
            PaddingRight: =0
            PaddingTop: =0
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Size: =14
            Text: =cmp_Number.Label
            Width: =Parent.Width


