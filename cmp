Screens:
  scrFormSteps:
    Properties:
      Fill: =nfColor.Page
      OnVisible: |-
        =UpdateContext({ locLoading: true });
        UpdateContext({ locConfirm: Blank(), locStep: 1 });
        ResetForm(frmStpItem);
        UpdateContext({ locLoading: false })
    Children:
      - conStpRoot:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmpStpHeader:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: ="form"
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  IsStaff: =gblIsStaff
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Links: =nfHeaderLinks
                  Logo: =nfLogo
                  LogoWidth: =nfApp.LogoWidth
                  OnLinkSelect: =Launch(Self.SelectedUrl)
                  OnNavSelect: =nfGo(Self.SelectedKey)
                  Theme: =nfColor
                  Title: =nfApp.Name
                  UserImage: =User().Image
                  WelcomeName: =nfUserName
            - conStpHeaderRule:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - conStpBody:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  LayoutOverflowY: =LayoutOverflow.Scroll
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfFormMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfFormMaxW) / 2)
                  PaddingTop: =nfSpace.Xl
                Children:
                  - conStpHead:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =54
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Md
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
                      Children:
                        - conStpTitleText:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Transparent
                              Height: =54
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutGap: =nfSpace.Xs
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                            Children:
                              - lblStpTitle:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink
                                    FontWeight: =FontWeight.Semibold
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.H1
                                    Text: =If(locId > 0, "Edit " & nfItem, nfNavLabel("form"))
                                    Wrap: =false
                              - lblStpSub:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    AlignInContainer: =AlignInContainer.Stretch
                                    AutoHeight: =true
                                    Color: =nfColor.Ink2
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Body
                                    Text: =If(locId > 0, nfItemCap & " " & locId, "Your " & nfItem & " goes to the " & nfApp.Team & ".")
                                    Wrap: =false
                  - conStpSteps:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        FillPortions: =0
                        Height: =36
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =nfSpace.Sm
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        Visible: =!nfIsPhone
                        Width: =Min(Parent.Width - 2 * nfGutter, nfPageMaxW)
