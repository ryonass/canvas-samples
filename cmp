                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Small
                                          Text: =If(locStep > 1, "✓", "1")
                                          Width: =Parent.Width
                                          Wrap: =false
