Screens:
  scr_PRList:
    Properties:
      Fill: =nfColor.Page
    Children:
      - con_Shell_PRList:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =nfColor.Page
            Height: =Parent.Height
            LayoutDirection: =LayoutDirection.Vertical
            Width: =Parent.Width
          Children:
            - cmp_Header_PRList:
                Control: CanvasComponent
                ComponentName: cmpHeader
                Properties:
                  ActiveKey: =""
                  AlignInContainer: =AlignInContainer.Stretch
                  Height: =nfSize.Header
                  IsStaff: =false
                  Items: =nfNavMain
                  Layout: =nfLayout
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Links: =nfHeaderLinks
                  Logo: =nfLogo
                  LogoWidth: =nfApp.LogoWidth
                  OnLinkSelect: =If(Self.SelectedUrl = "app:help", Navigate(scr_Help, ScreenTransition.Fade), Launch(Self.SelectedUrl))
                  OnNavSelect: =false
                  Theme: =nfColor
                  Title: =nfApp.Name
                  UserImage: =User().Image
                  WelcomeName: =nf_User.DisplayName
            - con_Main_PRList:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Transparent
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutGap: =nfSpace.Lg
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingBottom: =nfSpace.Xl
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfPageMaxW) / 2)
                  PaddingTop: =nfSpace.Xl
                Children:
                  - lbl_Title_PRList:
                      Control: ModernText@1.0.0
                      Properties:
                        AlignInContainer: =AlignInContainer.Stretch
                        Color: =nfColor.Ink
                        FontWeight: =FontWeight.Semibold
                        Height: =30
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.H1
                        Text: ="Requirements"
                  - lbl_Sub_PRList:
                      Control: ModernText@1.0.0
                      Properties:
                        AlignInContainer: =AlignInContainer.Stretch
                        Color: =nfColor.Ink2
                        Height: =20
                        PaddingBottom: =0
                        PaddingLeft: =0
                        PaddingRight: =0
                        PaddingTop: =0
                        Size: =nfType.Body
                        Text: ="Open a requirement to see its IGCE, or to start one."
                  - txt_Search_PRList:
                      Control: ModernTextInput@1.1.2
                      Properties:
                        AccessibleLabel: ="Search requirements"
                        AlignInContainer: =AlignInContainer.Stretch
                        Appearance: =Appearance.Outline
                        Height: =nfSize.Control
                        Placeholder: ="Search by PR tracker number or requirement, from the start"
                  - con_Table_PRList:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderColor: =nfColor.Line
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Surface
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                        RadiusBottomLeft: =nfRadius.Md
                        RadiusBottomRight: =nfRadius.Md
                        RadiusTopLeft: =nfRadius.Md
                        RadiusTopRight: =nfRadius.Md
                      Children:
                        - con_TableHead_PRList:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              Fill: =nfColor.Sunk
                              FillPortions: =0
                              Height: =40
                              LayoutAlignItems: =LayoutAlignItems.Center
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =nfSpace.Md
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              PaddingLeft: =nfSpace.Lg
                              PaddingRight: =nfSpace.Lg
                              RadiusTopLeft: =nfRadius.Md
                              RadiusTopRight: =nfRadius.Md
                            Children:
                              - lbl_HdrPRtrackernumber_PRList:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    Height: =Parent.Height
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="PR TRACKER NUMBER"
                                    Width: =200
                                    Wrap: =false
                              - lbl_HdrRequirement_PRList:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Color: =nfColor.Ink2
                                    FillPortions: =1
                                    FontWeight: =FontWeight.Semibold
                                    Height: =Parent.Height
                                    LayoutMinWidth: =0
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="REQUIREMENT"
                                    Wrap: =false
                              - lbl_HdrCOR_PRList:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    Height: =Parent.Height
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="COR"
                                    Visible: =!nfIsPhone
                                    Width: =200
                                    Wrap: =false
                              - lbl_HdrIGCE_PRList:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Color: =nfColor.Ink2
                                    FontWeight: =FontWeight.Semibold
                                    Height: =Parent.Height
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                    PaddingRight: =0
                                    PaddingTop: =0
                                    Size: =nfType.Small
                                    Text: ="IGCE"
                                    Width: =130
                                    Wrap: =false
                        - gal_Rows_PRList:
                            Control: Gallery@2.15.0
                            Variant: BrowseLayout_Vertical_ThreeTextVariant_ver5.0
                            Properties:
                              AccessibleLabel: ="Requirements"
                              Items: |-
                                =SortByColumns(
                                    Filter(
                                        [@RequirementTracker],
                                        IsBlank(txt_Search_PRList.Text) || StartsWith(PRTrackerNumber, txt_Search_PRList.Text) || StartsWith(RequirementName, txt_Search_PRList.Text)
                                    ),
                                    "PRTrackerNumber"
                                )
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              OnSelect: "=Set(gl_LoadedData, false);\r\n\r\n// Retrieve PR ID, Tracker, & COR\r\nSet(gl_PRID, ThisItem.ID/*Value(Param(\"PRID\"))*/);\r\nSet(gl_PRTracker, LookUp([@RequirementTracker], ID = Value(gl_PRID)).PRTrackerNumber);\r\nSet(gl_PRTrackerCOR, LookUp([@RequirementTracker], ID = Value(gl_PRID)).COR);\r\n\r\nIf(\r\n    !IsBlank(gl_PRID), \r\n    // Then\r\n        // Retrieve IGCE\r\n        Set(gl_IGCE, LookUp([@IGCEHeader], PRTrackerID.Value = Text(gl_PRID)));\r\n        \r\n        Set(gl_GFPStatus, gl_IGCE.gfpStatus); // GFP Updates\r\n        Set(gl_GFPSignatureImage, gl_IGCE.gfpCORSignature.Full); // GFP Updates\r\n        Set(gl_GFPSignatureDate, gl_IGCE.gfpCORSignatureDate); // GFP Updates\r\n        /*Set(gl_IsMember, Lower(gl_User.Email) in Office365Groups.ListGroupMembers(getIGCEAdminGroupID.Run().out_flowgroupid).value.userPrincipalName); //GFP Updates - Instant Flow, Env Variable Group Display Name: \"OCOSO Asset Receiving Ticket Solution\"*/\r\n        Set(gl_GFPWorkflowState, gl_IGCE.gfpWorkflowState); //GFP Updates\r\n        Set(gl_FormMode,FormMode.View); // FormMode\r\n\r\n        If(IsBlank(gl_IGCE),\r\n            // There's no IGCE, create blank one\r\n            /*Set(gl_IGCE,Defaults([@IGCEHeader]));*/\r\n            Set(gl_IGCE,Blank());\r\n            Set(gl_GFPSignatureImage, Blank()); // GFP Updates - Clear Signature\r\n            Set(gl_GFPStatus,\"\");  // GFP Updates - Reset GFP Status\r\n            Set(gl_GFPSignatureDate, Blank()); // GFP Updates - Reset Signature Date\r\n            Set(gl_FormMode,FormMode.New)\r\n        )\r\n\r\n        // If the IGCE is completed switch to View.\r\n        // If(gl_FormMode <> FormMode.View && gl_IGCE.Status.Value = \"Complete\", Set(gl_DisplayMode,DisplayMode.View));\r\n);\r\n\r\n// ClearCollect(col[@IGCEHeader]s, [@IGCEHeader]);\r\nClearCollect(\r\n    col_IGCELineTemplate,\r\n    [\r\n        {\r\n            LineNumber: 1001,\r\n            Category: {Value: \"Other Direct Costs\"},\r\n            Title: \"Other Direct Costs\",\r\n            Labor: false\r\n        },\r\n        {\r\n            LineNumber: 1002,\r\n            Category: {Value: \"Travel\"},\r\n            Title: \"Travel\",\r\n            Labor: false\r\n        }\r\n    ]\r\n);\r\n\r\nNavigate(scr_IGCEOverview,ScreenTransition.Fade);\r\n\r\nSet(gl_LoadedData, true)"
                              TemplateSize: =52
                              Visible: |-
                                =!(IsEmpty(Filter(
                                        [@RequirementTracker],
                                        IsBlank(txt_Search_PRList.Text) || StartsWith(PRTrackerNumber, txt_Search_PRList.Text) || StartsWith(RequirementName, txt_Search_PRList.Text)
                                    )))
                            Children:
                              - con_Row_PRList:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Transparent
                                    Height: =Parent.TemplateHeight - 1
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutGap: =nfSpace.Md
                                    PaddingLeft: =nfSpace.Lg
                                    PaddingRight: =nfSpace.Lg
                                    Width: =Parent.TemplateWidth
                                  Children:
                                    - lbl_PRtrackernumber_PRList:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Color: =nfColor.Ink
                                          FontWeight: =FontWeight.Semibold
                                          Height: =20
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =ThisItem.PRTrackerNumber
                                          Width: =200
                                          Wrap: =false
                                    - lbl_Requirement_PRList:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Color: =nfColor.Ink
                                          FillPortions: =1
                                          Height: =20
                                          LayoutMinWidth: =0
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =ThisItem.RequirementName
                                          Wrap: =false
                                    - lbl_COR_PRList:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Color: =nfColor.Ink2
                                          Height: =20
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: =ThisItem.COR.DisplayName
                                          Visible: =!nfIsPhone
                                          Width: =200
                                          Wrap: =false
                                    - lbl_IGCE_PRList:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          Color: =nfColor.Ink2
                                          Height: =20
                                          PaddingBottom: =0
                                          PaddingLeft: =0
                                          PaddingRight: =0
                                          PaddingTop: =0
                                          Size: =nfType.Body
                                          Text: |-
                                            =With({ i: LookUp([@IGCEHeader], PRTrackerID.Value = Text(ThisItem.ID)) }, If(IsBlank(i), "Not started", i.Status.Value))
                                          Width: =130
                                          Wrap: =false
                              - con_RowRule_PRList:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    DropShadow: =DropShadow.None
                                    Fill: =nfColor.Line
                                    Height: =1
                                    Width: =Parent.TemplateWidth
                                    Y: =Parent.TemplateHeight - 1
                              - btn_RowOpen_PRList:
                                  Control: Classic/Button@2.2.0
                                  Properties:
                                    BorderStyle: =BorderStyle.None
                                    BorderThickness: =0
                                    Fill: =nfColor.Transparent
                                    FocusedBorderThickness: =2
                                    Height: =Parent.TemplateHeight - 1
                                    HoverBorderColor: =nfColor.Transparent
                                    HoverFill: =nfColor.Hover
                                    OnSelect: =Select(Parent)
                                    PressedBorderColor: =nfColor.Transparent
                                    PressedFill: =nfColor.Pressed
                                    RadiusBottomLeft: =0
                                    RadiusBottomRight: =0
                                    RadiusTopLeft: =0
                                    RadiusTopRight: =0
                                    Text: =""
                                    Tooltip: ="Open " & ThisItem.PRTrackerNumber & ", " & ThisItem.RequirementName
                                    Width: =Parent.TemplateWidth
                        - cmp_Empty_PRList:
                            Control: CanvasComponent
                            ComponentName: cmpStatePanel
                            Properties:
                              AlignInContainer: =AlignInContainer.Stretch
                              FillPortions: =1
                              Height: =180
                              IsPhone: =nfIsPhone
                              LayoutMinHeight: =0
                              LayoutMinWidth: =0
                              Message: ="Check the PR tracker number, or clear the search to see them all."
                              OnPrimary: =Reset(txt_Search_PRList)
                              OnSecondary: =false
                              PrimaryText: =If(IsBlank(txt_Search_PRList.Text), "", "Clear search")
                              SecondaryText: =""
                              Theme: =nfColor
                              Title: ="No requirements match"
                              Variant: ="Empty"
                              Visible: |-
                                =IsEmpty(Filter(
                                        [@RequirementTracker],
                                        IsBlank(txt_Search_PRList.Text) || StartsWith(PRTrackerNumber, txt_Search_PRList.Text) || StartsWith(RequirementName, txt_Search_PRList.Text)
                                    ))
