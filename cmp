            ConfirmLabel: =locConfirm.Label
            Height: =Parent.Height
            IsDanger: =locConfirm.Danger
            IsPhone: =nfIsPhone
            Message: =locConfirm.Message
            OnCancel: |-
              =UpdateContext({ locConfirm: Blank() })
            OnConfirm: |-
              =UpdateContext({ locConfirm: Blank() });
              ResetForm(frmStpItem);
              If(locId > 0, Navigate(scrDetail, ScreenTransition.None, { locId: locId, locFrom: "list" }), Navigate(scrList, ScreenTransition.None, { locStatusFilter: "all" }))
            Theme: =nfColor
            Title: =locConfirm.Title
