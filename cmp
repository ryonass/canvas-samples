ComponentDefinitions:
  cmpStatePanel:
    DefinitionType: CanvasComponent
    CustomProperties:
      IsPhone:
        PropertyKind: Input
        DisplayName: IsPhone
        Description: Pass =nfIsPhone. Stacks the buttons at full width.
        DataType: Boolean
        Default: =false
      Message:
        PropertyKind: Input
        DisplayName: Message
        Description: One or two sentences. Blank uses the default for the variant.
        DataType: Text
        Default: =""
      OnPrimary:
        PropertyKind: Event
        DisplayName: OnPrimary
        Description: The main button was selected. The screen does the work.
        ReturnType: None
        Default: =false
      OnSecondary:
        PropertyKind: Event
        DisplayName: OnSecondary
        Description: The second button was selected. The screen does the work.
        ReturnType: None
        Default: =false
      PrimaryText:
        PropertyKind: Input
        DisplayName: PrimaryText
        Description: Main button text, for example Try again. Blank hides the button.
        DataType: Text
        Default: =""
      SecondaryText:
        PropertyKind: Input
        DisplayName: SecondaryText
        Description: Second button text. Blank hides the button.
        DataType: Text
        Default: =""
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
        DataType: Record
        Default: |-
          ={
              Primary: RGBA(0, 82, 136, 1),
              PrimaryDark: RGBA(0, 62, 103, 1),
              PrimarySoft: RGBA(214, 227, 236, 1),
              OnPrimary: RGBA(255, 255, 255, 1),
              HeaderFill: RGBA(0, 43, 71, 1),
              HeaderInk: RGBA(255, 255, 255, 1),
              HeaderInk2: RGBA(214, 227, 236, 1),
              Page: RGBA(237, 238, 238, 1),
              Surface: RGBA(255, 255, 255, 1),
              Sunk: RGBA(248, 248, 249, 1),
              Line: RGBA(222, 223, 224, 1),
              Ink: RGBA(25, 25, 26, 1),
              Ink2: RGBA(68, 69, 71, 1),
              Ink3: RGBA(90, 91, 93, 1),
              Focus: RGBA(0, 120, 174, 1),
              Danger: RGBA(196, 18, 48, 1),
              DangerSoft: RGBA(246, 217, 222, 1),
              NeutralInk: RGBA(68, 69, 71, 1),
              NeutralSoft: RGBA(229, 229, 229, 1),
              InfoInk: RGBA(0, 62, 103, 1),
              InfoSoft: RGBA(214, 233, 242, 1),
              WarningInk: RGBA(92, 72, 9, 1),
              WarningSoft: RGBA(250, 243, 209, 1),
              SuccessInk: RGBA(49, 79, 26, 1),
              SuccessSoft: RGBA(229, 238, 222, 1),
              DangerInk: RGBA(102, 9, 25, 1),
              Hover: RGBA(0, 82, 136, 0.08),
              Pressed: RGBA(0, 82, 136, 0.16),
              Scrim: RGBA(25, 25, 26, 0.5),
              Transparent: RGBA(0, 0, 0, 0)
          }
      Title:
        PropertyKind: Input
        DisplayName: Title
        Description: Heading. Blank uses the default for the variant.
        DataType: Text
        Default: =""
      Variant:
        PropertyKind: Input
        DisplayName: Variant
        Description: NoAccess, Empty, Error or NotFound. Picks the default title and message.
        DataType: Text
        Default: ="Empty"
    Properties:
      Fill: =cmpStatePanel.Theme.Surface
      Height: =200
    Children:
      - conSpPanel:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            DropShadow: =DropShadow.None
            Fill: =cmpStatePanel.Theme.Surface
            Height: =Parent.Height
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Vertical
            LayoutGap: =8
            LayoutJustifyContent: =LayoutJustifyContent.Center
            PaddingBottom: =24
            PaddingLeft: =24
            PaddingRight: =24
            PaddingTop: =24
            Width: =Parent.Width
          Children:
            - lblSpTitle:
                Control: ModernText@1.0.0
                Properties:
                  Align: =Align.Center
                  AlignInContainer: =AlignInContainer.Stretch
                  AutoHeight: =true
                  Color: =cmpStatePanel.Theme.Ink
                  FontWeight: =FontWeight.Semibold
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =18
                  Text: =Coalesce(cmpStatePanel.Title, Switch(cmpStatePanel.Variant, "NoAccess", "You do not have access", "Error", "Something went wrong", "NotFound", "Not found", "Nothing here yet"))
            - lblSpMessage:
                Control: ModernText@1.0.0
                Properties:
                  Align: =Align.Center
                  AlignInContainer: =AlignInContainer.Stretch
                  AutoHeight: =true
                  Color: =cmpStatePanel.Theme.Ink2
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =14
                  Text: =Coalesce(cmpStatePanel.Message, Switch(cmpStatePanel.Variant, "NoAccess", "If you need access, contact the app owner.", "Error", "Try again. If it keeps happening, contact the app owner.", "NotFound", "It may have been removed, or the link is out of date.", "When there is something to show, it appears here."))
            - conSpButtons:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =cmpStatePanel.Theme.Transparent
                  FillPortions: =0
                  Height: =If(cmpStatePanel.IsPhone && !IsBlank(cmpStatePanel.PrimaryText) && !IsBlank(cmpStatePanel.SecondaryText), 88, 40)
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =If(cmpStatePanel.IsPhone, LayoutDirection.Vertical, LayoutDirection.Horizontal)
                  LayoutGap: =8
                  LayoutJustifyContent: =LayoutJustifyContent.Center
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Visible: =!IsBlank(cmpStatePanel.PrimaryText) || !IsBlank(cmpStatePanel.SecondaryText)
                Children:
                  - btnSpPrimary:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =cmpStatePanel.PrimaryText
                        Height: =40
                        OnSelect: =cmpStatePanel.OnPrimary()
                        Size: =14
                        Text: =cmpStatePanel.PrimaryText
                        Visible: =!IsBlank(cmpStatePanel.PrimaryText)
                        Width: =If(cmpStatePanel.IsPhone, Parent.Width, Len(cmpStatePanel.PrimaryText) * 8 + 40)
                  - btnSpSecondary:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =cmpStatePanel.SecondaryText
                        Appearance: =ButtonAppearance.Secondary
                        Height: =40
                        OnSelect: =cmpStatePanel.OnSecondary()
                        Size: =14
                        Text: =cmpStatePanel.SecondaryText
                        Visible: =!IsBlank(cmpStatePanel.SecondaryText)
                        Width: =If(cmpStatePanel.IsPhone, Parent.Width, Len(cmpStatePanel.SecondaryText) * 8 + 40)

