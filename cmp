                  Fill: =nfColor.Line
                  FillPortions: =0
                  Height: =1
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
            - conStpFoot:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =nfColor.Surface
                  FillPortions: =0
                  Height: =nfSize.Control + 2 * nfSpace.Md
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =nfSpace.Sm
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  PaddingLeft: =Max(nfGutter, (Parent.Width - nfFormMaxW) / 2)
                  PaddingRight: =Max(nfGutter, (Parent.Width - nfFormMaxW) / 2)
                Children:
                  - btnStpCancel:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Cancel"
                        Appearance: =ButtonAppearance.Secondary
                        Height: =nfSize.Control
                        OnSelect: |-
                          =If(
                              frmStpItem.Unsaved,
                              UpdateContext({ locConfirm: { Action: "discard", Title: "Discard your changes?", Message: "What you entered on this form will be lost.", Label: "Discard", Danger: true } }),
                              If(locId > 0, Navigate(scrDetail, ScreenTransition.None, { locId: locId, locFrom: "list" }), Navigate(scrList, ScreenTransition.None, { locStatusFilter: "all" }))
                          )
                        Size: =nfType.Body
                        Text: ="Cancel"
                        Width: =90
                  - conStpFootGap:
                      Control: GroupContainer@1.5.0
                      Variant: ManualLayout
                      Properties:
                        DropShadow: =DropShadow.None
                        Fill: =nfColor.Transparent
                        Height: =1
                        LayoutMinHeight: =0
                        LayoutMinWidth: =0
                  - btnStpBack:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Back"
                        Appearance: =ButtonAppearance.Secondary
                        Height: =nfSize.Control
                        OnSelect: |-
                          =UpdateContext({ locStep: locStep - 1 })
                        Size: =nfType.Body
                        Text: ="Back"
                        Visible: =locStep > 1
                        Width: =90
                  - btnStpNext:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: ="Next"
                        Height: =nfSize.Control
                        OnSelect: |-
                          =If(
                              locStep = 1 && (IsBlank(txtStpTitleValue.Text) || IsBlank(drpStpSvcValue.Selected.Key)),
                              Notify("To continue, fill in: Title, Service.", NotificationType.Error),
                              locStep = 2 && (IsBlank(cmbStpDivisionValue.Selected.Value)),
                              Notify("To continue, fill in: Division or MEO.", NotificationType.Error),
                              UpdateContext({ locStep: locStep + 1 })
                          )
                        Size: =nfType.Body
                        Text: ="Next"
                        Visible: =locStep < CountRows(nfFormSteps)
                        Width: =90
                  - btnStpSubmit:
                      Control: ModernButton@1.0.0
                      Properties:
                        AccessibleLabel: =If(locId > 0, "Save changes", "Submit " & nfItem)
                        Height: =nfSize.Control
                        OnSelect: |-
                          =If(
                              locId > 0 && !frmStpItem.Unsaved,
                              Notify("No changes to save.", NotificationType.Information);
                              If(locId > 0, Navigate(scrDetail, ScreenTransition.None, { locId: locId, locFrom: "list" }), Navigate(scrList, ScreenTransition.None, { locStatusFilter: "all" })),
                              SubmitForm(frmStpItem)
                          )
                        Size: =nfType.Body
                        Text: =If(locId > 0, "Save changes", "Submit " & nfItem)
                        Visible: =locStep = CountRows(nfFormSteps)
                        Width: =150
