ComponentDefinitions:
  cmpTopNav:
    DefinitionType: CanvasComponent
    CustomProperties:
      ActiveKey:
        PropertyKind: Input
        DisplayName: ActiveKey
        Description: Key of the sub-tab to show as current.
        DataType: Text
        Default: ="home"
      IsStaff:
        PropertyKind: Input
        DisplayName: IsStaff
        Description: Pass =gblIsStaff. StaffOnly tabs are hidden when false.
        DataType: Boolean
        Default: =false
      Items:
        PropertyKind: Input
        DisplayName: Items
        Description: The sub-tabs, for example =nfNavQueue. Key, Label, Count (0 hides it), StaffOnly. Up to six are shown.
        DataType: Table
        Default: |-
          =Table({ Key: "home", Label: "Home", Count: 0, StaffOnly: false }, { Key: "list", Label: "List", Count: 3, StaffOnly: false })
      OnSelect:
        PropertyKind: Event
        DisplayName: OnSelect
        Description: A tab was selected. The screen switches its view or navigates.
        ReturnType: None
        Default: =false
      SelectedKey:
        PropertyKind: Output
        DisplayName: SelectedKey
        Description: Key of the tab the user selected. Read it in OnSelect.
        DataType: Text
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
