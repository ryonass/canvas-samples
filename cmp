                                    BorderColor: =If(locStep >= 1, nfColor.Primary, nfColor.Ink3)
                                    BorderThickness: =2
                                    DropShadow: =DropShadow.None
                                    Fill: =If(locStep >= 1, nfColor.Primary, nfColor.Surface)
