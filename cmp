                  DropShadow: =DropShadow.None
                  Fill: =cmpHeader.Theme.Transparent
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =4
                  LayoutMinHeight: =0
                  LayoutMinWidth: =0
                  Visible: =!(cmpHeader.Layout = "Phone")
