                  FontWeight: =FontWeight.Semibold
                  LayoutMinWidth: =0
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =If(cmpHeader.Layout = "Phone", 14, 16)
                  Text: =cmpHeader.Title
                  Width: =If(cmpHeader.Layout = "Phone", 0, 200)
                  Wrap: =false
