        PropertyKind: Output
        DisplayName: Is Valid
        Description: A custom property
        DataType: Boolean
      Label:
        PropertyKind: Input
        DisplayName: Label
        Description: Control Label
        DataType: Text
        Default: ="Text"
      Required:
        PropertyKind: Input
        DisplayName: Required
        Description: A custom property
        DataType: Boolean
        Default: =false
      Theme:
        PropertyKind: Input
        DisplayName: Theme
        Description: Pass =nfColor. The default copies the template palette so the component previews on its own.
        DataType: Record
        Default: |-
          ={
              Primary: RGBA(0, 82, 136, 1),
              PrimaryDark: RGBA(0, 62, 103, 1),
              PrimarySoft: RGBA(214, 227, 236, 1),
              OnPrimary: RGBA(255, 255, 255, 1),
              HeaderFill: RGBA(0, 43, 71, 1),
              HeaderInk: RGBA(255, 255, 255, 1),
              HeaderInk2: RGBA(214, 227, 236, 1),
              Page: RGBA(237, 238, 238, 1),
              Surface: RGBA(255, 255, 255, 1),
              Sunk: RGBA(248, 248, 249, 1),
              Line: RGBA(222, 223, 224, 1),
              Ink: RGBA(25, 25, 26, 1),
              Ink2: RGBA(68, 69, 71, 1),
              Ink3: RGBA(90, 91, 93, 1),
              Focus: RGBA(0, 120, 174, 1),
              Danger: RGBA(196, 18, 48, 1),
              DangerSoft: RGBA(246, 217, 222, 1),
              NeutralInk: RGBA(68, 69, 71, 1),
              NeutralSoft: RGBA(229, 229, 229, 1),
              InfoInk: RGBA(0, 62, 103, 1),
              InfoSoft: RGBA(214, 233, 242, 1),
              WarningInk: RGBA(92, 72, 9, 1),
              WarningSoft: RGBA(250, 243, 209, 1),
              SuccessInk: RGBA(49, 79, 26, 1),
              SuccessSoft: RGBA(229, 238, 222, 1),
              DangerInk: RGBA(102, 9, 25, 1),
              Hover: RGBA(0, 82, 136, 0.08),
              Pressed: RGBA(0, 82, 136, 0.16),
              Scrim: RGBA(25, 25, 26, 0.5),
              Transparent: RGBA(0, 0, 0, 0)
          }
      ValidationError:
        PropertyKind: Output
        DisplayName: Validation Error
        Description: A custom property
        DataType: Text
      Value:
        PropertyKind: Output
        DisplayName: Value
        Description: A custom property
        DataType: Text
    Properties:
      Height: =76
      IsValid: =IsBlank(cmp_Text.ValidationError)
      OnReset: =Reset(txt_TextValue)
      ValidationError: |-
        =If(
            Self.Required && IsBlank(txt_TextValue.Text),
            "Required",
            cmp_Text.CustomValidationError
        )
      Value: =txt_TextValue.Text
      Width: =150
    Children:
      - lbl_TextError:
          Control: ModernText@1.0.0
          Properties:
            Color: =cmp_Text.Theme.Danger
            Height: =22
            PaddingBottom: =0
            PaddingLeft: =3
            PaddingRight: =0
            PaddingTop: =0
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Size: =12
            Text: =cmp_Text.ValidationError
            Width: =Parent.Width
            Y: =txt_TextValue.Y+txt_TextValue.Height
      - txt_TextValue:
          Control: ModernTextInput@1.1.2
          Properties:
            Appearance: =Appearance.Outline
            Color: |-
              =If(
                  cmp_Text.Required && IsBlank(Self.Text),
                  cmp_Text.Theme.Danger,
                  cmp_Text.Theme.Ink
              )
            Default: =cmp_Text.DefaultValue
            DisplayMode: =cmp_Text.DisplayMode
            MaxLength: =-1
            Placeholder: =""
            ValidationState: =If(cmp_Text.IsValid, ValidationState.None, ValidationState.Error)
            Width: =Parent.Width
            Y: =lbl_TextLabel.Y+lbl_TextLabel.Height
      - lbl_TextLabel:
          Control: ModernText@1.0.0
          Properties:
            Color: =cmp_Text.Theme.Ink
            FontWeight: =FontWeight.Semibold
            Height: =22
            PaddingBottom: =0
            PaddingLeft: =3
            PaddingRight: =0
            PaddingTop: =0
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Size: =14
            Text: =cmp_Text.Label
            Width: =Parent.Width

